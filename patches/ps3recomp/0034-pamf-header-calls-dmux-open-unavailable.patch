+#!/usr/bin/env python3
+"""cellPamf's header-only calls and cellDmux's attribute and open calls.
+
+The five were unresolved imports answering CELL_OK and writing nothing. The
+PAMF header calls now read the file's real layout and give the SDK's codes;
+the demuxer, which has no core here, checks its arguments and answers
+CELL_DMUX_ERROR_FATAL with nothing written. Builds tests/test_pamf_header_dmux.c
+with the real cellPamf.c and cellDmux.c and runs it.
+"""
+import os
+import platform
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: the fixture is POSIX; run on macOS/Linux')
+        return 0
+    with tempfile.TemporaryDirectory(prefix='pamf-dmux-') as tmp:
+        exe = Path(tmp) / 'test_pamf_header_dmux'
+        link = ['-Wl,-undefined,dynamic_lookup'] if platform.system() == 'Darwin' else ['-Wl,--unresolved-symbols=ignore-all']
+        r = subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-O1', '-w',
+                            '-I' + str(ROOT / 'include'), '-I' + str(ROOT / 'runtime'),
+                            '-I' + str(ROOT / 'libs/codec'),
+                            '-I' + str(ROOT / 'libs'),
+                            str(ROOT / 'tests/test_pamf_header_dmux.c'), str(ROOT / 'libs/codec/cellPamf.c'), str(ROOT / 'libs/codec/cellDmux.c'),
+                            *link, '-o', str(exe)],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        rc = 0
+        for args, extra in (([], {}),):
+            env = {k: v for k, v in os.environ.items() if k not in ('PS3_NET_ONLINE', 'PS3_NETCTL_OFFLINE_FAIL')}
+            env.update(extra)
+            r = subprocess.run([str(exe), *args], capture_output=True, text=True, timeout=30, env=env)
+            sys.stdout.write(r.stdout + r.stderr)
+            rc |= r.returncode
+        return rc
+
+
+if __name__ == '__main__':
+    sys.exit(main())
