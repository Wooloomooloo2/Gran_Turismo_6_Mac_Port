diff --git a/tools/test_osk_dialog.py b/tools/test_osk_dialog.py
new file mode 100644
index 00000000..c9f4dd19
--- /dev/null
+++ b/tools/test_osk_dialog.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""The on-screen keyboard (libs/misc/cellOskDialog.c): the sysutil events, the
+host's answer, the text handed back and the argument checks.
+
+GT6 imports cellOskDialogDisableDimmer 0x41F20828, cellOskDialogSetKeyLayoutOption
+0xB53C54FA, cellOskDialogExtSetInitialScale 0x75370397 and
+cellOskDialogExtRegisterForceFinishCallback 0xE800F586, which had no handler, and
+LoadAsync answered NOT_INITIALIZED (a call no SDK has), so its player-name page
+never got a keyboard. Checks the names hash to those NIDs, then builds
+libs/misc/tests/test_osk_dialog.c, which includes cellOskDialog.c, and runs it.
+"""
+import hashlib
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SUFFIX = b"\x67\x59\x65\x99\x04\x25\x04\x90\x56\x64\x27\x49\x94\x89\x74\x1A"
+NIDS = (('cellOskDialogDisableDimmer', 0x41F20828), ('cellOskDialogSetKeyLayoutOption', 0xB53C54FA),
+        ('cellOskDialogExtSetInitialScale', 0x75370397),
+        ('cellOskDialogExtRegisterForceFinishCallback', 0xE800F586),
+        ('cellOskDialogLoadAsync', 0x7FCFC915))
+
+
+def nid(name):
+    return struct.unpack('<I', hashlib.sha1(name.encode() + SUFFIX).digest()[:4])[0]
+
+
+def main():
+    fails = 0
+    for name, want in NIDS:
+        got = nid(name)
+        fails += got != want
+        print(f"[{'PASS' if got == want else 'FAIL'}] {name} hashes to 0x{got:08X} (imported as 0x{want:08X})")
+    cc = os.environ.get('CC') or shutil.which('cc') or shutil.which('gcc') or shutil.which('clang')
+    if not cc:
+        print('SKIP: no C compiler')
+        return 1 if fails else 0
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = Path(tmp) / 'test_osk_dialog'
+        r = subprocess.run([cc, '-std=gnu17', '-O1', '-w', '-I' + str(ROOT / 'include'),
+                            str(ROOT / 'libs/misc/tests/test_osk_dialog.c'), '-o', str(exe)],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+        sys.stdout.write(r.stdout + r.stderr)
+        return 1 if (fails or r.returncode) else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
