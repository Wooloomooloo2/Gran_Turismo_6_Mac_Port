+#!/usr/bin/env python3
+"""The SPURS workload flag (receiver, address, kernel selection), cellSpursInitializeWithAttribute2 and cellSpursDestroyTaskset2 through the real cellSpurs.c."""
+import os, platform, subprocess, sys, tempfile
+from pathlib import Path
+if os.name == 'nt':
+    print('SKIP: POSIX fixture'); raise SystemExit(0)
+r=Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(r/'tools'))
+from gen_hle_nids import scan
+# registered under the NIDs titles import (an unregistered import fakes CELL_OK and writes nothing)
+want={'_cellSpursWorkloadFlagReceiver2':0x2DDBCC0A,'cellSpursGetWorkloadFlag':0xC765B995,
+      'cellSpursInitializeWithAttribute2':0x30AA96C4,'cellSpursDestroyTaskset2':0x1EBCF459}
+have={name:nid for nid,name in scan(str(r/'libs/spurs/cellSpurs.c'))}
+for name,nid in want.items():
+    assert have.get(name)==nid, f'{name} is not registered as 0x{nid:08X} (got {have.get(name)})'
+print('[PASS] registered: '+', '.join(want))
+with tempfile.TemporaryDirectory(prefix='spurs-workload-flag-') as tmp:
+    out=Path(tmp)/'test'
+    units=['spu_channels','spu_drain','spu_lockstep','spu_coherency','spu_workload',
+           'spurs_policy','spurs_job','spu_tsp_weak','spu_vm_pagemap',
+           'spurs_policy_blob_weak','spu_interp']
+    subprocess.run([os.environ.get('CC','cc'),'-std=gnu17','-O1','-UNDEBUG',
+        '-ffunction-sections','-fdata-sections',
+        '-Wl,-dead_strip' if platform.system()=='Darwin' else '-Wl,--gc-sections',
+        '-I'+str(r/'include'),'-I'+str(r/'runtime/spu'),'-I'+str(r/'runtime/platform'),
+        str(r/'tests/test_spurs_workload_flag.c'),
+        *[str(r/'runtime/spu'/f'{u}.c') for u in units],
+        str(r/'runtime/platform/win32_compat.c'),'-pthread','-lm','-o',str(out)],check=True)
+    subprocess.run([str(out)],check=True,timeout=15)
