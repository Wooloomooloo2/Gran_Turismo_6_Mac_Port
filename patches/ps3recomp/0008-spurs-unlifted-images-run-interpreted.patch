+/* SPURS_JOB_SYNTH_EVENTS=0: the chain walker does not make up completion
+ * events. By default it pushes one to every attached queue per job, one at
+ * END and one when the walk ends (jc_signal_done), because the titles this
+ * was built for wait on them while their jobs are not run for real. On
+ * hardware the job manager sends nothing of the sort: an application learns
+ * of a job's end from the job itself, which sends its own SPU event (routed
+ * by spurs_port_queue) or writes memory. A title whose jobs run (lifted, or
+ * interpreted with SPU_JOB_INTERP=1) and that reads the events' data as its
+ * own (Gran Turismo 6 indexes a callback table with data2) gets wrong state
+ * from made-up ones. */
+static int jc_synth_events(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("SPURS_JOB_SYNTH_EVENTS"); v = (e && *e == '0') ? 0 : 1; }
+    return v;
+}
