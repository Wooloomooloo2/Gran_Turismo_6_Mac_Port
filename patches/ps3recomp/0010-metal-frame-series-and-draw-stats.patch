diff --git a/libs/video/tests/test_frame_series.c b/libs/video/tests/test_frame_series.c
new file mode 100644
index 00000000..9e1bf8b0
--- /dev/null
+++ b/libs/video/tests/test_frame_series.c
@@ -0,0 +1,200 @@
+/* The frame series and per-frame draw statistics (libs/video/rsx_frame_series.h):
+ * which presents are dumped, the file names, the PPM bytes, the stats lines,
+ * the PS3RECOMP_METAL_FRAME_MAX cap and the stop file. No Metal device needed.
+ * Run by tools/test_frame_series.py. */
+#include "../rsx_frame_series.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static int fails = 0;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); \
+    printf(__VA_ARGS__); printf("\n"); if (!ok_) fails++; } while (0)
+
+static char tmpdir[512];
+
+static long file_size(const char* p)
+{
+    FILE* f = fopen(p, "rb");
+    if (!f) return -1;
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fclose(f);
+    return n;
+}
+
+static char* slurp(const char* p)
+{
+    FILE* f = fopen(p, "rb");
+    if (!f) return NULL;
+    static char buf[65536];
+    size_t n = fread(buf, 1, sizeof buf - 1, f);
+    buf[n] = 0;
+    fclose(f);
+    return buf;
+}
+
+static void test_stats_line(void)
+{
+    char b[64];
+    rsx_fs_stats_line(b, sizeof b, 1, 0, 2);
+    CHECK(strcmp(b, "1 0 2\n") == 0, "stats line is '<presented> <draws> <clears>'");
+    rsx_fs_stats_line(b, sizeof b, 4294967295u, 12, 0);
+    CHECK(strcmp(b, "4294967295 12 0\n") == 0, "stats line holds 32-bit values");
+}
+
+static void test_defaults(void)
+{
+    rsx_frame_series s;
+    rsx_fs_init(&s, NULL, NULL, NULL, NULL);
+    CHECK(s.dir[0] == 0 && !s.stats, "nothing set: no series, no stats");
+    int dump = 1;
+    unsigned n = rsx_fs_present(&s, 5, 1, &dump);
+    CHECK(n == 1 && !dump, "without a folder a present is counted but never dumped");
+    rsx_fs_init(&s, "/x", "", "junk", NULL);
+    CHECK(s.every == 60 && s.max == 300, "every defaults to 60, max to 300 (got %u, %u)",
+          s.every, s.max);
+    rsx_fs_init(&s, "/x", "0", "-4", NULL);
+    CHECK(s.every == 60 && s.max == 300, "every 0 and a negative max fall back to the defaults");
+    rsx_fs_init(&s, "/x", "7", "0", NULL);
+    CHECK(s.every == 7 && s.max == 0, "every 7, max 0 (no dumps) are taken as given");
+}
+
+static void test_which_presents(void)
+{
+    rsx_frame_series s;
+    rsx_fs_init(&s, tmpdir, "60", "300", NULL);
+    unsigned want[] = {1, 60, 120, 180};
+    unsigned got[8], ng = 0;
+    for (unsigned i = 0; i < 200; i++) {
+        int dump = 0;
+        unsigned n = rsx_fs_present(&s, 0, 0, &dump);
+        if (dump && ng < 8) { got[ng++] = n; s.dumped++; }
+    }
+    int same = ng == 4;
+    for (unsigned i = 0; same && i < 4; i++) same = got[i] == want[i];
+    CHECK(same, "every 60: presents 1, 60, 120 and 180 of 200 are dumped (%u dumped)", ng);
+    char p[1100];
+    rsx_fs_frame_path(&s, 60, p, sizeof p);
+    char w[1100];
+    snprintf(w, sizeof w, "%s/frame_000060.ppm", tmpdir);
+    CHECK(strcmp(p, w) == 0, "file name is frame_<presented, 6 digits>.ppm (%s)", p);
+}
+
+static void test_max_cap(void)
+{
+    rsx_frame_series s;
+    rsx_fs_init(&s, tmpdir, "1", "3", NULL);
+    unsigned dumps = 0;
+    unsigned char px[4] = {0, 0, 0, 0};
+    for (unsigned i = 0; i < 10; i++) {
+        int dump = 0;
+        unsigned n = rsx_fs_present(&s, 0, 0, &dump);
+        if (dump && rsx_fs_dump(&s, n, px, 1, 1, 0) == 0) dumps++;
+    }
+    CHECK(dumps == 3 && s.dumped == 3, "max 3: three dumps of ten presents (%u)", dumps);
+    CHECK(s.stopped == RSX_FS_STOPPED_MAX, "the series says it stopped at the cap");
+    for (unsigned i = 1; i <= 10; i++) {
+        char p[1100];
+        rsx_fs_frame_path(&s, i, p, sizeof p);
+        if (i <= 3) CHECK(file_size(p) > 0, "frame %u is on disk", i);
+        else if (file_size(p) >= 0) CHECK(0, "frame %u should not be on disk", i);
+        unlink(p);
+    }
+}
+
+static void test_stop_file(void)
+{
+    rsx_frame_series s;
+    rsx_fs_init(&s, tmpdir, "1", "300", NULL);
+    unsigned char px[4] = {0, 0, 0, 0};
+    int dump = 0;
+    unsigned n = rsx_fs_present(&s, 0, 0, &dump);
+    CHECK(dump && rsx_fs_dump(&s, n, px, 1, 1, 0) == 0, "first present dumped");
+    char stop[1100];
+    snprintf(stop, sizeof stop, "%s/STOP", tmpdir);
+    FILE* f = fopen(stop, "w");
+    fclose(f);
+    n = rsx_fs_present(&s, 0, 0, &dump);
+    CHECK(!dump && s.stopped == RSX_FS_STOPPED_FILE, "a STOP file in the folder stops dumping");
+    unlink(stop);
+    n = rsx_fs_present(&s, 0, 0, &dump);
+    CHECK(!dump, "and it stays stopped once the file is gone");
+    char p[1100];
+    rsx_fs_frame_path(&s, 1, p, sizeof p);
+    unlink(p);
+}
+
+static void test_ppm(void)
+{
+    /* 2x2, BGRA in a 12-byte pitch (one pad pixel per row). */
+    const unsigned char bgra[2 * 12] = {
+        0x01, 0x02, 0x03, 0xFF,  0x04, 0x05, 0x06, 0xFF,  0xEE, 0xEE, 0xEE, 0xEE,
+        0x07, 0x08, 0x09, 0xFF,  0x0A, 0x0B, 0x0C, 0xFF,  0xEE, 0xEE, 0xEE, 0xEE,
+    };
+    char p[1100];
+    snprintf(p, sizeof p, "%s/t.ppm", tmpdir);
+    CHECK(rsx_fs_write_ppm(p, bgra, 2, 2, 12, 1) == 0, "PPM written");
+    FILE* f = fopen(p, "rb");
+    unsigned char b[64] = {0};
+    size_t n = f ? fread(b, 1, sizeof b, f) : 0;
+    if (f) fclose(f);
+    const char hdr[] = "P6\n2 2\n255\n";
+    const unsigned char rgb[12] = {0x03, 0x02, 0x01, 0x06, 0x05, 0x04,
+                                   0x09, 0x08, 0x07, 0x0C, 0x0B, 0x0A};
+    CHECK(n == sizeof hdr - 1 + 12 && memcmp(b, hdr, sizeof hdr - 1) == 0 &&
+          memcmp(b + sizeof hdr - 1, rgb, 12) == 0,
+          "BGRA rows come out as RGB, pad bytes dropped (%zu bytes)", n);
+    const unsigned char rgba[8] = {0x10, 0x20, 0x30, 0xFF, 0x40, 0x50, 0x60, 0xFF};
+    CHECK(rsx_fs_write_ppm(p, rgba, 2, 1, 8, 0) == 0, "RGBA PPM written");
+    f = fopen(p, "rb");
+    n = f ? fread(b, 1, sizeof b, f) : 0;
+    if (f) fclose(f);
+    const unsigned char rgb2[6] = {0x10, 0x20, 0x30, 0x40, 0x50, 0x60};
+    CHECK(n == 11 + 6 && memcmp(b + 11, rgb2, 6) == 0, "RGBA rows keep their order");
+    char tmp[1200];
+    snprintf(tmp, sizeof tmp, "%s/.t.ppm.tmp", tmpdir);
+    CHECK(file_size(tmp) < 0, "no temporary file is left behind");
+    unlink(p);
+    CHECK(rsx_fs_write_ppm("/nonexistent-dir/x.ppm", rgba, 2, 1, 8, 0) != 0,
+          "an unwritable path is an error, not a crash");
+}
+
+static void test_stats_file(void)
+{
+    char sp[1100];
+    snprintf(sp, sizeof sp, "%s/draw_stats.txt", tmpdir);
+    rsx_frame_series s;
+    rsx_fs_init(&s, NULL, NULL, NULL, sp);
+    CHECK(s.stats != NULL, "the stats file opens");
+    int dump;
+    rsx_fs_present(&s, 0, 1, &dump);
+    rsx_fs_present(&s, 12, 3, &dump);
+    /* Read it before closing: a run is killed, never shut down, so every line
+     * must be on disk as soon as it is written. */
+    char* t = slurp(sp);
+    CHECK(t && strcmp(t, "1 0 1\n2 12 3\n") == 0, "one line per present, on disk at once ('%s')",
+          t ? t : "(none)");
+    rsx_fs_close(&s);
+    unlink(sp);
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    snprintf(tmpdir, sizeof tmpdir, "%s/test_frame_series.XXXXXX",
+             getenv("TMPDIR") ? getenv("TMPDIR") : "/tmp");
+    if (!mkdtemp(tmpdir)) { printf("[FAIL] mkdtemp\n"); return 1; }
+    test_stats_line();
+    test_defaults();
+    test_which_presents();
+    test_max_cap();
+    test_stop_file();
+    test_ppm();
+    test_stats_file();
+    rmdir(tmpdir);
+    printf(fails ? "\n%d check(s) FAILED\n" : "\nall checks passed\n", fails);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_metal_frame_series.m b/libs/video/tests/test_metal_frame_series.m
new file mode 100644
index 00000000..abb37c50
--- /dev/null
+++ b/libs/video/tests/test_metal_frame_series.m
@@ -0,0 +1,89 @@
+/* The Metal backend's frame series glue (eng_series_present): a present reads
+ * the draw engine's counts into PS3RECOMP_DRAW_STATS and dumps the surface into
+ * PS3RECOMP_METAL_FRAME_DIR as RGB. Needs a Metal device; no window. Run by
+ * tools/test_frame_series.py, or by hand:
+ *
+ *   clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_frame_series.m \
+ *     -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore \
+ *     -framework IOSurface -o /tmp/test_metal_frame_series && \
+ *     TMPDIR=/tmp /tmp/test_metal_frame_series
+ */
+#include "../rsx_metal_backend.m"
+
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+/* The draw engine is not linked: these are the counts of the frame "presented". */
+static u32 s_fake_draws, s_fake_clears;
+void rsx_draw_engine_frame_counts(u32* draws, u32* clears)
+{
+    *draws = s_fake_draws;
+    *clears = s_fake_clears;
+}
+
+static int fails;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); \
+    printf(__VA_ARGS__); printf("\n"); if (!ok_) fails++; } while (0)
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        if (!s_dev) { printf("SKIP: no Metal device\n"); return 0; }
+        s_queue = [s_dev newCommandQueue];
+        s_headless = 1;
+
+        char dir[512];
+        snprintf(dir, sizeof dir, "%s/test_metal_frame_series.XXXXXX",
+                 getenv("TMPDIR") ? getenv("TMPDIR") : "/tmp");
+        if (!mkdtemp(dir)) { printf("[FAIL] mkdtemp\n"); return 1; }
+        char stats[600];
+        snprintf(stats, sizeof stats, "%s/draw_stats.txt", dir);
+        setenv("PS3RECOMP_METAL_FRAME_DIR", dir, 1);
+        setenv("PS3RECOMP_METAL_FRAME_EVERY", "2", 1);
+        setenv("PS3RECOMP_DRAW_STATS", stats, 1);
+
+        MTLTextureDescriptor* d = [MTLTextureDescriptor
+            texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:2 height:1
+                                     mipmapped:NO];
+        d.storageMode = MTLStorageModeShared;
+        id<MTLTexture> t = [s_dev newTextureWithDescriptor:d];
+        const unsigned char bgra[8] = {0x30, 0x20, 0x10, 0xFF, 0x00, 0x00, 0x00, 0xFF};
+        [t replaceRegion:MTLRegionMake2D(0, 0, 2, 1) mipmapLevel:0 withBytes:bgra
+             bytesPerRow:8];
+
+        s_fake_draws = 0; s_fake_clears = 1;
+        eng_series_present(t);          /* 1: dumped */
+        s_fake_draws = 12; s_fake_clears = 2;
+        eng_series_present(t);          /* 2: dumped (every 2) */
+        s_fake_draws = 3; s_fake_clears = 0;
+        eng_series_present(nil);        /* 3: a present with no surface still counts */
+
+        char p[700];
+        snprintf(p, sizeof p, "%s/frame_000001.ppm", dir);
+        FILE* f = fopen(p, "rb");
+        unsigned char b[64] = {0};
+        size_t n = f ? fread(b, 1, sizeof b, f) : 0;
+        if (f) fclose(f);
+        const unsigned char want[] = "P6\n2 1\n255\n\x10\x20\x30\x00\x00\x00";
+        CHECK(n == sizeof want - 1 && memcmp(b, want, n) == 0,
+              "present 1 is dumped as RGB (%zu bytes)", n);
+        snprintf(p, sizeof p, "%s/frame_000002.ppm", dir);
+        CHECK(access(p, F_OK) == 0, "present 2 is dumped (every 2)");
+        snprintf(p, sizeof p, "%s/frame_000003.ppm", dir);
+        CHECK(access(p, F_OK) != 0, "present 3 is not");
+
+        char text[256] = {0};
+        f = fopen(stats, "rb");
+        n = f ? fread(text, 1, sizeof text - 1, f) : 0;
+        if (f) fclose(f);
+        CHECK(strcmp(text, "1 0 1\n2 12 2\n3 3 0\n") == 0,
+              "one stats line per present with the engine's counts ('%s')", text);
+
+        char cmd[700];
+        snprintf(cmd, sizeof cmd, "rm -rf '%s'", dir);
+        system(cmd);
+    }
+    printf(fails ? "\n%d check(s) FAILED\n" : "\nall checks passed\n", fails);
+    return fails ? 1 : 0;
+}
