 #define SCE_NP_TROPHY_ERROR_PROCESSING              0x8055160E
 #define SCE_NP_TROPHY_ERROR_ABORT                   0x8055160F
 #define SCE_NP_TROPHY_ERROR_UNKNOWN                 0x805516FF
