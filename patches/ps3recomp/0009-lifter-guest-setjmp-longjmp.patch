+#!/usr/bin/env python3
+"""Guest setjmp/longjmp across lifted host frames (runtime/ppu/ppu_sjlj.h).
+
+1. The lifter rewrite (--setjmp/--longjmp, _sjlj_rewrite in ppu_lifter.py):
+   a direct call to a setjmp function becomes PPU_SJLJ_SETJMP with a frame
+   declared at the top of the caller, whose every return then drops its
+   frames; a longjmp function records r3 on entry and ends its plain returns
+   in ppu_sjlj_longjmp.
+2. The runtime (ppu_loader.cpp, pulled out between its guest-sjlj markers),
+   built with stand-ins for lifted functions:
+   - setjmp returns 0, a longjmp three host frames down lands back after the
+     setjmp call with the longjmp's r3 and the code after the longjmp call
+     never runs;
+   - the indirect-call depth and vcall stack the skipped frames held are put
+     back, and a pending trampoline is dropped;
+   - a longjmp to a buffer with no live frame returns to its caller (logged);
+   - a frame whose function has returned is not jumped to.
+Gran Turismo 6's file worker aborts a decode this way; before, the decoder
+carried on into a NULL or stale output buffer.
+"""
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'tools'))
+from ppu_lifter import _sjlj_rewrite, sjlj_unrewritten_longjmps  # noqa: E402
+
+FAILS = []
+
+
+def check(name, ok):
+    print(('ok   ' if ok else 'FAIL ') + name)
+    if not ok:
+        FAILS.append(name)
+
+
+class F:
+    def __init__(self, start):
+        self.start_addr = start
+
+
+def test_rewrite():
+    body = ['ctx->lr = 0x00A4700C; func_00BDCF2C(ctx); DRAIN_TRAMPOLINE(ctx);',
+            'if (x) goto loc_1;',
+            'ctx->lr = 0x00A47100; func_00BDCF2C(ctx); DRAIN_TRAMPOLINE(ctx);',
+            'return;']
+    body.insert(3, '{ g_trampoline_fn = (void(*)(void*))func_00001000; return; }')
+    out, n = _sjlj_rewrite(F(0x00A46FB4), body, '', {0x00BDCF2C}, {0x00BDD050})
+    check('one zeroed frame array declared first', n == 2 and out[0] == 'ppu_sjlj_frame _sjf[2] = {};')
+    check('setjmp calls bracketed',
+          'PPU_SJLJ_SETJMP(ctx, _sjf[0], func_00BDCF2C);' in out[1] and
+          'PPU_SJLJ_SETJMP(ctx, _sjf[1], func_00BDCF2C);' in out[3])
+    check('every return drops the frames first',
+          out[-1] == '{ ppu_sjlj_leave(_sjf, 2); return; }' and
+          'ppu_sjlj_leave(_sjf, 2); return; }' in out[4])
+    lj, n = _sjlj_rewrite(F(0x00BDD050), ['ctx->gpr[1] = vm_read64(ctx->gpr[3] + 0x0);', 'return;'],
+                          '', {0x00BDCF2C}, {0x00BDD050})
+    check('longjmp records its buffer on entry', lj[0] == 'const uint32_t _sjbuf = (uint32_t)ctx->gpr[3];')
+    check('longjmp ends in ppu_sjlj_longjmp', lj[-1] == 'ppu_sjlj_longjmp(ctx, _sjbuf); return;')
+    same = ['func_00001000(ctx);', 'return;']
+    check('other functions untouched', _sjlj_rewrite(F(0x2000), same, '', set(), {0x00BDD050}) == (same, 0))
+
+    class L:
+        functions = [F(0x00BDD050)]
+        longjmp_addrs = {0x00BDD050, 0x00BDE000}
+    check('a --longjmp address no function starts at is reported',
+          sjlj_unrewritten_longjmps(L()) == [0x00BDE000])
+
+
+HARNESS = r'''
+#include <cstdint>
