+/* ppu_sjlj.h -- guest setjmp/longjmp across lifted host frames.
+ *
+ * A guest longjmp restores r1, r2, r13-r31, LR, CR and the non-volatile FP and
+ * vector registers from the jmp_buf and returns through the saved LR. Lifted,
+ * every guest call is a host C call, so that return only leaves the longjmp
+ * function: the host frames between the setjmp and the longjmp stay on the
+ * host stack, and the code after the longjmp call carries on with the
+ * restored registers as if the call had returned. A title that aborts a
+ * decoder with longjmp (Gran Turismo 6's file worker does when its consumer
+ * has no output buffer left) then keeps decoding into a stale or NULL buffer.
+ *
+ * With --setjmp/--longjmp, the lifter brackets every direct call to a guest
+ * setjmp with a host setjmp (PPU_SJLJ_SETJMP, a frame in the caller's own
+ * frame) and ends the guest longjmp with ppu_sjlj_longjmp, which host-longjmps
+ * to the newest frame registered for that jmp_buf; every return from a function
+ * holding frames drops them (ppu_sjlj_leave), so only live frames are
+ * registered. The guest code has by
+ * then restored every register, so execution resumes after the setjmp call
+ * with the longjmp's value in r3, exactly as on the console. With no live
+ * frame for the buffer, ppu_sjlj_longjmp logs and returns (the old behaviour).
+ * The runtime side is in ppu_loader.cpp.
+ *
+ * Invariant the lifted code must keep: no C local of a lifted function may
+ * change between the guest setjmp call and the longjmp that lands on it. After
+ * a host longjmp such a local is indeterminate (C11 7.13.2.1). It holds today
+ * because all guest state lives in ctx, the _cs_ callee-saved snapshots are
+ * written only at function entry, and _mm is const. A lifter change that
+ * caches guest registers in locals must make them volatile in functions that
+ * call setjmp, or break this.
+ *
+ * A longjmp across a host frame that is not lifted code (an HLE function that
+ * called back into the guest) skips that frame: its C++ destructors do not
+ * run and any lock it holds stays held. Only lifted frames and
+ * ps3_indirect_call (whose depth and vcall stack are restored) are safe to
+ * jump over. */
+#pragma once
+#include <setjmp.h>
+#include <stdint.h>
+
+struct ppu_context;
+
+typedef struct ppu_sjlj_frame {
+    jmp_buf env;
+    uint32_t guest_buf;            /* the guest jmp_buf (16-byte aligned, as the guest code uses it) */
+    int dispatch_depth;            /* ps3_indirect_call nesting at the setjmp */
+    int vcall_sp;
+    int pushed;                    /* registered (0 until the setjmp call is reached) */
+    struct ppu_sjlj_frame* prev;   /* the next older frame on this host thread */
+} ppu_sjlj_frame;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void ppu_sjlj_push(struct ppu_context* ctx, ppu_sjlj_frame* f, uint32_t guest_buf);
+void ppu_sjlj_landed(struct ppu_context* ctx, ppu_sjlj_frame* f);
+void ppu_sjlj_longjmp(struct ppu_context* ctx, uint32_t guest_buf);
+/* The function holding frames[0..n) returns: drop them. */
+void ppu_sjlj_leave(ppu_sjlj_frame* frames, int n);
+#ifdef __cplusplus
+}
+#endif
+
+/* _setjmp/_longjmp on POSIX: no signal-mask save, which on Darwin is a
+ * syscall per setjmp. */
+#if defined(_WIN32)
+#  define PPU_SJLJ_SETJMP_RAW(env) setjmp(env)
+#else
+#  define PPU_SJLJ_SETJMP_RAW(env) _setjmp(env)
+#endif
+
+/* A direct call to a guest setjmp. `f` is an element of the zeroed
+ * ppu_sjlj_frame _sjf[N] array declared at the top of the calling function, so
+ * it lives as long as that function's frame, and every return from that
+ * function calls ppu_sjlj_leave(_sjf, N). */
+#define PPU_SJLJ_SETJMP(ctx, f, fn)                                         \
+    do {                                                                    \
+        ppu_sjlj_push((ctx), &(f), (uint32_t)(ctx)->gpr[3]);                \
+        if (PPU_SJLJ_SETJMP_RAW((f).env) == 0) fn(ctx);                     \
+        else ppu_sjlj_landed((ctx), &(f));                                  \
+    } while (0)
