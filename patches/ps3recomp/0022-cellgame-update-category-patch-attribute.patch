From: Gran Turismo 6 for Mac <https://github.com/Wooloomooloo2/Gran-Turismo-6-Mac>
Subject: [PATCH] cellGame: update category "GD"; ContentPermit for game data that is not there

Upstream: not yet submitted; written to be upstreamed (generic, no title names)
Licence: MIT, as ps3recomp (see its LICENSE); offered under the same terms
Base: ps3recomp 4e8f3ca87a3e1d87bb83b8b7e9348fe2685cd514 (after 0001-0021)

What: cellGame_init_from_paramsfo mapped only the "HG" and "DG" categories,
and cellGameBootCheck always wrote 0 to *attributes. A disc game with an
update installed boots the update's EBOOT.BIN from /dev_hdd0/game/<id>/USRDIR
under the update's PARAM.SFO, whose CATEGORY is "GD". BootCheck then reports
CELL_GAME_GAMETYPE_DISC with CELL_GAME_ATTRIBUTE_PATCH, and
cellGameGetParamString answers from the update's PARAM.SFO (TITLE_ID,
APP_VER), as RPCS3's cellGameBootCheck does for the GD category (behaviour
only; no RPCS3 code). "GD" now sets type DISC and the PATCH attribute; "HG"
and "DG" clear the attributes. The BootCheck log line names the attributes
and the APP_VER.

Also: cellGameContentPermit after a cellGameDataCheck that did not find the
game data (CELL_GAME_RET_NONE) and with no cellGameCreateGameData made the
folders and answered their paths. The firmware (RPCS3's behaviour) answers
empty paths and creates nothing; it now does the same. A ContentPermit that
does create now makes the checked directory, not the booted title's, and
makes the extra copy under the VFS root only when /dev_hdd0 has no root of
its own (PS3_HDD0_ROOT unset): with a root set, that copy landed in the disc
layer.

Why: a title that compares the APP_VER its PARAM.SFO declares with its own
build gave up when cellGame answered with the placeholders (title id
BLES00000, app version 01.00) because nothing passed it the update's SFO. A title checking for an
optional companion title's game data saw it "present" (empty folders), and
the folders leaked into the disc image.

Test: tools/test_game_category.py (new) builds the existing
libs/system/tests/test_game_category.c, extended: a "GD" SFO boots as a disc
game with PATCH, GetParamString returns its TITLE_ID and APP_VER, and a
later "DG" SFO clears the attribute; ContentPermit after a missing-data
DataCheck answers empty paths and creates nothing (in the content root or
under the VFS root), and after a present one answers its paths.

diff --git a/libs/system/cellGame.c b/libs/system/cellGame.c
index 5a1d37fa..86fee91b 100644
--- a/libs/system/cellGame.c
+++ b/libs/system/cellGame.c
@@ -90,6 +90,9 @@ static char s_exit_param[256] = "";
 
 static int  s_boot_checked = 0;
 static u32  s_game_type = CELL_GAME_GAMETYPE_DISC;
+/* The attributes cellGameBootCheck reports: CELL_GAME_ATTRIBUTE_PATCH when the booted
+ * PARAM.SFO is a disc game's update ("GD"), else 0. */
+static u32  s_game_attributes = 0;
 
 /* Current content-check session. BootCheck/DataCheck open a session naming
  * some content; ContentPermit reports THAT content's paths and closes it.
@@ -99,6 +102,10 @@ static u32  s_game_type = CELL_GAME_GAMETYPE_DISC;
  * semaphore forever. */
 static int  s_check_is_disc = 1;
 static char s_check_dir[64] = "";
+/* Whether the session's content exists (or was created by cellGameCreateGameData).
+ * ContentPermit on a game-data session whose directory was not found answers empty
+ * paths and creates nothing, as the firmware does (RPCS3's behaviour). */
+static int  s_check_exists = 1;
 
 static void ensure_dirs(const char* path)
 {
@@ -300,9 +307,15 @@ void cellGame_init_from_paramsfo(const char* sfo_path)
      * RPCS3 reports HDD for every category that is not a disc one; only these two are mapped here, any
      * other keeps the default. */
     if (sfo_read_string(sfo_path, "CATEGORY", tmp, sizeof(tmp)) == 0 && tmp[0]) {
-        if (strcmp(tmp, "HG") == 0)      s_game_type = CELL_GAME_GAMETYPE_HDD;
-        else if (strcmp(tmp, "DG") == 0) s_game_type = CELL_GAME_GAMETYPE_DISC;
-        printf("[cellGame] CATEGORY '%s' -> game type %u\n", tmp, (unsigned)s_game_type);
+        /* "GD" is a disc game's update, booted from /dev_hdd0/game/<id>/USRDIR with the disc in
+         * the drive: a disc game whose parameters are the update's, with the PATCH attribute
+         * (as RPCS3's cellGameBootCheck for the GD category). */
+        if (strcmp(tmp, "HG") == 0)      { s_game_type = CELL_GAME_GAMETYPE_HDD;  s_game_attributes = 0; }
+        else if (strcmp(tmp, "DG") == 0) { s_game_type = CELL_GAME_GAMETYPE_DISC; s_game_attributes = 0; }
+        else if (strcmp(tmp, "GD") == 0) { s_game_type = CELL_GAME_GAMETYPE_DISC;
+                                           s_game_attributes = CELL_GAME_ATTRIBUTE_PATCH; }
+        printf("[cellGame] CATEGORY '%s' -> game type %u, attributes 0x%x\n", tmp,
+               (unsigned)s_game_type, (unsigned)s_game_attributes);
     }
     if (sfo_read_string(sfo_path, "TITLE", tmp, sizeof(tmp)) == 0 && tmp[0]) {
         strncpy(s_title, tmp, sizeof(s_title) - 1); s_title[sizeof(s_title) - 1] = '\0';
@@ -357,7 +370,7 @@ s32 cellGameBootCheck(u32* type, u32* attributes, CellGameContentSize* size,
     uint32_t dir_ea  = (uint32_t)(uintptr_t)dirName;
 
     if (type_ea) vm_write32(type_ea, (uint32_t)s_game_type);
-    if (attr_ea) vm_write32(attr_ea, 0);
+    if (attr_ea) vm_write32(attr_ea, s_game_attributes);
 
     if (size_ea) {
         vm_write32(size_ea + 0, (u32)content_free_kb());
@@ -376,9 +389,11 @@ s32 cellGameBootCheck(u32* type, u32* attributes, CellGameContentSize* size,
     /* Open a check session for the BOOT content (disc titles boot from
      * /dev_bdvd, not from the game-data dir). */
     s_check_is_disc = (s_game_type == CELL_GAME_GAMETYPE_DISC);
+    s_check_exists = 1;
     strncpy(s_check_dir, s_title_id, sizeof(s_check_dir) - 1);
     s_check_dir[sizeof(s_check_dir) - 1] = '\0';
-    printf("[cellGame] BootCheck: type=%u, titleId='%s'\n", s_game_type, s_title_id);
+    printf("[cellGame] BootCheck: type=%u, attributes=0x%x, titleId='%s', app ver '%s'\n",
+           s_game_type, (unsigned)s_game_attributes, s_title_id, s_app_ver);
     return CELL_OK;
 }
 
@@ -387,6 +402,18 @@ s32 cellGameContentPermit(char* contentInfoPath, char* usrdirPath)
     printf("[cellGame] ContentPermit() -> %s\n",
            s_check_is_disc ? "/dev_bdvd/PS3_GAME" : "game-data dir");
 
+    if (!s_check_is_disc && !s_check_exists) {
+        /* The game data DataCheck looked for is not there and CreateGameData was not
+         * called: empty paths, nothing created (the firmware's answer, as RPCS3's). Making
+         * the folders here invented data the title never created, and the extra copy
+         * under the VFS root wrote into the disc layer. */
+        uint32_t cip0 = (uint32_t)(uintptr_t)contentInfoPath, usr0 = (uint32_t)(uintptr_t)usrdirPath;
+        if (cip0) vm_base[cip0] = 0;
+        if (usr0) vm_base[usr0] = 0;
+        s_check_exists = 1;
+        s_check_is_disc = 1;   /* the session is closed */
+        return CELL_OK;
+    }
     if (!s_check_is_disc) {
         /* Ensure directories exist. IMPORTANT: also create them at the SAME host
          * location the VFS (ppu_fs.cpp host_path) maps /dev_hdd0/game/<title>/ to,
@@ -394,9 +421,15 @@ s32 cellGameContentPermit(char* contentInfoPath, char* usrdirPath)
          * ./gamedata/dev_hdd0/game/... which cellFs never looks at, so a game that
          * polls cellFsStat for its game-data USRDIR (LBP's boot bringup stage) stalls
          * forever and exits. Create it where cellFs will actually find it. */
-        ensure_dirs(s_content_info_path);
-        ensure_dirs(s_usrdir_path);
-        {
+        /* The session's own content (the directory DataCheck checked, or the booted HDD
+         * game), not s_content_info_path, which names the booted title whatever the session. */
+        char cpath[CELL_GAME_PATH_MAX];
+        snprintf(cpath, sizeof cpath, "%s/%s/USRDIR", content_root(), s_check_dir);
+        ensure_dirs(cpath);
+        if (!getenv("PS3_HDD0_ROOT") || !*getenv("PS3_HDD0_ROOT")) {
+            /* Only when /dev_hdd0 has no root of its own does ppu_fs map it under the
+             * VFS root; with PS3_HDD0_ROOT set, content_root() is already that place,
+             * and this copy would land in the disc layer. */
             extern const char* ppu_vfs_root;
             char vpath[CELL_GAME_PATH_MAX];
             snprintf(vpath, sizeof vpath, "%s/game/%s/USRDIR", ppu_vfs_root, s_check_dir);
@@ -455,12 +488,14 @@ s32 cellGameDataCheck(u32 type, const char* dirName, CellGameContentSize* size)
     /* Disc-content check (type 1 = CELL_GAME_GAMETYPE_DISC): the disc is
      * inherently present (mounted via the VFS root); a NOTFOUND here makes
      * disc titles bail out of boot. */
+    s_check_exists = 1;
     if (type == 1)
         return CELL_OK;
 
     if (dir_exists(path)) {
         return CELL_OK;
     }
+    s_check_exists = 0;
 
     /* Missing game-data dir is NOT an error: firmware (and RPCS3) return
      * CELL_GAME_RET_NONE (2) so the title knows to cellGameCreateGameData.
@@ -730,6 +765,7 @@ s32 cellGameCreateGameData(CellGameSetInitParams* init, char* tmp_contentInfoPat
     char usrdir[CELL_GAME_PATH_MAX];
     snprintf(usrdir, sizeof(usrdir), "%s/USRDIR", path);
     ensure_dirs(usrdir);
+    s_check_exists = 1;   /* created: a following ContentPermit reports it */
 
     /* Host paths are only for host filesystem access. Guest code feeds these
      * results back to cellFs, which resolves PS3 virtual paths through VFS. */
diff --git a/libs/system/tests/test_game_category.c b/libs/system/tests/test_game_category.c
index 5bf84c74..c0fce00c 100644
--- a/libs/system/tests/test_game_category.c
+++ b/libs/system/tests/test_game_category.c
@@ -63,6 +63,9 @@ static unsigned boot_type(const char* sfo_path, const char* category)
     return vm_read32(0x100);
 }
 
+/* The attributes the last boot_type() call's BootCheck reported. */
+static unsigned boot_attributes(void) { return vm_read32(0x104); }
+
 int main(void)
 {
     char root[] = "/tmp/ps3recomp-game-category-XXXXXX";
@@ -77,8 +80,59 @@ int main(void)
     assert(boot_type(sfo, "DG") == CELL_GAME_GAMETYPE_DISC);
     assert(boot_type(sfo, "HG") == CELL_GAME_GAMETYPE_HDD);
     assert(boot_type(sfo, "XX") == CELL_GAME_GAMETYPE_HDD);       /* an unmapped CATEGORY changes nothing */
+    assert(boot_attributes() == 0);
+
+    /* A disc game's update ("GD"): a disc game with the PATCH attribute, and the update's
+     * parameters (TITLE_ID, APP_VER) are the ones the title reads. */
+    {
+        const char* const kv[3][2] = { { "TITLE_ID", "TEST00001" }, { "CATEGORY", "GD" },
+                                       { "APP_VER", "01.22" } };
+        write_sfo(sfo, kv, 3);
+        cellGame_init_from_paramsfo(sfo);
+        assert(cellGameBootCheck((u32*)0x100, (u32*)0x104, (CellGameContentSize*)0x200, (char*)0x300) == CELL_OK);
+        assert(vm_read32(0x100) == CELL_GAME_GAMETYPE_DISC);
+        assert(boot_attributes() == CELL_GAME_ATTRIBUTE_PATCH);
+        char buf[16] = { 0 };
+        assert(cellGameGetParamString(CELL_GAME_PARAMID_TITLE_ID, (char*)0x400, 10) == CELL_OK);
+        assert(strcmp((const char*)vm_base + 0x400, "TEST00001") == 0);
+        assert(cellGameGetParamString(CELL_GAME_PARAMID_APP_VER, (char*)0x420, 6) == CELL_OK);
+        memcpy(buf, vm_base + 0x420, 6);
+        assert(strcmp(buf, "01.22") == 0);
+    }
+    assert(boot_type(sfo, "DG") == CELL_GAME_GAMETYPE_DISC);
+    assert(boot_attributes() == 0);
+
+    /* Game data that is not there: DataCheck answers RET_NONE, and ContentPermit answers empty
+     * paths and creates nothing, here or under the VFS root. Data that is there gets its paths. */
+    {
+        char vfs[300], probe[400];
+        snprintf(vfs, sizeof vfs, "%s/vfs", root);
+        assert(mkdir(vfs, 0755) == 0);
+        ppu_vfs_root = vfs;
+        strcpy((char*)vm_base + 0x500, "MISSING01");
+        assert(cellGameDataCheck(CELL_GAME_GAMETYPE_GAMEDATA, (char*)0x500, (CellGameContentSize*)0x200) == CELL_GAME_RET_NONE);
+        memset(vm_base + 0x600, 'x', 0x200);
+        assert(cellGameContentPermit((char*)0x600, (char*)0x700) == CELL_OK);
+        assert(vm_base[0x600] == 0 && vm_base[0x700] == 0);
+        struct stat st;
+        snprintf(probe, sizeof probe, "%s/MISSING01", root);
+        assert(stat(probe, &st) != 0);
+        snprintf(probe, sizeof probe, "%s/game", vfs);
+        assert(stat(probe, &st) != 0);
+
+        snprintf(probe, sizeof probe, "%s/HAVE00001", root);
+        assert(mkdir(probe, 0755) == 0);
+        strcpy((char*)vm_base + 0x500, "HAVE00001");
+        assert(cellGameDataCheck(CELL_GAME_GAMETYPE_GAMEDATA, (char*)0x500, (CellGameContentSize*)0x200) == CELL_OK);
+        assert(cellGameContentPermit((char*)0x600, (char*)0x700) == CELL_OK);
+        assert(strcmp((const char*)vm_base + 0x600, "/dev_hdd0/game/HAVE00001") == 0);
+        assert(strcmp((const char*)vm_base + 0x700, "/dev_hdd0/game/HAVE00001/USRDIR") == 0);
+        char cmd[400];
+        snprintf(cmd, sizeof cmd, "rm -rf '%s/HAVE00001' '%s'", root, vfs);
+        assert(system(cmd) == 0);
+    }
 
     assert(unlink(sfo) == 0); assert(rmdir(root) == 0);
     free(vm_base);
-    puts("cellGameBootCheck reports the game type from PARAM.SFO CATEGORY");
+    puts("cellGameBootCheck reports the game type and PATCH attribute from PARAM.SFO CATEGORY");
 }
diff --git a/tools/test_game_category.py b/tools/test_game_category.py
new file mode 100644
index 00000000..3bc978b7
--- /dev/null
+++ b/tools/test_game_category.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+"""cellGameBootCheck's game type and attributes from PARAM.SFO CATEGORY (libs/system/cellGame.c).
+
+"HG" is an HDD game, "DG" a disc game, and "GD" a disc game's update: a disc game with
+CELL_GAME_ATTRIBUTE_PATCH whose parameters (TITLE_ID, APP_VER, ...) are the update's. Builds
+libs/system/tests/test_game_category.c, which includes cellGame.c, and runs it.
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: the fixture is POSIX; run on macOS/Linux')
+        return 0
+    cc = os.environ.get('CC') or shutil.which('cc') or shutil.which('gcc') or shutil.which('clang')
+    if not cc:
+        print('SKIP: no C compiler')
+        return 0
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = Path(tmp) / 'test_game_category'
+        r = subprocess.run([cc, '-std=gnu17', '-O1', '-w', '-I' + str(ROOT / 'include'),
+                            str(ROOT / 'libs/system/tests/test_game_category.c'),
+                            '-Wl,-dead_strip' if sys.platform == 'darwin' else '-Wl,--gc-sections',
+                            '-o', str(exe)], capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+        sys.stdout.write(r.stdout + r.stderr)
+        return r.returncode
+
+
+if __name__ == '__main__':
+    sys.exit(main())
