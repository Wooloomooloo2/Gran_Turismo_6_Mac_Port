From: Gran Turismo 6 for Mac <https://github.com/Wooloomooloo2/Gran-Turismo-6-Mac>
Subject: [PATCH] cellGcmSys: record a gcm:flip milestone for each guest flip request

Upstream: not yet submitted
Licence: MIT, as ps3recomp (see its LICENSE); offered under the same terms
Base: ps3recomp 4e8f3ca87a3e1d87bb83b8b7e9348fe2685cd514

Every guest flip request that the present loop shows (the three places that
bump s_flip_request_count: the FIFO flip marker, cellGcmSetFlipCommand and
cellGcmSetPrepareFlip) now goes through gcm_note_flip_request(), which also
calls ps3_ms("gcm:flip"). The milestone log then says whether a title ever
reached its first frame, and its counts say how many it showed, without any
port-side code. With PS3_MILESTONE_OUT unset this costs one relaxed load.

The unit tests that #include cellGcmSys.c get an empty ps3_ms stub beside
their other stubs, so they still link.

Note for upstream: existing regress.py goldens gain one key ("gcm:flip") for
every title that flips.

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 298ee7de..9e282daf 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -27,6 +27,7 @@ static u32 s_gcm_context_ea = 0;
 #include <stdlib.h>
 #include <stdint.h>
 #include "ps3emu/log_first.h"
+#include "ps3emu/milestone.h"   /* ps3_ms -- boot milestone log */
 
 #ifdef _WIN32
 #include <windows.h>
@@ -103,6 +104,16 @@ u32 cellGcm_flip_request_count(void)
 {
     return s_flip_request_count;
 }
+
+/* A guest flip request the present loop will show: bump the frame-boundary
+ * count and record it in the milestone log, so a regression run can tell a
+ * title that reaches its first frame from one that only draws. */
+static void gcm_note_flip_request(void)
+{
+    s_flip_request_count++;
+    ps3_ms("gcm:flip");
+}
+
 static u32  s_debug_level = CELL_GCM_DEBUG_LEVEL0;
 
 /* Display buffers */
@@ -2307,7 +2318,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
                  * guest-visible half of the request. */
                 gcm_set_current_display_buffer(w & 7u);
                 s_flip_pending = 1;
-                s_flip_request_count++;
+                gcm_note_flip_request();
                 /* Not past `queued`: a resync may already have written off
                  * this flip. */
                 if (s_fifo_flips_reached != s_fifo_flips_queued) s_fifo_flips_reached++;
@@ -3104,7 +3115,7 @@ static s32 gcm_flip_request(u32 bufferId, int in_fifo)
     if (!in_fifo) {
         gcm_set_current_display_buffer(bufferId);
         s_flip_pending = 1;   /* ticker: present BEFORE the next drain */
-        s_flip_request_count++;
+        gcm_note_flip_request();
         s_flip_direct_pending = 1;
     }
     /* Flip requested but not yet shown: a subsequent cellGcmSetWaitFlip blocks
@@ -3218,7 +3229,7 @@ s32 cellGcmSetPrepareFlip(void* ctx, u32 bufferId)
 
     gcm_set_current_display_buffer(bufferId);
     s_flip_status = CELL_GCM_FLIP_STATUS_DONE;
-    s_flip_request_count++;
+    gcm_note_flip_request();
     s_last_flip_time = get_timestamp_ns();
 
     /* Invoke the guest flip handler via OPD resolution -- s_flip_handler holds
