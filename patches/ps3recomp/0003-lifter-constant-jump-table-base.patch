+def w_extsw(ra, rs):       return (31 << 26) | (rs << 21) | (ra << 16) | (986 << 1)
+
+
+def test_constant_table_base():
+    """An offset table whose base is a constant, not a TOC load:
+
+        lis r9,1 ; addi r9,r9,0x1C ; lwzx r0,r11,r9 ; extsw r0,r0
+        add r0,r0,r9 ; mtctr r0 ; bctr
+        0x1001C: .word 0x0C, 0x10 (offsets from the table)
+
+    Gran Turismo 6 func_00A3FEE0 (a 7-entry table inline after its bctr).
+    Before, the base was rejected as a non-TOC definition and every case
+    lifted to an unresolved indirect call.
+    """
+    table = TEXT_LO + 0x1C
+    words = [w_lis(9, 1), w_addi(9, 9, 0x1C), w_lwzx(0, 11, 9), w_extsw(0, 0),
+             w_add(0, 0, 9), w_mtctr(0), w_bctr()]
+    mem = {table: 0x0C, table + 4: 0x10, table + 8: 0xFFFFFFFF}
+    got = discover(words, mem)
+    check("constant (lis/addi) table base", got, [table + 0x0C, table + 0x10])
+
+
 if __name__ == "__main__":
     sys.exit(main())
