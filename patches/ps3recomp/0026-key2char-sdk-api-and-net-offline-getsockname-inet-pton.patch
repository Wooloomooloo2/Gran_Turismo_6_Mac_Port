+#!/usr/bin/env python3
+"""cellKey2char with the SDK's API (libs/misc/cellKey2char.c). Checks the five
+names a title imports hash to its NIDs (the HLE table registers by the hash of
+the name), then builds libs/misc/tests/test_key2char.c and runs it.
+"""
+import hashlib
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SUFFIX = b"\x67\x59\x65\x99\x04\x25\x04\x90\x56\x64\x27\x49\x94\x89\x74\x1A"
+
+
+def nid(name):
+    return struct.unpack('<I', hashlib.sha1(name.encode() + SUFFIX).digest()[:4])[0]
+
+
+def main():
+    fails = 0
+    for name, want in (("cellKey2CharOpen", 0xABF629C1), ("cellKey2CharClose", 0x14BF2DC1),
+                       ("cellKey2CharSetMode", 0xBFC03768), ("cellKey2CharSetArrangement", 0x0DFBADFA),
+                       ("cellKey2CharGetChar", 0x56776C0D)):
+        ok = want is None or nid(name) == want
+        fails += not ok
+        print(f"[{'PASS' if ok else 'FAIL'}] {name} hashes to 0x{nid(name):08X} (imported as {'that' if want is None else f'0x{want:08X}'})")
+    cxx = os.environ.get('CC') or shutil.which('cc') or shutil.which('clang')
+    if not cxx:
+        print('SKIP: no C++ compiler')
+        return 1 if fails else 0
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = Path(tmp) / 'test_key2char'
+        r = subprocess.run([cxx, '-std=gnu17', '-O1', '-w', '-I' + str(ROOT / 'include'),
+                            '-I' + str(ROOT / 'runtime'), '-I' + str(ROOT / 'runtime/ppu'),
+                            str(ROOT / 'libs/misc/tests/test_key2char.c'), '-o', str(exe)],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+        sys.stdout.write(r.stdout + r.stderr)
+        return 1 if (fails or r.returncode) else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
