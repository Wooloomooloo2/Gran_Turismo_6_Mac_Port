+/* A fault slot's state. One word, changed by compare-and-swap, so a 57 that
+ * lands while a host thread detaches cannot leave the slot taken for ever
+ * (batch 7 review I-1). A free slot (tid 0) may hold any state; the thread
+ * that claims it sets WAITING. */
+enum {
+    PF_WAITING   = 0,   /* the thread waits for 57 */
+    PF_RECOVERED = 1,   /* 57 answered; the waiting thread frees the slot */
+    PF_DETACHED  = 2,   /* its host thread went on; the event is still the pager's */
+    PF_ORPHANED  = 3,   /* its queue was destroyed with the event in it */
+    PF_FREEING   = 4,   /* being freed by a 57 or a destroy */
+};
