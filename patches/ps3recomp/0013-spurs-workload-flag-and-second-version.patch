+
+/* The second-version initialise: a CellSpurs2 (8 KB, up to 32 workloads; flags1 SF1_32_WORKLOADS). Argument
+ * checks follow RPCS3: NULL spurs or attribute, then a spurs off its 128-byte or an attribute off its 8-byte
+ * alignment. NID 0x30AA96C4. */
+s32 cellSpursInitializeWithAttribute2(CellSpurs* spurs, const CellSpursAttribute* attr)
+{
+    const u32 spurs_ea = (u32)(uintptr_t)spurs;
