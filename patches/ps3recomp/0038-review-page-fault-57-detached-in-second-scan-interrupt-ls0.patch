From: Gran Turismo 6 for Mac <https://github.com/Wooloomooloo2/Gran-Turismo-6-Mac>
Subject: [PATCH] Page-fault 57 takes a slot that detached between its scans; SPU interrupt executes a non-branch LS 0

Upstream: not yet submitted; written to be upstreamed (generic, no title names)
Licence: MIT, as ps3recomp (see its LICENSE); offered under the same terms
Base: ps3recomp 4e8f3ca87a3e1d87bb83b8b7e9348fe2685cd514 (after 0001-0037)

What (1), lv2 57: its second scan now takes a DETACHED slot too (DETACHED to
FREEING, freed, CELL_OK), and re-reads the state when a CAS fails. Before, a
host thread that detached after the first scan passed its WAITING slot made
57 answer CELL_EINVAL and left the slot DETACHED for ever; 64 such losses hang
the fault-slot claim loop. A test-only hook (ps3_pf_test_57_hook, NULL
otherwise) lets a test force the detach into exactly the two windows.
What (2), the SPU interpreter: an interrupt whose LS 0 word is no br/bra is
now taken and executed from LS 0, as hardware does (before: reported and not
taken). A br/bra there is still followed at once (same target).
What (3), comments: the destroy hook's unsynchronised addr/qid reads; the
interrupt comment no longer cites a section number.
Behaviour reference: lv2 page-fault notification as RPCS3 models it, the Cell
Broadband Engine Architecture and SPU ISA (the SPU interrupt facility);
RPCS3 read only, no code from it.
Tests: tests/test_mmapper_page_fault.c (forced detach between 57's scans and
between its read and CAS: 57 answers OK and frees the slot; both fail on the
old code) and runtime/spu/tests/test_spu_interp_takes_interrupt.c (a non-branch
LS 0 runs, then the handler, then iret returns).
diff --git a/runtime/syscalls/sys_mmapper_pf.c b/runtime/syscalls/sys_mmapper_pf.c
--- a/runtime/syscalls/sys_mmapper_pf.c
+++ b/runtime/syscalls/sys_mmapper_pf.c
@@ -78,8 +78,8 @@
 } pf_area;
 
 /* A fault slot's state. One word, changed by compare-and-swap, so a 57 that
- * lands while a host thread detaches cannot leave the slot taken for ever
- * (batch 7 review I-1). A free slot (tid 0) may hold any state; the thread
+ * lands while a host thread detaches does not leave the slot taken
+ * (batch 7 review I-1; batch 8 review I-1). A free slot (tid 0) may hold any state; the thread
  * that claims it sets WAITING. */
 enum {
     PF_WAITING   = 0,   /* the thread waits for 57 */
@@ -268,6 +268,8 @@
 #endif
 }
 
+void (*ps3_pf_test_57_hook)(int where);
+
 static int pf_cas_state(pf_fault* f, int from, int to)
 {
     return __atomic_compare_exchange_n(&f->state, &from, to, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
@@ -455,16 +457,33 @@
     /* A detached slot (its host thread already went on) answers first: its
      * event was sent first, and the pager answers events in order. */
     if (!tid) return (int64_t)(int32_t)CELL_EINVAL;
-    for (int pass = 0; pass < 2; pass++)
+    for (int pass = 0; pass < 2; pass++) {
+        if (pass && ps3_pf_test_57_hook) ps3_pf_test_57_hook(0);
         for (int i = 0; i < PF_FAULT_MAX; i++) {
             pf_fault* f = &s_fault[i];
             if ((__atomic_load_n(&f->tid, __ATOMIC_ACQUIRE) & 0xFFFFFFFFull) != tid) continue;
             if (!pass) {   /* detached: nobody waits on it, free the slot */
                 if (pf_cas_state(f, PF_DETACHED, PF_FREEING)) { pf_free(f); return CELL_OK; }
-            } else if (pf_cas_state(f, PF_WAITING, PF_RECOVERED)) {
-                return CELL_OK;
+                continue;
+            }
+            /* Pass 1 takes a waiting slot, or a detached one: its host thread
+             * may have detached after pass 0 looked, or between the read and
+             * the CAS here (batch 8 review I-1). A failed CAS means the state
+             * moved (WAITING to DETACHED or ORPHANED): look again. Bounded:
+             * a slot's state only moves forward until it is freed. */
+            for (;;) {
+                int st = __atomic_load_n(&f->state, __ATOMIC_ACQUIRE);
+                if (ps3_pf_test_57_hook) ps3_pf_test_57_hook(1);
+                if (st == PF_WAITING) {
+                    if (pf_cas_state(f, PF_WAITING, PF_RECOVERED)) return CELL_OK;
+                } else if (st == PF_DETACHED) {
+                    if (pf_cas_state(f, PF_DETACHED, PF_FREEING)) { pf_free(f); return CELL_OK; }
+                } else {
+                    break;     /* recovered, orphaned or being freed: not ours to answer */
+                }
             }
         }
+    }
     return (int64_t)(int32_t)CELL_EINVAL;
 }
 
@@ -484,6 +503,11 @@
      * dropped. */
     if (!queue_id || queue_id > SYS_EVENT_QUEUE_MAX) return;
     const sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    /* addr and qid are read without synchronising with a thread claiming the
+     * slot (batch 8 review M-4): between its tid claim and its `qid = 0` store
+     * they may still be a previous fault's. That is harmless: acting needs a
+     * queued event matching that stale addr AND the new tid, and the CASes
+     * below only move a slot that is WAITING or DETACHED. */
     for (int i = 0; i < PF_FAULT_MAX; i++) {
         pf_fault* f = &s_fault[i];
         uint64_t tid = __atomic_load_n(&f->tid, __ATOMIC_ACQUIRE);
diff --git a/runtime/syscalls/sys_mmapper_pf.h b/runtime/syscalls/sys_mmapper_pf.h
