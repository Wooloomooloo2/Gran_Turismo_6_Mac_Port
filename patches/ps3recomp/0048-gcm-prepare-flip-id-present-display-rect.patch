diff --git a/tools/test_gcm_prepare_flip.py b/tools/test_gcm_prepare_flip.py
new file mode 100644
index 00000000..f2364d02
--- /dev/null
+++ b/tools/test_gcm_prepare_flip.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""cellGcmSetPrepareFlip returns the prepared buffer's id (libs/video/tests/
+test_gcm_prepare_flip.c, which compiles cellGcmSys.c in)."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+if os.name == 'nt':
+    print('SKIP: the GCM flip fixture uses POSIX linking')
+    raise SystemExit(0)
+with tempfile.TemporaryDirectory(prefix='gcm-prepare-flip-') as tmp:
+    binary = Path(tmp) / 'test'
+    linker = ['-Wl,-dead_strip'] if sys.platform == 'darwin' else ['-Wl,--gc-sections', '-pthread', '-lm']
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-O1', '-UNDEBUG',
+                    '-ffunction-sections', '-fdata-sections',
+                    '-I' + str(root / 'include'), '-I' + str(root / 'libs/video'),
+                    str(root / 'libs/video/tests/test_gcm_prepare_flip.c'), *linker,
+                    '-o', str(binary)], check=True)
+    result = subprocess.run([str(binary)], timeout=30, capture_output=True, text=True)
+    print(result.stdout.strip())
+    if result.returncode:
+        print(result.stderr[-2000:])
+        raise SystemExit('test_gcm_prepare_flip failed')
diff --git a/tools/test_metal_present_rect.py b/tools/test_metal_present_rect.py
new file mode 100644
index 00000000..e0830e52
--- /dev/null
+++ b/tools/test_metal_present_rect.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+"""The Metal backend's present_rect: a display buffer smaller than the surface at
+its address presents exactly that top-left rectangle."""
+import pathlib
+import platform
+import subprocess
+import tempfile
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+if platform.system() != "Darwin":
+    print("SKIP: Metal requires macOS")
+    raise SystemExit(0)
+with tempfile.TemporaryDirectory(prefix="metal-present-rect-") as tmp:
+    binary = pathlib.Path(tmp) / "test"
+    subprocess.run(["clang", "-fobjc-arc", "-Iinclude", "-Ilibs/video",
+                    "libs/video/tests/test_metal_present_rect.m",
+                    "libs/video/rsx_texture_layout.c", "libs/video/rsx_shader_msl.cpp",
+                    "-lc++", "-Wl,-dead_strip",
+                    "-framework", "Metal", "-framework", "Cocoa",
+                    "-framework", "QuartzCore", "-o", str(binary)],
+                   cwd=ROOT, check=True, timeout=120)
+    subprocess.run([str(binary)], check=True, timeout=30)
