+/* ---- per-frame draw and clear counts (the frame series' statistics) ------ */
+
+static void test_frame_counts(void)
+{
+    printf("-- draw and clear counts per presented frame\n");
+    engine_up();
+    u32 d = 99, c = 99;
+    rsx_draw_engine_frame_counts(&d, &c);
+    CHECK(d == 0 && c == 0, "nothing presented yet: 0 draws, 0 clears (%u, %u)", d, c);
+
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    draw_triangle();
+    draw_triangle();
+    /* An empty group is not a draw call. */
+    m(M_BEGIN_END, RSX_PRIMITIVE_TRIANGLES);
+    m(M_BEGIN_END, 0u);
+    rsx_draw_engine_present();
+    CHECK(stub.present_draws == 2 && stub.present_clears == 1,
+          "the backend's present sees this frame's counts: 2 draws, 1 clear (%u, %u)",
+          stub.present_draws, stub.present_clears);
+    rsx_draw_engine_frame_counts(&d, &c);
+    CHECK(d == 2 && c == 1, "and they stay readable after it (%u, %u)", d, c);
+
+    /* A depth/stencil-only clear is a clear too. */
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    m(M_CLEAR_BUFFERS, 0x03u);
+    rsx_draw_engine_present();
+    CHECK(stub.present_draws == 0 && stub.present_clears == 2,
+          "the next frame starts from zero: 0 draws, 2 clears (%u, %u)",
+          stub.present_draws, stub.present_clears);
+    engine_down();
+}
+
 int main(void)
 {
     vm_base = (u8*)calloc(1, GUEST_BYTES);
