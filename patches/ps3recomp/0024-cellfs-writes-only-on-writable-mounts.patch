+/* ---- calls that change the file system: the writable-mount allowlist ----
+ *
+ * Every call that creates, removes, renames, truncates or opens a file for writing goes
+ * through fs_target_of(), because the other mounts resolve into host folders that must never
+ * change (the disc image, a firmware tree):
+ *   - the guest path is made canonical the way lv2's VFS reads it ('.' and empty components
+ *     dropped, '..' pops one component and stops at '/'); a path that is not absolute is
+ *     ENOENT, as lv2 refuses it before any lookup;
+ *   - only /dev_hdd0/... and /dev_hdd1/... (PS3_HDD0_ROOT, PS3_HDD1_ROOT) may change. The
+ *     read-only mounts (/dev_bdvd, /dev_flash*, /app_home) answer as lv2 answers for a
+ *     read-only mount (EROFS, or EPERM for an open), every other device (or a path with no
+ *     device) ENOTMOUNTED, and "/" itself what lv2 answers for its admin root;
+ *   - the host path is built from the mount's root directly (no fallback into other mounts,
+ *     unlike host_path()) and its parent folder is resolved with realpath(): the change
+ *     happens only when that lies inside the mount's resolved root, so a symlink inside the
+ *     writable folder cannot reach outside it (answered as a read-only mount would).
+ * The answers otherwise follow RPCS3's sys_fs handlers (behaviour only; no RPCS3 code). */
+#define CELL_FS_EPERM      (int32_t)0x80010009u
+#define CELL_FS_EBUSY      (int32_t)0x8001000Au
+#define CELL_FS_EEXIST     (int32_t)0x80010014u
+#define CELL_FS_EROFS      (int32_t)0x80010026u
+#define CELL_FS_ENOTDIR    (int32_t)0x8001002Eu
+#define CELL_FS_EXDEV      (int32_t)0x80010030u
+#define CELL_FS_ENAMETOOLONG (int32_t)0x80010034u
+#define CELL_FS_ENOTEMPTY  (int32_t)0x80010036u
+#define CELL_FS_ENOTMOUNTED (int32_t)0x8001003Au
+/* lv2's reading of a guest path: '.' and empty components dropped, '..' pops
+ * one component (never above '/'). false for a path that is not absolute or
+ * does not fit. */
+static bool fs_canonical(const char* g, char* out, size_t cap)
+{
+    if (!g || g[0] != '/' || cap < 2) return false;
+    size_t len = 0;
+    out[0] = 0;
+    const char* p = g;
+    while (*p) {
+        while (*p == '/') p++;
+        const char* e = p;
+        while (*e && *e != '/') e++;
+        const size_t n = (size_t)(e - p);
+        if (n == 0 || (n == 1 && p[0] == '.')) { p = e; continue; }
+        if (n == 2 && p[0] == '.' && p[1] == '.') {
+            while (len > 0 && out[len - 1] != '/') len--;
+            if (len > 0) len--;            /* drop the '/' too */
+            out[len] = 0;
+            p = e; continue;
+        }
+        if (len + 1 + n + 1 > cap) return false;
+        out[len++] = '/';
+        memcpy(out + len, p, n); len += n; out[len] = 0;
+        p = e;
+    }
+    if (len == 0) { out[0] = '/'; out[1] = 0; }
+    return true;
+}
+static bool fs_on_device(const char* v, const char* dev)
+{
+    const size_t n = strlen(dev);
+    return strncmp(v, dev, n) == 0 && (v[n] == 0 || v[n] == '/');
+}
+static bool fs_resolve(const char* in, char* out)   /* out: PATH_MAX bytes */
+{
+#ifdef _WIN32
+    return _fullpath(out, in, PATH_MAX) != nullptr;
+#else
+    return realpath(in, out) != nullptr;
+#endif
+}
+enum fs_where {
+    FS_WRITABLE,        /* inside /dev_hdd0 or /dev_hdd1: host is set */
+    FS_READONLY,        /* a read-only mount */
+    FS_ESCAPE,          /* inside a writable mount, but a symlink leads out of it */
+    FS_UNMOUNTED,       /* an unknown device, or no device */
+    FS_ADMIN_ROOT,      /* "/" itself */
+    FS_RELATIVE,        /* not absolute (or too long) */
+    FS_NO_PARENT,       /* inside a writable mount; the parent folder does not resolve, or a
+                           trailing '/' follows a file (parent_errno ENOTDIR) */
+    FS_TOO_LONG,        /* the host path does not fit */
+};
+struct fs_target {
+    fs_where where;
+    char dev[64];        /* the canonical device ("dev_hdd0"); cross-device renames compare it */
+    bool mount_root;     /* the path is the writable mount itself */
+    int  parent_errno;   /* FS_NO_PARENT: why the parent did not resolve */
+    char host[PATH_MAX]; /* FS_WRITABLE: the host path */
+};
+static void fs_target_of(const char* gpath, fs_target* t)
+{
+    char v[1024];
+    t->dev[0] = 0; t->host[0] = 0; t->mount_root = false; t->parent_errno = 0;
+    if (!fs_canonical(gpath, v, sizeof v)) { t->where = FS_RELATIVE; return; }
+    if (v[1] == 0) { t->where = FS_ADMIN_ROOT; return; }
+    { const char* e = strchr(v + 1, '/');
+      const size_t n = e ? (size_t)(e - v - 1) : strlen(v + 1);
+      snprintf(t->dev, sizeof t->dev, "%.*s", (int)n, v + 1); }
+    const char* root = nullptr;
+    const char* rest = nullptr;
+    if (fs_on_device(v, "/dev_hdd0"))      { root = getenv("PS3_HDD0_ROOT"); rest = v + 9; }
+    else if (fs_on_device(v, "/dev_hdd1")) { root = getenv("PS3_HDD1_ROOT"); rest = v + 9; }
+    else if (fs_on_device(v, "/dev_bdvd") || fs_on_device(v, "/app_home") ||
+             strncmp(v, "/dev_flash", 10) == 0) { t->where = FS_READONLY; return; }
+    else { t->where = FS_UNMOUNTED; return; }
+    char croot[PATH_MAX];
+    if (!root || !*root || !fs_resolve(root, croot)) { t->where = FS_UNMOUNTED; return; }
+    if (*rest == 0) {                               /* the mount itself */
+        t->where = FS_WRITABLE; t->mount_root = true;
+        snprintf(t->host, sizeof t->host, "%s", croot);
+        return;
+    }
+    char hparent[PATH_MAX], cparent[PATH_MAX];
+    const char* name = strrchr(rest, '/') + 1;   /* rest starts with '/', canonical: no '.'/'..' */
+    const int hn = snprintf(hparent, sizeof hparent, "%s/%.*s", root, (int)(name - rest), rest);
+    if (hn < 0 || (size_t)hn >= sizeof hparent) { t->where = FS_TOO_LONG; return; }
+    if (!fs_resolve(hparent, cparent)) { t->where = FS_NO_PARENT; t->parent_errno = errno; return; }
+    const size_t rl = strlen(croot);
+    if (strncmp(cparent, croot, rl) != 0 || (cparent[rl] != 0 && cparent[rl] != '/')) {
+        t->where = FS_ESCAPE; return;             /* a symlink led out of the writable folder */
+    }
+    const int n = snprintf(t->host, sizeof t->host, "%s/%s", cparent, name);
+    if (n < 0 || (size_t)n >= sizeof t->host) { t->where = FS_TOO_LONG; t->host[0] = 0; return; }
+    t->where = FS_WRITABLE;
+    /* A trailing '/' names a directory: after a file it is ENOTDIR, as POSIX and lv2 answer
+     * (canonicalising dropped it, so check here). */
+    const size_t gl = strlen(gpath);
+    struct stat st;
+    if (gl > 1 && gpath[gl - 1] == '/' && lstat(t->host, &st) == 0 && !S_ISDIR(st.st_mode)) {
+        t->where = FS_NO_PARENT; t->parent_errno = ENOTDIR;
+    }
+}
+/* The answer for a target that may not change: `at_root` for "/" and `at_readonly` for a
+ * read-only mount (or a symlink out of a writable one) are the calling call's. */
+static int32_t fs_refusal(const fs_target& t, int32_t at_root, int32_t at_readonly)
+{
+    switch (t.where) {
+    case FS_RELATIVE:   return CELL_FS_ENOENT;
+    case FS_ADMIN_ROOT: return at_root;
+    case FS_UNMOUNTED:  return CELL_FS_ENOTMOUNTED;
+    case FS_READONLY:
+    case FS_ESCAPE:     return at_readonly;
+    case FS_NO_PARENT:  return t.parent_errno == ENOTDIR ? CELL_FS_ENOTDIR : CELL_FS_ENOENT;
+    case FS_TOO_LONG:   return CELL_FS_ENAMETOOLONG;
+    case FS_WRITABLE:   break;
+    }
+    return CELL_OK;
+}
