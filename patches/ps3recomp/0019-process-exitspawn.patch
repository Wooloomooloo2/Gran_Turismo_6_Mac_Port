diff --git a/tools/test_exitspawn.py b/tools/test_exitspawn.py
new file mode 100644
index 0000000..9db4e15
--- /dev/null
+++ b/tools/test_exitspawn.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Process exit-spawn (libs/system/sysGameExitspawn.c).
+
+Titles import sys_game_process_exitspawn2 (0x67F9FEDB) and
+sceNpDrmProcessExitSpawn2 (0xE6C8F3F9) to end their process and start an
+executable (or themselves again) in its place. Neither had a handler, so each
+took the unresolved path and faked CELL_OK, and the title ran on past its own
+exit. Checks that the names hash to the imported NIDs, then builds
+libs/system/tests/test_exitspawn.c, which includes sysGameExitspawn.c, and runs it.
+"""
+import hashlib
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SUFFIX = b"\x67\x59\x65\x99\x04\x25\x04\x90\x56\x64\x27\x49\x94\x89\x74\x1A"
+NIDS = (('sys_game_process_exitspawn2', 0x67F9FEDB), ('sceNpDrmProcessExitSpawn2', 0xE6C8F3F9),
+        ('sys_game_process_exitspawn', 0xFC52A7A9), ('sceNpDrmProcessExitSpawn', 0xAA16695F))
+
+
+def nid(name):
+    return struct.unpack('<I', hashlib.sha1(name.encode() + SUFFIX).digest()[:4])[0]
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: the fixture is POSIX; run on macOS/Linux')
+        return 0
+    fails = 0
+    for name, want in NIDS:
+        got = nid(name)
+        fails += got != want
+        print(f"[{'PASS' if got == want else 'FAIL'}] {name} hashes to 0x{got:08X} (imported as 0x{want:08X})")
+    cc = os.environ.get('CC') or shutil.which('cc') or shutil.which('gcc') or shutil.which('clang')
+    if not cc:
+        print('SKIP: no C compiler')
+        return 1 if fails else 0
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = Path(tmp) / 'test_exitspawn'
+        r = subprocess.run([cc, '-std=gnu17', '-O1', '-w', '-pthread', '-I' + str(ROOT / 'include'),
+                            str(ROOT / 'libs/system/tests/test_exitspawn.c'), '-o', str(exe)],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+        sys.stdout.write(r.stdout + r.stderr)
+        return 1 if (fails or r.returncode) else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
