diff --git a/libs/misc/tests/test_osk_dialog.c b/libs/misc/tests/test_osk_dialog.c
new file mode 100644
index 00000000..6aaee0a4
--- /dev/null
+++ b/libs/misc/tests/test_osk_dialog.c
@@ -0,0 +1,170 @@
+/*
+ * test_osk_dialog - the on-screen keyboard (libs/misc/cellOskDialog.c).
+ *
+ * LoadAsync posts LOADED to every sysutil slot; the host answers on a later
+ * poll (cellOskDialog_tick) with FINISHED; UnloadAsync returns the result and
+ * the text, NUL-terminated within numCharsResultString, and posts UNLOADED.
+ * PS3_OSK_TEXT supplies one text per dialog, in order; past it the initial
+ * text stands. Argument checks and codes as the SDK documents them (RPCS3 as
+ * the behaviour reference). Also checks the names hash to GT6's imported NIDs
+ * for the four that were unresolved. Run by tools/test_osk_dialog.py.
+ */
+#include "../cellOskDialog.c"
+#include <assert.h>
+
+uint8_t* vm_base;
+int g_resv_store_active = 0;
+uint32_t g_ww_lo = 0, g_ww_hi = 0;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+
+static u32 ev[1024]; static int ev_slot[1024]; static int n_ev;
+void cellSysutilQueueEvent(int slot, u32 status, u32 param)
+{
+    (void)param;
+    if (n_ev < 1024) { ev_slot[n_ev] = slot; ev[n_ev] = status; }
+    n_ev++;
+}
+
+static int fails = 0;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+
+#define PARAM 0x1000u
+#define INFO  0x1100u
+#define MSG   0x1200u
+#define INIT  0x1300u
+#define RET   0x1400u
+#define STR   0x1500u
+
+static void put_utf16(u32 ea, const char* s)
+{
+    for (; *s; s++, ea += 2) vm_write16(ea, (u16)*s);
+    vm_write16(ea, 0);
+}
+
+static int text_is(u32 ea, const char* s)
+{
+    for (; *s; s++, ea += 2) if (vm_read16(ea) != (u16)*s) return 0;
+    return vm_read16(ea) == 0;
+}
+
+/* Every slot got `status`, and only that, since n_ev was `from`. */
+static int broadcast(int from, u32 status)
+{
+    if (n_ev - from != CELL_SYSUTIL_MAX_CALLBACKS) return 0;
+    for (int i = from; i < n_ev; i++) if (ev[i] != status || ev_slot[i] != i - from) return 0;
+    return 1;
+}
+
+static s32 load(u32 limit)
+{
+    vm_write32(INFO + 0, MSG); vm_write32(INFO + 4, INIT); vm_write32(INFO + 8, limit);
+    return cellOskDialogLoadAsync(0, (void*)(uintptr_t)PARAM, (void*)(uintptr_t)INFO);
+}
+
+static s32 unload(s32 room)
+{
+    vm_write32(RET + 0, 0xDEADu); vm_write32(RET + 4, (u32)room); vm_write32(RET + 8, STR);
+    for (u32 i = 0; i < 32; i++) vm_write16(STR + i * 2, 0x7777);
+    return cellOskDialogUnloadAsync((void*)(uintptr_t)RET);
+}
+
+int main(void)
+{
+    vm_base = calloc(1, 0x10000);
+    put_utf16(MSG, "First Name");
+    put_utf16(INIT, "");
+    setenv("PS3_OSK_DELAY_MS", "0", 1);
+
+    /* Argument checks. */
+    CHECK((u32)cellOskDialogLoadAsync(0, NULL, (void*)(uintptr_t)INFO) == CELL_OSKDIALOG_ERROR_PARAM,
+          "LoadAsync with no dialog parameters is PARAM");
+    vm_write32(INFO + 0, 0); vm_write32(INFO + 4, INIT); vm_write32(INFO + 8, 12);
+    CHECK((u32)cellOskDialogLoadAsync(0, (void*)(uintptr_t)PARAM, (void*)(uintptr_t)INFO) ==
+          CELL_OSKDIALOG_ERROR_PARAM, "LoadAsync with no message is PARAM");
+    CHECK((u32)load(513) == CELL_OSKDIALOG_ERROR_PARAM, "a limit over 512 is PARAM");
+    CHECK((u32)unload(32) == CELL_MSGDIALOG_ERROR_DIALOG_NOT_OPENED, "UnloadAsync with nothing open");
+    CHECK((u32)cellOskDialogAbort() == CELL_MSGDIALOG_ERROR_DIALOG_NOT_OPENED, "Abort with nothing open");
+    CHECK((u32)cellOskDialogSetKeyLayoutOption(0) == CELL_OSKDIALOG_ERROR_PARAM &&
+          (u32)cellOskDialogSetKeyLayoutOption(4) == CELL_OSKDIALOG_ERROR_PARAM &&
+          cellOskDialogSetKeyLayoutOption(3) == CELL_OK, "SetKeyLayoutOption takes 1..3");
+    CHECK((u32)cellOskDialogSetInitialKeyLayout(3) == CELL_OSKDIALOG_ERROR_PARAM &&
+          cellOskDialogSetInitialKeyLayout(2) == CELL_OK, "SetInitialKeyLayout takes 0..2");
+    CHECK(cellOskDialogDisableDimmer() == CELL_OK, "DisableDimmer");
+    static ppu_context ctx;
+    g_active_ctx = &ctx;
+    ctx.fpr[1] = 1.0;
+    CHECK(cellOskDialogExtSetInitialScale() == CELL_OK, "ExtSetInitialScale(1.0)");
+    ctx.fpr[1] = 1.5;
+    CHECK((u32)cellOskDialogExtSetInitialScale() == CELL_OSKDIALOG_ERROR_PARAM, "ExtSetInitialScale(1.5) is PARAM");
+    CHECK((u32)cellOskDialogExtRegisterForceFinishCallback(0) == CELL_OSKDIALOG_ERROR_PARAM &&
+          cellOskDialogExtRegisterForceFinishCallback(0x5000) == CELL_OK, "ExtRegisterForceFinishCallback");
+    CHECK(n_ev == 0, "nothing posted so far (%d)", n_ev);
+
+    /* A dialog the host confirms with its initial text, no script. */
+    unsetenv("PS3_OSK_TEXT");
+    put_utf16(INIT, "John");
+    int from = n_ev;
+    CHECK(load(12) == CELL_OK && broadcast(from, CELL_SYSUTIL_OSKDIALOG_LOADED), "LoadAsync posts LOADED to every slot");
+    CHECK((u32)load(12) == CELL_SYSUTIL_ERROR_BUSY, "a second LoadAsync while open is BUSY");
+    vm_write32(RET + 4, 32); vm_write32(RET + 8, STR);
+    CHECK(cellOskDialogGetInputText((void*)(uintptr_t)RET) == CELL_OK &&
+          vm_read32(RET) == CELL_OSKDIALOG_INPUT_FIELD_RESULT_NO_INPUT_TEXT,
+          "GetInputText before anything is entered: NO_INPUT_TEXT");
+    from = n_ev;
+    cellOskDialog_tick();
+    CHECK(broadcast(from, CELL_SYSUTIL_OSKDIALOG_FINISHED), "the host's answer posts FINISHED");
+    from = n_ev;
+    cellOskDialog_tick();
+    CHECK(n_ev == from, "only once");
+    from = n_ev;
+    CHECK(unload(32) == CELL_OK && vm_read32(RET) == CELL_OSKDIALOG_INPUT_FIELD_RESULT_OK &&
+          text_is(STR, "John") && broadcast(from, CELL_SYSUTIL_OSKDIALOG_UNLOADED),
+          "UnloadAsync: OK, \"John\", UNLOADED");
+
+    /* Scripted texts, one per dialog; a short buffer truncates. */
+    setenv("PS3_OSK_TEXT", "Alpha,Bravo", 1);
+    cellOskDialog_reset_for_test();
+    put_utf16(INIT, "");
+    load(12); cellOskDialog_tick();
+    CHECK(unload(32) == CELL_OK && text_is(STR, "Alpha"), "the first dialog gets the first entry");
+    load(12); cellOskDialog_tick();
+    CHECK(unload(3) == CELL_OK && vm_read16(STR) == 'B' && vm_read16(STR + 2) == 'r' &&
+          vm_read16(STR + 4) == 'a' && vm_read16(STR + 6) == 0, "the second gets the second, cut to the room given");
+    put_utf16(INIT, "Smith");
+    load(12); cellOskDialog_tick();
+    CHECK(unload(32) == CELL_OK && text_is(STR, "Smith"), "past the list the initial text stands");
+    load(3); cellOskDialog_tick();
+    CHECK(unload(32) == CELL_OK && text_is(STR, "Smi"), "the initial text is cut to the field's limit");
+
+    /* Cancel and Abort. */
+    setenv("PS3_OSK_CANCEL", "1", 1);
+    load(12); cellOskDialog_tick();
+    CHECK(unload(32) == CELL_OK && vm_read32(RET) == CELL_OSKDIALOG_INPUT_FIELD_RESULT_CANCELED &&
+          vm_read16(STR) == 0x7777, "PS3_OSK_CANCEL: CANCELED, no text written");
+    unsetenv("PS3_OSK_CANCEL");
+    load(12);
+    from = n_ev;
+    CHECK(cellOskDialogAbort() == CELL_OK && broadcast(from, CELL_SYSUTIL_OSKDIALOG_FINISHED), "Abort posts FINISHED");
+    from = n_ev;
+    cellOskDialog_tick();
+    CHECK(n_ev == from, "an aborted dialog gets no host answer");
+    CHECK(unload(32) == CELL_OK && vm_read32(RET) == CELL_OSKDIALOG_INPUT_FIELD_RESULT_ABORT, "UnloadAsync after Abort: ABORT");
+
+    /* A delay keeps FINISHED off the poll that delivers LOADED. */
+    setenv("PS3_OSK_DELAY_MS", "100000", 1);
+    load(12);
+    from = n_ev;
+    cellOskDialog_tick();
+    CHECK(n_ev == from, "before the delay the dialog stays open");
+    cellOskDialogAbort(); unload(32);
+
+    printf(fails ? "%d check(s) FAILED\n" : "all checks passed\n", fails);
+    return fails ? 1 : 0;
+}
