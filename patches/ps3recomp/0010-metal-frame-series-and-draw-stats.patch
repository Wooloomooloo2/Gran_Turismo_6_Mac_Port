diff --git a/tools/test_frame_series.py b/tools/test_frame_series.py
new file mode 100644
index 00000000..36ab1850
--- /dev/null
+++ b/tools/test_frame_series.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""The Metal backend's frame series and draw statistics (libs/video/rsx_frame_series.h).
+
+PS3RECOMP_METAL_FRAME_DIR keeps numbered dumps (frame_<presented>.ppm, the first present
+and every PS3RECOMP_METAL_FRAME_EVERY-th after it, at most PS3RECOMP_METAL_FRAME_MAX, until
+a STOP file appears in the folder), and PS3RECOMP_DRAW_STATS writes one
+"<presented> <draws> <clears>" line per present. The policy and the writers are plain C,
+so this builds libs/video/tests/test_frame_series.c, which includes the header, and runs
+it. On macOS it also builds libs/video/tests/test_metal_frame_series.m, which includes
+rsx_metal_backend.m and checks its present glue against a real Metal texture (it prints
+SKIP and passes without a Metal device). The draw engine's per-frame counts are checked by
+tests/test_rsx_draw_engine.c (tools/test_rsx_immediate_vertices.py).
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: the fixture uses POSIX file calls; run on macOS/Linux')
+        return 0
+    cc = os.environ.get('CC') or shutil.which('cc') or shutil.which('gcc') or shutil.which('clang')
+    if not cc:
+        print('SKIP: no C compiler')
+        return 0
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = Path(tmp) / 'test_frame_series'
+        r = subprocess.run([cc, '-std=gnu17', '-O1', '-Wall', '-Werror', '-Wno-unused-function',
+                            '-I' + str(ROOT / 'include'),
+                            str(ROOT / 'libs/video/tests/test_frame_series.c'), '-o', str(exe)],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=60,
+                           env={**os.environ, 'TMPDIR': tmp})
+        sys.stdout.write(r.stdout + r.stderr)
+        if r.returncode:
+            return 1
+        if sys.platform != 'darwin':
+            return 0
+        exe = Path(tmp) / 'test_metal_frame_series'
+        r = subprocess.run([cc, '-fobjc-arc', '-I' + str(ROOT / 'include'),
+                            '-I' + str(ROOT / 'libs/video'),
+                            str(ROOT / 'libs/video/tests/test_metal_frame_series.m'),
+                            '-Wl,-dead_strip', '-framework', 'Metal', '-framework', 'Cocoa',
+                            '-framework', 'QuartzCore', '-framework', 'IOSurface',
+                            '-o', str(exe)], capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: Metal fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=120,
+                           env={**os.environ, 'TMPDIR': tmp})
+        sys.stdout.write(r.stdout + r.stderr)
+        return 1 if r.returncode else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
