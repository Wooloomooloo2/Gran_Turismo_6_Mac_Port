+/* Whether thread `tid` exists (1) or not (0), and its priority in *prio. For
+ * the runtime's own sync objects (the lwcond wake order and ESRCH answer in
+ * runtime/ppu/ppu_sysprx.cpp). The main thread's "never set" 0 reads as the
+ * default, as creator_priority() takes it. */
+int ppu_thread_query(uint64_t tid, int32_t* prio)
+{
+    table_lock();
+    const ppu_thread_info* t = find_thread(tid);
+    if (t && prio)
+        *prio = (t == &g_ppu_threads[0] && t->priority == 0) ? PPU_DEFAULT_PRIORITY : t->priority;
+    table_unlock();
+    return t != NULL;
+}
