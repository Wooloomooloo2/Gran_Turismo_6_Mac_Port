diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
--- a/libs/video/tests/test_rsx_draw_engine.c
+++ b/libs/video/tests/test_rsx_draw_engine.c
@@ -1954,6 +1954,62 @@ static void test_z16_read_as_depth16_on_gpu(void)
     engine_down();
 }
 
+/* D71: on the RSX the stencil is the low byte of each Z24S8 word, so a draw
+ * that writes only the stencil (colour and depth writes off), or a clear of
+ * the stencil alone, changes what reading the zeta as A8R8G8B8 gives, and
+ * the converted texture must be made again. GT6's vector font draws its
+ * glyphs that way and then samples the zeta it drew them into. */
+static void stencil_only_draw(u32 write_mask, u32 zpass_op)
+{
+    m(0x0328 /* STENCIL_TEST_ENABLE */, 1u);
+    m(0x032C /* STENCIL_MASK (write) */, write_mask);
+    m(0x0330 /* STENCIL_FUNC */, 0x0207u);          /* ALWAYS */
+    m(0x033C /* OP_FAIL */, 0x1E00u);
+    m(0x0340 /* OP_ZFAIL */, 0x1E00u);
+    m(0x0344 /* OP_ZPASS */, zpass_op);
+    m(M_COLOR_MASK, 0u);
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    m(M_TEX_UNIT + 0x0C, 0u);
+    draw_triangle();
+    m(0x0328, 0u);
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_TEX_UNIT + 0x0C, 0x80000000u);              /* the unit back on */
+}
+
+static void test_stencil_write_changes_zeta_bytes(void)
+{
+    printf("-- a stencil-only draw or clear makes the zeta's A8R8G8B8 bytes again\n");
+    engine_up();
+    rsx_draw_backend be = g_stub_backend;
+    be.depth_as_color = stub_depth_as_color;
+    rsx_draw_engine_set_backend(&be);
+    g_argb_calls = 0; g_argb_fail = 0;
+
+    depth_pass_then_read_ex(256u * 4u, 1);       /* the zeta stays bound */
+    draw_triangle();
+    CHECK(g_argb_calls == 1, "converted once (%d calls)", g_argb_calls);
+    draw_triangle();
+    CHECK(g_argb_calls == 1, "nothing written since: reused (%d calls)", g_argb_calls);
+
+    stencil_only_draw(0xFFu, 0x150Au);            /* INVERT */
+    draw_triangle();
+    CHECK(g_argb_calls == 2, "a stencil-only draw: converted again (%d calls)", g_argb_calls);
+
+    stencil_only_draw(0x00u, 0x150Au);            /* no plane writable */
+    draw_triangle();
+    stencil_only_draw(0xFFu, 0x1E00u);            /* every op KEEP */
+    draw_triangle();
+    CHECK(g_argb_calls == 2, "a draw that cannot write the stencil: reused (%d calls)",
+          g_argb_calls);
+
+    m(M_ZSTENCIL_CLEAR, 0xFFFFFF00u);
+    m(M_CLEAR_BUFFERS, 0x02u);                    /* the stencil alone */
+    draw_triangle();
+    CHECK(g_argb_calls == 3, "a stencil-only clear: converted again (%d calls)", g_argb_calls);
+    engine_down();
+}
+
 /* A depth-writing draw through a 256x256 Z24S8 zeta at `offset`; returns the
  * depth target it was given, or 0. */
 static u32 depth_draw_at(u32 offset)
@@ -2515,6 +2571,7 @@ int main(void)
     test_depth_snapshot_release();
     test_depth_read_as_argb_on_gpu();
     test_z16_read_as_depth16_on_gpu();
+    test_stencil_write_changes_zeta_bytes();
     test_full_tables_evict_the_oldest();
     test_color_read_as_float();
     test_engine_rewrite_reuploads();
diff --git a/tools/test_metal_depth_as_color.py b/tools/test_metal_depth_as_color.py
new file mode 100644
--- /dev/null
+++ b/tools/test_metal_depth_as_color.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+"""Check the Metal backend's depth_as_color against the store through guest memory:
+Z24S8 read as A8R8G8B8 (depth bytes and the stencil byte) and Z16 read as DEPTH16."""
+import pathlib
+import platform
+import subprocess
+import tempfile
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+if platform.system() != "Darwin":
+    print("SKIP: Metal requires macOS")
+    raise SystemExit(0)
+with tempfile.TemporaryDirectory(prefix="metal-depth-as-color-") as tmp:
+    binary = pathlib.Path(tmp) / "test"
+    subprocess.run(["clang", "-fobjc-arc", "-Iinclude", "-Ilibs/video",
+                    "libs/video/tests/test_metal_depth_as_color.m",
+                    "libs/video/rsx_texture_layout.c", "libs/video/rsx_shader_msl.cpp",
+                    "-lc++", "-Wl,-dead_strip",
+                    "-framework", "Metal", "-framework", "Cocoa",
+                    "-framework", "QuartzCore", "-o", str(binary)],
+                   cwd=ROOT, check=True, timeout=120)
+    subprocess.run([str(binary)], check=True, timeout=30)
