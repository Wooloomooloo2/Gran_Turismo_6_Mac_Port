--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -13,6 +13,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include "ps3emu/log_first.h"
+#include "spu_interp.h"         /* spu_dispatch: the interpreter fallback for jobs */
 #ifdef _WIN32
 #include <windows.h>
 #else
@@ -1017,6 +1018,72 @@
 static void* spu_async_thread(void* p) { spu_async_run((spu_async_job*)p); return NULL; }
 #endif
 
+/* SPU_JOB_INTERP=1: a SPURS job binary or workload policy module with no lifted
+ * image runs in the SPU interpreter instead of being dropped. A job gets the
+ * same jm2 staging as a lifted one (spu_run_spurs_job) and enters at LS 0, a
+ * policy module the same kernel context (spu_run_policy_module) and enters at
+ * LS 0xA00, both through spu_dispatch, which hands over to lifted code wherever
+ * some is registered (job modules a job streams in). Every run is reported to
+ * g_spu_job_interp_hook when a port sets one (a port's boot log counts them);
+ * the first 32 job runs and every 10000th are logged too, so the image can be
+ * dumped (SPU_DUMP_MISS) and lifted ahead of time for the next build. Off by
+ * default: a dropped job is what the runtime has always done, and a title whose
+ * chain walker synthesises job completions (SPURS_JOB_SYNTH_EVENTS, cellSpurs.c)
+ * would then see both the job's own events and the made-up ones. */
+void (*g_spu_job_interp_hook)(uint64_t fp, uint32_t size) = 0;
+
+int spu_job_interp_enabled(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("SPU_JOB_INTERP"); v = (e && *e == '1') ? 1 : 0; }
+    return v;
+}
+
+/* Image ids for interpreted images: ones no lifted image uses, so the
+ * interpreted code's lookups never pick another image's functions (lifted ids
+ * are small, or content derived below 0x20000000). Each remembers its
+ * fingerprint and size for the hook. */
+#define SPU_INTERP_IMAGES 64
+static struct { int id; uint64_t fp; uint32_t size; } s_interp_img[SPU_INTERP_IMAGES];
+static unsigned s_interp_img_n;
+static volatile LONG s_interp_img_lock;
+
+int spu_job_interp_image_id(uint64_t fp, uint32_t size)
+{
+    const int id = (int)(0x60000000u | (uint32_t)(fp & 0x0FFFFFFFu));
+    while (InterlockedExchange(&s_interp_img_lock, 1)) Sleep(0);
+    unsigned k = 0;
+    for (; k < s_interp_img_n; k++) if (s_interp_img[k].id == id) break;
+    if (k == s_interp_img_n && s_interp_img_n < SPU_INTERP_IMAGES) {
+        s_interp_img[k].id = id; s_interp_img[k].fp = fp; s_interp_img[k].size = size;
+        s_interp_img_n++;
+    }
+    InterlockedExchange(&s_interp_img_lock, 0);
+    return id;
+}
+
+static void spu_job_interp_note(int image_id)
+{
+    if (!g_spu_job_interp_hook) return;
+    for (unsigned k = 0; k < s_interp_img_n; k++)
+        if (s_interp_img[k].id == image_id) {
+            g_spu_job_interp_hook(s_interp_img[k].fp, s_interp_img[k].size);
+            return;
+        }
+}
+
+static void spu_job_interp_entry(spu_context* ctx)
+{
+    spu_job_interp_note(ctx->image_id);
+    spu_dispatch(ctx, 0);       /* job binaries are loaded and entered at LS 0 */
+}
+
+void spu_policy_interp_entry(spu_context* ctx)
+{
+    spu_job_interp_note(ctx->image_id);
+    spu_dispatch(ctx, 0xA00);   /* policy modules are loaded and entered at LS 0xA00 */
+}
+
 int spu_workload_dispatch_job(const uint8_t* image, uint32_t image_size,
                               uint32_t job_ea, uint32_t job_desc_size)
 {
@@ -1035,7 +1102,8 @@
