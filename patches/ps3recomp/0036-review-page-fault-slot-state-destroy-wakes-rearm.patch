 /* lv2 198: sys_spu_thread_recover_page_fault(u32 id). No SPU thread is ever
diff --git a/tests/test_mmapper_page_fault.c b/tests/test_mmapper_page_fault.c
--- a/tests/test_mmapper_page_fault.c
+++ b/tests/test_mmapper_page_fault.c
@@ -182,6 +182,32 @@ static int64_t receive_into(uint32_t q, uint64_t* out)
     return rc;
 }
 
+
+/* Batch 7 review I-1: the pager's normal order -- map the page, then 57 at
+ * once -- races the host thread's own "page mapped, go on". Whichever wins,
+ * the slot must come free; 100 rounds on a 64-slot table would run out. */
+static uint32_t g_area4, g_q4;
+static volatile uint32_t g_round_addr, g_round_seen;
+static void* host_round(void* arg)
+{
+    (void)arg;
+    g_active_ctx = NULL;
+    __asm__ volatile("" ::: "memory");
+    g_round_seen = *(volatile uint32_t*)vm_to_host(g_round_addr);
+    return NULL;
+}
+static void* ppu_round(void* arg)
+{
+    (void)arg;
+    ppu_context self; memset(&self, 0, sizeof self);
+    self.thread_id = 13;
+    g_active_ctx = &self;
+    __asm__ volatile("" ::: "memory");
+    g_round_seen = *(volatile uint32_t*)vm_to_host(g_round_addr);
+    _exit(0);                             /* reached only if the fault was answered */
+    return NULL;
+}
+
 int main(void)
 {
     setvbuf(stdout, NULL, _IONBF, 0);
@@ -328,6 +354,65 @@ int main(void)
         (void)stray;
     }
 
+    {   /* I-1: 100 host-thread faults, each mapped and recovered at once. */
+        ppu_context c; memset(&c, 0, sizeof c);
+        c.gpr[3] = 0x1000000; c.gpr[4] = 0; c.gpr[5] = 0x10000000; c.gpr[6] = SCRATCH;
+        assert(sys_mmapper_allocate_address(&c) == CELL_OK);
+        g_area4 = rd32(SCRATCH);
+        memset(&c, 0, sizeof c);
+        c.gpr[3] = SCRATCH + 8; c.gpr[4] = 0; c.gpr[5] = 0x777B; c.gpr[6] = 8;
+        assert(sys_event_queue_create(&c) == CELL_OK);
+        g_q4 = rd32(SCRATCH + 8);
+        assert(enable(g_area4, g_q4) == CELL_OK);
+        int good = 0, second_einval = 0;
+        for (int r = 0; r < 100; r++) {
+            g_round_addr = g_area4 + (uint32_t)(r + 1) * 0x10000u + 0x10;
+            g_round_seen = 0xFFFFFFFFu;
+            pthread_t t;
+            pthread_create(&t, NULL, host_round, NULL);
+            uint64_t e[4];
+            if (receive_into(g_q4, e) != CELL_OK) break;
+            uint32_t page = (uint32_t)e[1] & ~0xFFFFu;
+            if (ps3_mm_map(page, ps3_mm_object_create(0x10000)) != CELL_OK) break;
+            *(volatile uint32_t*)vm_to_host(page + 0x10) = 0x1000u + (uint32_t)r;
+            int64_t rc = recover(e[2] & 0xFFFFFFFFu);   /* straight after the map */
+            pthread_join(t, NULL);
+            if (rc == CELL_OK && g_round_seen == 0x1000u + (uint32_t)r) good++;
+            if ((uint32_t)recover(e[2] & 0xFFFFFFFFu) == CELL_EINVAL) second_einval++;
+        }
+        CHECK(good == 100, "I-1: 100 rounds of map-then-57 against a detaching host thread all complete (%d)", good);
+        CHECK(second_einval == 100, "I-1: every slot came free, a second 57 is EINVAL each time (%d)", second_einval);
+    }
+
+    {   /* M-2: a destroy with a PPU thread's event still queued stops the process;
+         * afterwards 327 can arm the area again. */
+        fflush(stdout);
+        pid_t pid = fork();
+        if (pid == 0) {
+            g_round_addr = g_area4 + 0x800010u;
+            pthread_t t;
+            pthread_create(&t, NULL, ppu_round, NULL);
+            usleep(50000);                /* its event is queued, nobody receives it */
+            ppu_context c; memset(&c, 0, sizeof c);
+            c.gpr[3] = g_q4; c.gpr[4] = 0;
+            sys_event_queue_destroy(&c);
+            pthread_join(t, NULL);
+            _exit(0);
+        }
+        int st = 0;
+        waitpid(pid, &st, 0);
+        CHECK(WIFSIGNALED(st) && WTERMSIG(st) == SIGABRT, "M-2: the waiting thread takes the abort path (status 0x%X)", st);
+        ppu_context c; memset(&c, 0, sizeof c);
+        c.gpr[3] = g_q4; c.gpr[4] = 0;
+        CHECK(sys_event_queue_destroy(&c) == CELL_OK, "M-2: the area's queue is destroyed");
+        memset(&c, 0, sizeof c);
+        c.gpr[3] = SCRATCH + 8; c.gpr[4] = 0; c.gpr[5] = 0x777C; c.gpr[6] = 8;
+        assert(sys_event_queue_create(&c) == CELL_OK);
+        uint32_t qn = rd32(SCRATCH + 8);
+        CHECK(enable(g_area4, qn) == CELL_OK, "M-2: 327 arms the disarmed area again with a new queue");
+        CHECK((uint32_t)enable(g_area4, qn) == CELL_EBUSY, "M-2: and a second 327 for it is EBUSY");
+    }
