+/* The SPURS workload flag, cellSpursInitializeWithAttribute2 and cellSpursDestroyTaskset2, against the real
+ * libs/spurs/cellSpurs.c with a manufactured policy module (no game code).
+ *
+ * The workload flag is how the PPU asks the kernel to run one chosen workload: _cellSpursWorkloadFlagReceiver2
+ * names the receiver (instance byte 0x77), cellSpursGetWorkloadFlag hands out the address of the flag block
+ * (instance +0x60, the flag word at +0x6C), the PPU stores 0 into the flag, and the kernel then selects the
+ * receiver and pulls the flag back to all ones. Behaviour and error codes follow RPCS3. Run by
+ * tools/test_spurs_workload_flag.py. */
+#define spu_workload_dispatch_async fixture_unbounded_dispatch
+#include "../libs/spurs/cellSpurs.c"
+#undef spu_workload_dispatch_async
+#include <assert.h>
+#include <stdatomic.h>
+#include "../runtime/spu/spu_coherency.h"
+
+void spu_indirect_branch(spu_context*);
+uint8_t* vm_base;
+uint32_t ppu_vm_size = 0x20000;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi, g_barrier_sync_watch;
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+unsigned long long ps3_ms_now(void) { LARGE_INTEGER n, f; QueryPerformanceCounter(&n); QueryPerformanceFrequency(&f); return n.QuadPart * 1000 / f.QuadPart; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+void sys_event_queue_cancel_by_id(u32 id) { (void)id; }
+void sys_event_queue_uncancel_by_id(u32 id) { (void)id; }
+int fixture_unbounded_dispatch(const uint8_t* pm, uint32_t size, uint32_t data) { (void)pm; (void)size; (void)data; return 0; }
+
+static int fails;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+#define PM_NULL_POINTER 0x80410811u
+#define PM_ALIGN        0x80410810u
+#define PM_INVAL        0x80410802u
+#define PM_SRCH         0x80410805u
+#define PM_PERM         0x80410809u
+#define PM_BUSY         0x8041080Au
+#define PM_STAT         0x8041080Fu
+
+static atomic_uint runs;
+static void counting_policy(spu_context* c)
+{
+    /* Hold a reservation on the instance's first line, as a policy module that reads it with GETLLAR does: the
+     * kernel's flag update must then not take the lock-line lock a second time (it deadlocked, through
+     * vm_write32's coherence path, before the flag was written with plain stores). */
+    spu_lockline_lock(); spu_coh_reserve(c, spu_ls_read32(c, 0x1C4)); spu_lockline_unlock();
+    atomic_fetch_add(&runs, 1);
+    c->pc = SPURS_PM_EXIT_TO_KERNEL_LS;
+    spu_indirect_branch(c);
+}
+
+#define S1   0x1000u   /* a CellSpurs */
+#define S2   0x4000u   /* a CellSpurs2 (8 KB) */
+#define ATTR 0x8100u
+#define OUT  0x8200u
+
+static void finalize(u32 ea)
+{
+    for (unsigned i = 0; i < 3000; i++) {
+        s32 rc = cellSpursFinalize((CellSpurs*)(uintptr_t)ea);
+        if (!rc) return;
+        assert((u32)rc == CELL_SPURS_CORE_ERROR_BUSY);
+        Sleep(1);
+    }
+    assert(!"finalize");
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    vm_base = calloc(1, ppu_vm_size);
+    assert(vm_base);
+    memset(vm_base + 0x9000, 0x5A, 16);
+    spu_workload_register_img(spu_workload_fingerprint(vm_base + 0x9000, 16), counting_policy, 90,
+                              "manufactured workload flag fixture");
+
+    /* --- cellSpursInitializeWithAttribute2 --- */
+    assert(_cellSpursAttributeInitialize((CellSpursAttribute*)(uintptr_t)ATTR, 2, 0x400000, 1, 100, 1000, 0) == 0);
+    CHECK((u32)cellSpursInitializeWithAttribute2(NULL, (CellSpursAttribute*)(uintptr_t)ATTR) ==
+          CELL_SPURS_CORE_ERROR_NULL_POINTER, "InitializeWithAttribute2: NULL spurs is NULL_POINTER");
+    CHECK((u32)cellSpursInitializeWithAttribute2((CellSpurs*)(uintptr_t)S2, NULL) ==
+          CELL_SPURS_CORE_ERROR_NULL_POINTER, "InitializeWithAttribute2: NULL attribute is NULL_POINTER");
+    CHECK((u32)cellSpursInitializeWithAttribute2((CellSpurs*)(uintptr_t)S2, (CellSpursAttribute*)(uintptr_t)(ATTR + 4)) ==
+          CELL_SPURS_CORE_ERROR_ALIGN, "InitializeWithAttribute2: an attribute off 8 bytes is ALIGN");
+    CHECK((u32)cellSpursInitializeWithAttribute2((CellSpurs*)(uintptr_t)(S2 + 0x40), (CellSpursAttribute*)(uintptr_t)ATTR) ==
+          CELL_SPURS_CORE_ERROR_ALIGN, "InitializeWithAttribute2: a spurs off 128 bytes is ALIGN");
+    memset(vm_base + S2, 0xCC, 0x2000);
+    CHECK(cellSpursInitializeWithAttribute2((CellSpurs*)(uintptr_t)S2, (CellSpursAttribute*)(uintptr_t)ATTR) == 0,
+          "InitializeWithAttribute2 initialises the instance");
+    CHECK(spurs_inst_find(S2) != NULL, "the instance is live (its kernel runs)");
+    int clear = 1;
+    for (u32 o = 0; o < 0x2000; o++) clear &= vm_base[S2 + o] != 0xCC;
+    CHECK(clear, "all 8 KB of the CellSpurs2 are initialised");
+    CHECK((vm_read8(S2 + 0x74) & 0x40) != 0, "flags1 has SF1_32_WORKLOADS (0x%02X)", vm_read8(S2 + 0x74));
+    CHECK(vm_read32(S2 + 0x6C) == 0xFFFFFFFFu && vm_read8(S2 + 0x77) == 0xFF,
+          "workload flag all ones, no receiver (flag 0x%08X, receiver 0x%02X)", vm_read32(S2 + 0x6C), vm_read8(S2 + 0x77));
+    finalize(S2);
+
+    /* --- cellSpursGetWorkloadFlag --- */
+    assert(cellSpursInitialize((CellSpurs*)(uintptr_t)S1, 1, 0, 0, 0) == 0);
+    CHECK(vm_read32(S1 + 0x6C) == 0xFFFFFFFFu && vm_read8(S1 + 0x77) == 0xFF,
+          "cellSpursInitialize: flag all ones, no receiver (flag 0x%08X, receiver 0x%02X)",
+          vm_read32(S1 + 0x6C), vm_read8(S1 + 0x77));
+    CHECK((u32)cellSpursGetWorkloadFlag(NULL, (u32*)(uintptr_t)OUT) == PM_NULL_POINTER, "GetWorkloadFlag: NULL spurs");
+    CHECK((u32)cellSpursGetWorkloadFlag((CellSpurs*)(uintptr_t)S1, NULL) == PM_NULL_POINTER, "GetWorkloadFlag: NULL flag");
+    CHECK((u32)cellSpursGetWorkloadFlag((CellSpurs*)(uintptr_t)(S1 + 8), (u32*)(uintptr_t)OUT) == PM_ALIGN,
+          "GetWorkloadFlag: unaligned spurs is ALIGN");
+    vm_write32(OUT, 0xDEADBEEFu);
+    CHECK(cellSpursGetWorkloadFlag((CellSpurs*)(uintptr_t)S1, (u32*)(uintptr_t)OUT) == 0 && vm_read32(OUT) == S1 + 0x60,
+          "GetWorkloadFlag writes the flag block's address, spurs+0x60 (got 0x%08X)", vm_read32(OUT));
+
+    /* --- _cellSpursWorkloadFlagReceiver2 --- */
+    CHECK((u32)_cellSpursWorkloadFlagReceiver2(NULL, 0, 1, 0) == PM_NULL_POINTER, "FlagReceiver2: NULL spurs");
+    CHECK((u32)_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)(S1 + 8), 0, 1, 0) == PM_ALIGN,
+          "FlagReceiver2: unaligned spurs");
+    CHECK((u32)_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)S1, 16, 1, 0) == PM_INVAL,
+          "FlagReceiver2: wid 16 on a 16-workload instance is INVAL");
+    CHECK((u32)_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)S1, 0, 1, 0) == PM_SRCH,
+          "FlagReceiver2: a workload not added is SRCH");
+    /* the workload: never kicked by a ready count, so only probes or the flag run it */
+    assert(cellSpursAddWorkload((CellSpurs*)(uintptr_t)S1, (u32*)(uintptr_t)OUT, (void*)0x9000, 16, 0, NULL, 1, 1) == 0);
+    u32 wid = vm_read32(OUT);
+    CHECK(_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)S1, wid, 1, 0) == 0 && vm_read8(S1 + 0x77) == wid,
+          "FlagReceiver2 set: the workload is the receiver (0x%02X)", vm_read8(S1 + 0x77));
+    CHECK((u32)_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)S1, wid, 1, 0) == PM_BUSY,
+          "FlagReceiver2 set again while a receiver is set is BUSY");
+    CHECK((u32)_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)S1, wid + 1, 0, 0) == PM_PERM ||
+          (u32)_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)S1, wid + 1, 0, 0) == PM_SRCH,
+          "FlagReceiver2 unset by another workload is refused");
+
+    /* The PPU stores 0 into the flag: the kernel selects the receiver and pulls the flag back to all ones. */
+    vm_write32(S1 + 0x6C, 0);
+    int reset = 0;
+    for (unsigned i = 0; i < 3000 && !reset; i++) { reset = vm_read32(S1 + 0x6C) == 0xFFFFFFFFu; if (!reset) Sleep(1); }
+    CHECK(reset, "a flag stored 0 is taken by the kernel for the receiver (flag 0x%08X, %u run(s))",
+          vm_read32(S1 + 0x6C), atomic_load(&runs));
+    CHECK(atomic_load(&runs) >= 1, "the receiver ran");
+
+    vm_write32(S1 + 0xD6C, 1);   /* an exception is pending */
+    CHECK((u32)_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)S1, wid, 0, 0) == PM_STAT,
+          "FlagReceiver2 with an exception pending is STAT");
+    vm_write32(S1 + 0xD6C, 0);
+    CHECK(_cellSpursWorkloadFlagReceiver2((CellSpurs*)(uintptr_t)S1, wid, 0, 0) == 0 && vm_read8(S1 + 0x77) == 0xFF,
+          "FlagReceiver2 unset by the receiver clears it");
+    vm_write8(S1 + 0x80 + wid, 3);
+    finalize(S1);
+
+    /* --- cellSpursDestroyTaskset2 --- */
+    CHECK((u32)cellSpursDestroyTaskset2(NULL) == CELL_SPURS_TASK_ERROR_NULL_POINTER, "DestroyTaskset2: NULL");
+    CHECK((u32)cellSpursDestroyTaskset2((void*)(uintptr_t)0x6040) == CELL_SPURS_TASK_ERROR_ALIGN,
+          "DestroyTaskset2: unaligned taskset is ALIGN");
+    CHECK(cellSpursDestroyTaskset2((void*)(uintptr_t)0x6000) == 0, "DestroyTaskset2 on an aligned taskset");
+
+    free(vm_base);
+    if (fails) { printf("%d check(s) failed\n", fails); return 1; }
+    puts("PASS: SPURS workload flag, InitializeWithAttribute2, DestroyTaskset2");
+    return 0;
+}
