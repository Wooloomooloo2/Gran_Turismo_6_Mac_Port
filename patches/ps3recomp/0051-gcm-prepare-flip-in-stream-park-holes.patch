+/* A resync out of a main-memory command block (the jump-park one) leaves the
+ * rest of that block unread, and the ring sweep above never looks there.
+ * Walk the block's remainder after the park as a command stream and replay
+ * what a title waits on: fences (0x0050), NV406E semaphore releases, the
+ * NV4097 back-end and texture-read releases, and prepare-flip commands. It
+ * stops at anything that is not a method header, a CALL or RETURN, or a JUMP
+ * out of the block, and after 64 KB. GT6 run 20261029-034740 stopped for good
+ * after two such resyncs: its frame loop waited on a sync write in the tail. */
+static void gcm_fifo_sweep_block_tail(u32 from)
+{
+    static rsx_state s_tail_state;   /* the sync methods do not touch it */
+    const u32 lim = from + 0x10000u;
+    unsigned fences = 0, labels = 0, flips = 0;
+    for (u32 io = from; io + 4 <= lim; ) {
+        const u32 ea = gcm_io2ea(io); if (!ea) break;
+        const u32 w = vm_read32(ea), type = w >> 29;
+        if (w == 0) { io += 4; continue; }                              /* NOP */
+        if ((w & 0xE0000003u) == 0x20000000u || (w & 3u) == 1u) {       /* JUMP */
+            const u32 tgt = ((w & 3u) == 1u) ? (w & ~3u) : (w & 0x1FFFFFFCu);
+            if (tgt == io) { io += 4; continue; }                       /* another hole */
+            if (tgt > io && tgt < lim) { io = tgt; continue; }
+            break;
+        }
+        if (type != 0 && type != 2) break;
+        const u32 count = (w >> 18) & 0x7FFu, method = w & 0x1FFCu, subch = (w >> 13) & 7u;
+        if (!count) break;
+        if ((w & ~0x40000000u) == GCM_PREPARE_FLIP_HDR) {
+            const u32 dea = gcm_io2ea(io + 4);
+            if (dea) { gcm_prepared_reached(vm_read32(dea)); flips++; }
+            io += 8;
+            continue;
+        }
+        for (u32 i = 0; i < count; i++) {
+            const u32 dea = gcm_io2ea(io + 4 + i * 4); if (!dea) break;
+            const u32 m = (type == 0) ? method + i * 4 : method, v = vm_read32(dea);
+            if (subch != 0) continue;
+            if (m == 0x50u) { gcm_ref_push_at(v, io); fences++; }
+            else if (m == 0x64u) s_sema_offset = v;
+            else if (m == 0x6Cu) {
+                atomic_thread_fence(memory_order_release);
+                vm_write32(GCM_LABEL_GUEST_BASE + (s_sema_offset & 0xFFFFu), v);
+                labels++;
+            } else if (m == 0x01A4u || m == 0x1D6Cu || m == 0x1D70u || m == 0x1D74u) {
+                rsx_process_method(&s_tail_state, m, v);
+                labels += (m == 0x1D70u || m == 0x1D74u);
+            }
+        }
+        io += 4 + count * 4;
+    }
+    { static int n = 0; if (PS3_LOG_FIRST(n, 8))
+        fprintf(stderr, "[cellGcmSys] resync swept the abandoned block from 0x%08X: %u"
+                " fence(s), %u label write(s), %u prepared flip(s)%c", from, fences, labels, flips, 10); }
+}
