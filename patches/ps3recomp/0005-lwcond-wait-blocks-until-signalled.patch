+#!/usr/bin/env python3
+"""sys_lwcond_wait blocks until a signal, as lv2's does (runtime/ppu/ppu_sysprx.cpp).
+
+The wait used to be a 1 ms poll with no-op signals: every wait was a spurious
+wakeup. A title whose wait has no predicate loop then ran on state nobody had
+published (Gran Turismo 6's event object woke its file worker with no request
+posted, and the worker wrote through the NULL request).
+
+Builds the real lwcond waiter queue, sys_lwcond_signal / _signal_all /
+_signal_to and sys_lwcond_wait (pulled verbatim out of ppu_sysprx.cpp) over
+stubbed guest memory and a host lwmutex, and checks with real threads:
+  - a wait with nobody signalling stays asleep (no spurious return) and wakes
+    on sys_lwcond_signal with CELL_OK, holding the lwmutex again;
+  - a timed wait with no signal answers CELL_ETIMEDOUT after its timeout,
+    holding the lwmutex again;
+  - a signal with no waiter is lost (CELL_OK; a later timed wait still times out);
+  - waiting without holding the lwmutex is CELL_EPERM;
+  - signal_to a thread that is not waiting is CELL_EPERM, and to a waiting one
+    wakes exactly it;
+  - signal_all wakes every waiter;
+  - a signal wakes the highest-priority waiter under SYS_SYNC_PRIORITY (the
+    oldest among equals) and the oldest under SYS_SYNC_FIFO, the paired
+    lwmutex's protocol;
+  - destroying an lwcond a thread sleeps on is CELL_EBUSY, CELL_OK after;
+  - signal_to a thread that does not exist is CELL_ESRCH.
+"""
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def extract(src, name):
+    m = re.search(r'static void %s\(ppu_context\* ctx\)\s*\{' % name, src)
+    assert m, name + ' not found'
+    i, depth = m.end(), 1
+    while depth:
+        depth += {'{': 1, '}': -1}.get(src[i], 0)
+        i += 1
+    return src[m.start():i]
+
+
+def extract_waiters(src):
+    a = src.index('/* lwcond-waiters: begin */')
+    b = src.index('/* lwcond-waiters: end */')
+    return src[a:b]
+
+
+HARNESS = r'''
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+static uint8_t mem[0x10000];
+static std::mutex mem_mu;
+static void vm_write32(uint32_t a, uint32_t v) { std::lock_guard<std::mutex> g(mem_mu); for (int i = 0; i < 4; i++) mem[a + i] = (uint8_t)(v >> (24 - 8 * i)); }
+static uint32_t vm_read32(uint32_t a) { std::lock_guard<std::mutex> g(mem_mu); return (uint32_t)mem[a] << 24 | mem[a + 1] << 16 | mem[a + 2] << 8 | mem[a + 3]; }
+struct ppu_context { uint64_t gpr[32]; uint32_t thread_id; };
+#define LWM_OWNER 0x00
+#define LWM_ATTR  0x08
+#define LWM_RECUR 0x0C
+/* Threads 1-99 exist; priority 1000 unless set in prios[]. */
+static int32_t prios[100];
+extern "C" int ppu_thread_query(uint64_t tid, int32_t* prio) { if (tid == 0 || tid >= 100) return 0; if (prio) *prio = prios[tid] ? prios[tid] : 1000; return 1; }
+#define LWM_SELF(ctx) ((ctx)->thread_id ? (ctx)->thread_id : 0x7FFFFFFEu)
+/* A host binary lock standing in for the runtime's lwmutex slot. */
+struct LwmSlot { std::mutex m; std::condition_variable cv; bool held = false; };
+static LwmSlot g_slot;
+static struct LwmSlot* lwm_slot(uint32_t a) { return a ? &g_slot : nullptr; }
+static int lwm_acquire(struct LwmSlot* s, uint64_t) { std::unique_lock<std::mutex> l(s->m); s->cv.wait(l, [s] { return !s->held; }); s->held = true; return 1; }
+static void lwm_release(struct LwmSlot* s) { { std::lock_guard<std::mutex> l(s->m); s->held = false; } s->cv.notify_all(); }
+static void ppu_thread_note_block(uint64_t) {}
+%s
+%s
+%s
+%s
+%s
+%s
+static const uint32_t LWC = 0x1000, MTX = 0x2000;
+static void lock(uint32_t tid) { lwm_acquire(&g_slot, 0); vm_write32(MTX + LWM_OWNER, tid); vm_write32(MTX + LWM_RECUR, 1); }
+static void unlock() { vm_write32(MTX + LWM_OWNER, 0); vm_write32(MTX + LWM_RECUR, 0); lwm_release(&g_slot); }
+static uint32_t wait(uint32_t tid, uint64_t timeout) { ppu_context c = {}; c.thread_id = tid; c.gpr[3] = LWC; c.gpr[4] = timeout; sys_lwcond_wait(&c); return (uint32_t)c.gpr[3]; }
+static uint32_t sig(uint32_t tid) { lock(tid); ppu_context c = {}; c.thread_id = tid; c.gpr[3] = LWC; sys_lwcond_signal(&c); unlock(); return (uint32_t)c.gpr[3]; }
+static uint32_t sig_all(uint32_t tid) { lock(tid); ppu_context c = {}; c.thread_id = tid; c.gpr[3] = LWC; sys_lwcond_signal_all(&c); unlock(); return (uint32_t)c.gpr[3]; }
+static uint32_t sig_to(uint32_t tid, uint32_t to) { lock(tid); ppu_context c = {}; c.thread_id = tid; c.gpr[3] = LWC; c.gpr[4] = to; sys_lwcond_signal_to(&c); unlock(); return (uint32_t)c.gpr[3]; }
+static uint32_t destroy() { ppu_context c = {}; c.gpr[3] = LWC; sys_lwcond_destroy(&c); return (uint32_t)c.gpr[3]; }
+static int fails = 0;
+#define CHECK(c, ...) do { const bool ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); printf("\n"); if (!ok_) fails++; } while (0)
+static void ms(int n) { std::this_thread::sleep_for(std::chrono::milliseconds(n)); }
+int main() {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    { ppu_context c = {}; c.gpr[3] = LWC; c.gpr[4] = MTX; sys_lwcond_create(&c); }
+
+    /* 1. no spurious return; a signal wakes it holding the lwmutex */
+    std::atomic<int> done{0}; std::atomic<uint32_t> rc{0xFFFFFFFFu}, owner{0};
+    std::thread a([&] { lock(7); rc = wait(7, 0); owner = vm_read32(MTX + LWM_OWNER); unlock(); done = 1; });
+    ms(100);
+    CHECK(!done, "a wait nobody signals is still asleep after 100 ms");
+    CHECK(sig(1) == 0, "sys_lwcond_signal returns CELL_OK");
+    a.join();
+    CHECK(rc == 0 && owner == 7, "the signalled wait returns CELL_OK (0x%%X) holding the lwmutex (owner %%u)", (unsigned)rc, (unsigned)owner);
+
+    /* 2. timed wait */
+    lock(3);
+    auto t0 = std::chrono::steady_clock::now();
+    uint32_t r = wait(3, 30000);
+    long el = (long)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count();
+    CHECK(r == 0x8001000Bu && el >= 25, "a 30 ms wait with no signal is CELL_ETIMEDOUT (0x%%X) after %%ld ms", r, el);
+    CHECK(vm_read32(MTX + LWM_OWNER) == 3 && vm_read32(MTX + LWM_RECUR) == 1, "and holds the lwmutex again");
+    unlock();
+
+    /* 3. a signal with no waiter is lost */
+    CHECK(sig(1) == 0, "sys_lwcond_signal with no waiter returns CELL_OK");
+    lock(3); r = wait(3, 20000); unlock();
+    CHECK(r == 0x8001000Bu, "and is lost: the next timed wait still times out (0x%%X)", r);
+
+    /* 4. waiting without the lwmutex */
+    CHECK(wait(4, 1000) == 0x80010009u, "waiting without holding the lwmutex is CELL_EPERM");
+
+    /* 5. signal_to */
+    CHECK(sig_to(1, 9) == 0x80010009u, "signal_to a thread that is not waiting is CELL_EPERM");
+    std::atomic<uint32_t> r8{1}, r9{1}; std::atomic<int> d8{0}, d9{0};
+    std::thread t8([&] { lock(8); r8 = wait(8, 0); unlock(); d8 = 1; });
+    std::thread t9([&] { lock(9); r9 = wait(9, 0); unlock(); d9 = 1; });
+    ms(100);
+    CHECK(sig_to(1, 9) == 0, "signal_to a waiting thread returns CELL_OK");
+    t9.join(); ms(50);
+    CHECK(d9 && r9 == 0 && !d8, "it wakes that thread only");
+    CHECK(sig(1) == 0, "a plain signal wakes the other");
+    t8.join();
+
+    /* 6. signal_all */
+    std::atomic<int> woke{0};
+    std::vector<std::thread> ts;
+    for (uint32_t i = 0; i < 3; i++) ts.emplace_back([&, i] { lock(20 + i); if (wait(20 + i, 0) == 0) woke++; unlock(); });
+    ms(100);
+    CHECK(woke == 0, "three waiters asleep");
+    sig_all(1);
+    for (auto& t : ts) t.join();
+    CHECK(woke == 3, "signal_all wakes all three (%%d)", (int)woke);
+
+    /* 7. wake order: the lwmutex protocol */
+    std::mutex om; std::vector<uint32_t> order;
+    auto waiter = [&](uint32_t tid) { lock(tid); wait(tid, 0); { std::lock_guard<std::mutex> g(om); order.push_back(tid); } unlock(); };
+    auto run_order = [&](uint32_t attr, std::vector<uint32_t> tids) {
+        vm_write32(MTX + LWM_ATTR, attr);
+        order.clear();
+        std::vector<std::thread> w;
+        for (uint32_t t : tids) { w.emplace_back(waiter, t); ms(50); }   /* queued in this order */
+        for (size_t i = 0; i < tids.size(); i++) { sig(1); ms(50); }
+        for (auto& t : w) t.join();
+        return order;
+    };
+    prios[30] = 2000; prios[31] = 500; prios[32] = 500; prios[33] = 100;
+    auto o = run_order(0x22, {30, 31, 32});   /* SYS_SYNC_PRIORITY, recursive */
+    CHECK(o == std::vector<uint32_t>({31, 32, 30}), "SYS_SYNC_PRIORITY wakes the highest priority first, the oldest among equals (%%u %%u %%u)", o[0], o[1], o[2]);
+    o = run_order(0x01, {30, 33, 31});        /* SYS_SYNC_FIFO */
+    CHECK(o == std::vector<uint32_t>({30, 33, 31}), "SYS_SYNC_FIFO wakes the oldest first (%%u %%u %%u)", o[0], o[1], o[2]);
+    o = run_order(0x04, {30, 33});            /* SYS_SYNC_RETRY: priority for an lwcond */
+    CHECK(o == std::vector<uint32_t>({33, 30}), "SYS_SYNC_RETRY wakes by priority (%%u %%u)", o[0], o[1]);
+
+    /* 8. destroy with a waiter */
+    std::thread td([&] { lock(50); wait(50, 0); unlock(); });
+    ms(100);
+    CHECK(destroy() == 0x8001000Au, "destroying an lwcond a thread sleeps on is CELL_EBUSY");
+    sig(1); td.join();
+    CHECK(destroy() == 0, "and CELL_OK once nobody waits");
+
+    /* 9. signal_to a thread that does not exist */
+    CHECK(sig_to(1, 200) == 0x80010005u, "signal_to a thread that does not exist is CELL_ESRCH");
+    printf("%%s (%%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
