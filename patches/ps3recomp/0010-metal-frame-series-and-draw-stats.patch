+/* PS3RECOMP_METAL_FRAME_DIR / _EVERY / _MAX and PS3RECOMP_DRAW_STATS: the
+ * numbered frame series and one statistics line per present
+ * (rsx_frame_series.h). The counts are the draw engine's for the frame being
+ * presented. With neither variable set this costs one test. */
+static rsx_frame_series s_series;
+static int s_series_ready;
+
+static void eng_series_present(id<MTLTexture> src)
+{
+    if (!s_series_ready) { rsx_fs_init_from_env(&s_series); s_series_ready = 1; }
+    if (!s_series.dir[0] && !s_series.stats) return;
+    u32 draws = 0, clears = 0;
+    rsx_draw_engine_frame_counts(&draws, &clears);
+    int dump = 0;
+    const unsigned n = rsx_fs_present(&s_series, draws, clears, &dump);
+    if (!dump || !src) return;
+    size_t w, h;
+    int bgra;
+    unsigned char* rgba = eng_read_frame(src, &w, &h, &bgra);
+    if (!rgba) return;
+    rsx_fs_dump(&s_series, n, rgba, w, h, bgra);
+    free(rgba);
+}
