     CHECK(ctx.gpr[4]._u32[0] == 0 && ctx.gpr[3]._u32[0] == 1, "a pending event outside the mask is not taken");
 
-    setup(0, 1, 0x2, 0x2);          /* LS 0 holds no branch */
+    setup(il(6, 9), 1, 0x2, 0x2);   /* LS 0: il r6,9 ; LS 4: br to the handler */
+    be32(ctx.ls + 4, (0x064u << 23) | ((((0x200u - 4u) >> 2) & 0xFFFFu) << 7));
     spu_interp_run(&ctx, 0x1000);
-    CHECK(ctx.gpr[4]._u32[0] == 0 && ctx.gpr[3]._u32[0] == 1, "no branch at LS 0: not taken");
+    CHECK(ctx.gpr[6]._u32[0] == 9 && ctx.gpr[4]._u32[0] == 7 && ctx.gpr[3]._u32[0] == 1 && ctx.srr0 == 0x1000,
+          "no branch at LS 0: executed from LS 0, then the handler, then back (r6=%u r4=%u srr0=0x%X)",
+          ctx.gpr[6]._u32[0], ctx.gpr[4]._u32[0], ctx.srr0);
 
     if (fails) { printf("%d check(s) failed\n", fails); return 1; }
     puts("test_spu_interp_takes_interrupt: OK");
diff --git a/tests/test_mmapper_page_fault.c b/tests/test_mmapper_page_fault.c
--- a/tests/test_mmapper_page_fault.c
+++ b/tests/test_mmapper_page_fault.c
@@ -206,6 +206,21 @@
     g_round_seen = *(volatile uint32_t*)vm_to_host(g_round_addr);
     _exit(0);                             /* reached only if the fault was answered */
     return NULL;
+}
+
+/* Batch 8 review I-1, forced: the hook runs inside 57 at the window under
+ * test; it maps the page and waits until the host thread has detached (it
+ * returns from its fault only after the WAITING to DETACHED CAS). */
+static int g_hook_where = -1, g_hook_fired;
+static pthread_t g_hook_thread;
+static uint32_t g_hook_page;
+static void hook_detach_now(int where)
+{
+    if (where != g_hook_where || g_hook_fired) return;
+    g_hook_fired = 1;
+    ps3_mm_map(g_hook_page, ps3_mm_object_create(0x10000));
+    *(volatile uint32_t*)vm_to_host(g_hook_page + 0x10) = 0xD00Du;
+    pthread_join(g_hook_thread, NULL);
 }
 
 int main(void)
@@ -382,6 +397,27 @@
         }
         CHECK(good == 100, "I-1: 100 rounds of map-then-57 against a detaching host thread all complete (%d)", good);
         CHECK(second_einval == 100, "I-1: every slot came free, a second 57 is EINVAL each time (%d)", second_einval);
+    }
+
+    {   /* Batch 8 review I-1: the host thread detaches (0) after 57's first scan
+         * passed its WAITING slot, (1) after the second scan read WAITING but
+         * before its CAS. Either way 57 answers OK and the slot comes free. */
+        for (int where = 0; where < 2; where++) {
+            g_hook_page = g_area4 + 0x700000u + (uint32_t)where * 0x10000u;
+            g_round_addr = g_hook_page + 0x10;
+            g_round_seen = 0xFFFFFFFFu;
+            g_hook_where = where; g_hook_fired = 0;
+            pthread_create(&g_hook_thread, NULL, host_round, NULL);
+            uint64_t e[4];
+            if (receive_into(g_q4, e) != CELL_OK) { CHECK(0, "I-1 forced: event received"); break; }
+            ps3_pf_test_57_hook = hook_detach_now;
+            int64_t rc = recover(e[2] & 0xFFFFFFFFu);
+            ps3_pf_test_57_hook = NULL;
+            CHECK(g_hook_fired && rc == CELL_OK && g_round_seen == 0xD00Du,
+                  "I-1 forced (%s): 57 answers OK for a slot that detached in the window (rc=0x%llX seen=0x%X)",
+                  where ? "between read and CAS" : "between the scans", (unsigned long long)rc, g_round_seen);
+            CHECK((uint32_t)recover(e[2] & 0xFFFFFFFFu) == CELL_EINVAL, "I-1 forced (%d): and freed the slot", where);
+        }
     }
 
     {   /* M-2: a destroy with a PPU thread's event still queued stops the process;
