+def w_lis(rt, si):         return w_addis(rt, 0, si)
+def w_addi(rt, ra, si):    return (14 << 26) | (rt << 21) | (ra << 16) | (si & 0xFFFF)
+def w_subf(rt, ra, rb):    return (31 << 26) | (rt << 21) | (ra << 16) | (rb << 11) | (40 << 1)
+
+
+def test_const_base_subtracted():
+    """A memset that jumps BACKWARD from a constant end into its unrolled run:
+
+        lis r8,1 ; addi r8,r8,0x20 ; subf r8,r5,r8 ; mtctr r8 ; bctr
+        0x10014: stb r4,2(r6) ; stb r4,1(r6) ; stb r4,0(r6)
+        0x10020: blr
+
+    `subf r8,r5,r8` is r8 - r5, so the landing sites are the base and every
+    word before it back to the dispatching bctr (Gran Turismo 6's memset
+    func_00A8DE98 has three of these). Before, none was found and every short
+    memset lifted to an unresolved indirect call that stored nothing.
+    """
+    base = TEXT_LO + 0x20
+    words = [w_lis(8, 1), w_addi(8, 8, 0x20), w_subf(8, 5, 8), w_mtctr(8), w_bctr()]
+    mem = {TEXT_LO + 4 * i: w for i, w in enumerate(words)}
+    for k, d in enumerate((2, 1, 0)):
+        mem[TEXT_LO + 0x14 + 4 * k] = w_stb(4, 6, d)
+    mem[base] = w_blr()
+    got = discover(words, mem)
+    check("subtracted constant-base computed jump", got,
+          [TEXT_LO + 0x14, TEXT_LO + 0x18, TEXT_LO + 0x1C, base])
+
+
+def test_const_base_subtracted_wrong_way():
+    """`subf r8,r8,r5` is r5 - r8: the constant is the subtrahend, so r8 ends
+    up holding length minus base, not an address next to the dispatcher. Not
+    the idiom: no landing sites."""
+    base = TEXT_LO + 0x20
+    words = [w_lis(8, 1), w_addi(8, 8, 0x20), w_subf(8, 8, 5), w_mtctr(8), w_bctr()]
+    mem = {TEXT_LO + 4 * i: w for i, w in enumerate(words)}
+    for k, d in enumerate((2, 1, 0)):
+        mem[TEXT_LO + 0x14 + 4 * k] = w_stb(4, 6, d)
+    mem[base] = w_blr()
+    check("subf with the constant as subtrahend is not a constant-base jump",
+          discover(words, mem), None)
+
+
+def w_stb(rs, ra, d):      return (38 << 26) | (rs << 21) | (ra << 16) | (d & 0xFFFF)
+
+
