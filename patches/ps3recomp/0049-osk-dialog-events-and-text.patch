-enum {
-    OSKIF_O_MESSAGE = 0, OSKIF_O_INIT_TEXT = 4, OSKIF_O_LIMIT_LENGTH = 8,
-    OSKRET_O_RESULT = 0, OSKRET_O_NUMCHARS = 4, OSKRET_O_PRESULTSTRING = 8
-};
-
-/* Copy a NUL-terminated big-endian UTF-16 string out of guest memory. */
-static u32 osk_guest_utf16(u32 ea, CellOskDialogChar* dst, u32 max)
+/* The n-th (0-based) comma-separated entry of PS3_OSK_TEXT into s_text, at
+ * most s_limit characters; 0 when there is none (the initial text stays). */
+static int osk_scripted_text(unsigned n)
 {
-    u32 n = 0;
-    if (!ea)
-        return 0;
-    while (n < max) {
-        u16 c = vm_read16(ea + n * 2);
-        if (!c)
-            break;
-        dst[n++] = c;
+    const char* list = getenv("PS3_OSK_TEXT");
+    if (!list || !*list) return 0;
+    const char* p = list;
+    for (unsigned i = 0; i < n; i++) {
+        p = strchr(p, ',');
+        if (!p) return 0;
+        p++;
     }
-    dst[n] = 0;
-    return n;
+    u32 k = 0;
+    for (; p[k] && p[k] != ',' && k < s_limit && k < CELL_OSKDIALOG_STRING_SIZE - 1; k++)
+        s_text[k] = (u16)(unsigned char)p[k];
+    s_text[k] = 0;
+    return 1;
+}
+
+static unsigned osk_delay_ms(void)
+{
+    const char* e = getenv("PS3_OSK_DELAY_MS");
+    return (e && *e) ? (unsigned)strtoul(e, NULL, 10) : 1000u;
 }
 
-void cellOskDialogSetDefaultResponse(const char* text)
+/* ---------------------------------------------------------------------------
+ * The host's answer, from cellSysutilCheckCallback.
+ * -----------------------------------------------------------------------*/
+void cellOskDialog_tick(void)
 {
-    if (text) {
-        strncpy(s_default_response, GUEST_PTR(text, const char*),
-                CELL_OSK_MAX_TEXT_LENGTH);
-        s_default_response[CELL_OSK_MAX_TEXT_LENGTH] = '\0';
+    OSK_LOCK();
+    if (s_state != OSK_OPEN || !s_confirm_at || osk_now_ms() < s_confirm_at) {
+        OSK_UNLOCK();
+        return;
+    }
+    s_confirm_at = 0;
+    const char* cancel = getenv("PS3_OSK_CANCEL");
+    if (cancel && *cancel && *cancel != '0') {
+        s_result = CELL_OSKDIALOG_INPUT_FIELD_RESULT_CANCELED;
+    } else {
+        osk_scripted_text(s_dialogs - 1);
+        s_result = CELL_OSKDIALOG_INPUT_FIELD_RESULT_OK;
     }
+    s_state = OSK_CLOSED;
+    char shown[128];
+    osk_ascii(s_text, shown, sizeof shown);
+    const s32 result = s_result;
+    OSK_UNLOCK();
+    printf("[cellOskDialog] the host %s the dialog with \"%s\"; FINISHED\n",
+           result == CELL_OSKDIALOG_INPUT_FIELD_RESULT_OK ? "confirmed" : "cancelled", shown);
+    osk_broadcast(CELL_SYSUTIL_OSKDIALOG_FINISHED, 0);
 }
 
