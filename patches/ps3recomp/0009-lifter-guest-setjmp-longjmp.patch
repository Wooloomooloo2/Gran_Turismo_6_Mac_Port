+/* ---- guest setjmp/longjmp (ppu_sjlj.h) ---------------------------------- */
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
+/* guest-sjlj: begin */
+/* Frames registered by PPU_SJLJ_SETJMP, newest first, per host thread. A frame
+ * is in the chain exactly when its `pushed` is set: a function drops its own
+ * frames on every return (ppu_sjlj_leave), and a longjmp drops every frame
+ * newer than the one it lands on; both clear `pushed` on what they drop. */
+static PPU_THREAD_LOCAL ppu_sjlj_frame* g_sjlj_top = nullptr;
+static uint32_t sjlj_align(uint32_t ea) { return (ea + 15u) & ~15u; }
+
+static void sjlj_pop_top(void)
+{
+    ppu_sjlj_frame* f = g_sjlj_top;
+    g_sjlj_top = f->prev;
+    f->pushed = 0;
+    f->prev = nullptr;
+}
+
+extern "C" void ppu_sjlj_push(ppu_context* ctx, ppu_sjlj_frame* f, uint32_t guest_buf)
+{
+    (void)ctx;
+    if (f->pushed) {
+        /* The same call site again (a loop): re-arm it. Unlink it from wherever
+         * it sits; frames newer than it may be other live sites of the same
+         * function and stay. */
+        for (ppu_sjlj_frame** pp = &g_sjlj_top; *pp; pp = &(*pp)->prev)
+            if (*pp == f) { *pp = f->prev; break; }
+        f->pushed = 0;
+    }
+    f->guest_buf = sjlj_align(guest_buf);
+    f->dispatch_depth = g_dispatch_depth;
+    f->vcall_sp = g_vcall_sp;
+    f->prev = g_sjlj_top;
+    f->pushed = 1;
+    g_sjlj_top = f;
+}
+
+extern "C" void ppu_sjlj_leave(ppu_sjlj_frame* frames, int n)
+{
+    /* A returning function's frames are the newest in the chain: its callees
+     * have returned (and dropped theirs) or were jumped over. */
+    for (;;) {
+        ppu_sjlj_frame* t = g_sjlj_top;
+        int mine = 0;
+        for (int k = 0; t && k < n; k++) if (t == &frames[k]) { mine = 1; break; }
+        if (!mine) break;
+        sjlj_pop_top();
+    }
+    for (int k = 0; k < n; k++) frames[k].pushed = 0;   /* armed but already dropped */
+}
+
+extern "C" void ppu_sjlj_landed(ppu_context* ctx, ppu_sjlj_frame* f)
+{
+    (void)ctx;
+    /* The host frames the jump skipped never ran their epilogues. */
+    g_dispatch_depth = f->dispatch_depth;
+    g_vcall_sp = f->vcall_sp;
+    g_trampoline_fn = nullptr;
+}
+
+extern "C" void ppu_sjlj_longjmp(ppu_context* ctx, uint32_t guest_buf)
+{
+    const uint32_t want = sjlj_align(guest_buf);
+    for (ppu_sjlj_frame* p = g_sjlj_top; p; p = p->prev) {
+        if (p->guest_buf != want) continue;
+        while (g_sjlj_top != p) sjlj_pop_top();    /* frames newer than p are gone */
+#if defined(_WIN32)
+        longjmp(p->env, 1);
+#else
+        _longjmp(p->env, 1);
+#endif
+    }
+    static int n = 0;
+    if (PS3_LOG_FIRST(n, 8))
+        fprintf(stderr, "[ppu] guest longjmp(0x%08X): no live setjmp frame on this thread "
+                "(tid=%llu) -- returning to the caller instead\n", want,
+                (unsigned long long)ctx->thread_id);
+}
+/* guest-sjlj: end */
+
