+/* SPU_JOB_INTERP=1 (spu_workload.c): SPURS job binaries and policy modules
+ * with no lifted image run in the SPU interpreter. The hook is called on every
+ * such run (unset by default); the id is one no lifted image uses; the entry
+ * enters a policy module at LS 0xA00 for spu_run_policy_module. */
+extern void (*g_spu_job_interp_hook)(uint64_t fp, uint32_t size);
+int  spu_job_interp_enabled(void);
+int  spu_job_interp_image_id(uint64_t fp, uint32_t size);
+void spu_policy_interp_entry(spu_context* ctx);
