 /* A lifted indirect call (bisl): dispatch the callee, then drain until it
  * returns to return_pc. While the callee is dispatched, return_pc is already
  * the innermost return point: a callee with no lifted code runs in the
@@ -639,9 +648,16 @@ void spu_drain_call(spu_context* ctx, uint32_t return_pc)
  * loops waiting for other return points. */
 void spu_indirect_call(spu_context* ctx, uint32_t return_pc)
 {
-    const uint32_t outer_ret_pc = ctx->drain_ret_pc;
+    /* The call's frame: a callee returns with the $sp it was called with, and
+     * a recursive call through the same site returns to the same address from
+     * a deeper frame. The interpreter stops only in this frame or an outer one
+     * (batch 10 review M-1). */
+    const uint32_t ret_sp = ctx->gpr[1]._u32[0] & SPU_LS_MASK;
+    const uint32_t outer_ret_pc = ctx->drain_ret_pc, outer_ret_sp = ctx->drain_ret_sp;
     ctx->drain_ret_pc = return_pc & SPU_LS_MASK;
+    ctx->drain_ret_sp = ret_sp;
