--- /dev/null
+++ b/tests/test_spu_job_interp.c
@@ -0,0 +1,63 @@
+/* SPU_JOB_INTERP=1: a SPURS job binary with no lifted image runs in the SPU
+ * interpreter through the real runtime/spu/spu_workload.c and spurs_job.c,
+ * with jm2's staging, instead of being dropped. The job here loads 0x1234 into
+ * a register, writes it to its outbound mailbox and stops; the runner captures
+ * the mailbox after the run. The Python driver (tools/test_spu_job_interp.py)
+ * runs this with and without the switch and checks stderr and the exit code:
+ *   without: the job is dropped (dispatch returns 0), one ERROR line;
+ *   with:    it runs (returns 1), the mailbox holds 0x1234, the hook saw it,
+ *            and the INTERPRETED line names the fingerprint. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "spu_workload.h"
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size = 0x20000;
+uint32_t g_ww_lo, g_ww_hi, g_barrier_sync_watch;
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+int g_resv_store_active;
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void sys_event_queue_cancel_by_id(uint32_t id) { (void)id; }
+void sys_event_queue_uncancel_by_id(uint32_t id) { (void)id; }
+void spu_thread_publish_ctx(uint32_t tid, void* ctx) { (void)tid; (void)ctx; }
+uint32_t g_ydkj_real_spurs_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+unsigned long long ps3_ms_now(void) { return 0; }
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; abort(); }
+void ydkj_wake_all_event_flags(void) { abort(); }
+uint64_t spurs_pm_build_context(uint8_t* ls, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{ (void)ls; (void)a; (void)b; (void)c; (void)d; abort(); }
+
+#if defined(_MSC_VER)
+extern __declspec(thread) uint32_t g_spurs_job_mbox;
+#else
+extern __thread uint32_t g_spurs_job_mbox;
+#endif
+
+static unsigned s_hook_calls;
+static uint64_t s_hook_fp;
+static void note(uint64_t fp, uint32_t size) { (void)size; s_hook_calls++; s_hook_fp = fp; }
+
+static void be32(uint8_t* p, uint32_t v)
+{ p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v; }
+
+int main(void)
+{
+    vm_base = (uint8_t*)calloc(1, ppu_vm_size);
+    g_spu_job_interp_hook = note;
+    const uint32_t BIN = 0x8000, JOB = 0x2000;
+    uint8_t* bin = vm_base + BIN;
+    be32(bin + 0, 0x40800000u | (0x1234u << 7) | 5u);   /* il   $5, 0x1234         */
+    be32(bin + 4, 0x21A00000u | (28u << 7) | 5u);       /* wrch $SPU_WrOutMbox, $5 */
+    be32(bin + 8, 0x00000000u);                         /* stop 0                  */
+    /* CellSpursJobHeader: eaBinary (u64), sizeBinary (u16, bytes >> 4) */
+    be32(vm_base + JOB + 4, BIN);
+    vm_base[JOB + 8] = 0; vm_base[JOB + 9] = 0x10;     /* 256 bytes */
+    g_spurs_job_mbox = 0;
+    int r = spu_workload_dispatch_job(bin, 256, JOB, 0x80);
+    fprintf(stderr, "job-interp: r=%d mbox=0x%X hook=%u fp=0x%016llX\n", r, g_spurs_job_mbox,
+            s_hook_calls, (unsigned long long)s_hook_fp);
+    return 0;
+}
--- /dev/null
+++ b/tools/test_spu_job_interp.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""SPU_JOB_INTERP=1 runs a SPURS job with no lifted image in the SPU interpreter
+(runtime/spu/spu_workload.c) instead of dropping it; without it the job is dropped."""
+import os
+from pathlib import Path
+import platform
+import re
+import subprocess
+import tempfile
+root = Path(__file__).resolve().parents[1]
+if os.name == 'nt':
+    print('SKIP: fixture currently uses POSIX linking')
+    raise SystemExit(0)
+with tempfile.TemporaryDirectory(prefix='spu-job-interp-') as tmp:
+    out = Path(tmp) / 'test'
+    units = ['spu_channels', 'spu_drain', 'spu_lockstep', 'spu_coherency', 'spu_workload',
+             'spurs_policy', 'spurs_job', 'spu_tsp_weak', 'spu_vm_pagemap',
+             'spurs_policy_blob_weak', 'spu_interp']
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-D_GNU_SOURCE', '-O1', '-UNDEBUG',
+                    '-ffunction-sections', '-fdata-sections',
+                    '-Wl,-dead_strip' if platform.system() == 'Darwin' else '-Wl,--gc-sections',
+                    '-I' + str(root / 'include'), '-I' + str(root / 'runtime/spu'),
+                    '-I' + str(root / 'runtime/platform'),
+                    str(root / 'tests/test_spu_job_interp.c'),
+                    *[str(root / 'runtime/spu' / f'{u}.c') for u in units],
+                    str(root / 'runtime/platform/win32_compat.c'), '-pthread', '-lm', '-o', str(out)],
+                   check=True)
+    base = {k: v for k, v in os.environ.items()
+            if k not in ('SPU_MISS_FATAL', 'SPU_DUMP_MISS', 'SPU_JOB_INTERP')}
+
+    p = subprocess.run([str(out)], env=base, capture_output=True, text=True, timeout=15)
+    assert p.returncode == 0, (p.returncode, p.stderr)
+    m = re.search(r'job-interp: r=(\d+) mbox=0x([0-9A-F]+) hook=(\d+)', p.stderr)
+    assert m and m.group(1) == '0' and m.group(3) == '0', p.stderr
+    assert 'DROPPED' in p.stderr and 'INTERPRETED' not in p.stderr, p.stderr
+
+    dump = Path(tmp) / 'dump'
+    dump.mkdir()
+    p = subprocess.run([str(out)], env={**base, 'SPU_JOB_INTERP': '1', 'SPU_DUMP_MISS': str(dump)},
+                       capture_output=True, text=True, timeout=15)
+    assert p.returncode == 0, (p.returncode, p.stderr)
+    m = re.search(r'job-interp: r=(\d+) mbox=0x([0-9A-F]+) hook=(\d+) fp=0x([0-9A-F]{16})', p.stderr)
+    assert m, p.stderr
+    assert m.group(1) == '1', 'the interpreted job must count as run: ' + p.stderr
+    assert m.group(2) == '1234', 'the job ran and wrote its mailbox: ' + p.stderr
+    assert m.group(3) == '1', 'the hook sees every interpreted run: ' + p.stderr
+    assert 'DROPPED' not in p.stderr, p.stderr
+    assert re.search(r'INTERPRETED .*fp=0x%s' % m.group(4), p.stderr), p.stderr
+    dumped = list(dump.glob('spujob_*.bin'))
+    assert len(dumped) == 1 and dumped[0].stat().st_size == 256, dumped
+    assert m.group(4) in dumped[0].name, (dumped, m.group(4))
+print('PASS')
