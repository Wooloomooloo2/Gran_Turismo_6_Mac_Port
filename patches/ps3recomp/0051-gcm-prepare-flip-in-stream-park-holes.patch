-static volatile u32 s_prepared_in_fifo;
+/* cellGcmSetPrepareFlip / cellGcmSetFlipImmediate, as libgcm and the RSX do
+ * them. The prepare puts the driver's flip command (method 0xFEAC, one data
+ * word: the buffer id) into the title's context at `current`; the buffer is
+ * ready once the RSX has executed everything before that command. The
+ * immediate flip then switches the display to a ready buffer, at the moment
+ * the title picks (GT6: its vblank handler, one frame behind the prepare).
+ * So the present happens at cellGcmSetFlipImmediate when the drain has
+ * already reached the buffer's command, or when the drain reaches it if the
+ * immediate flip came first; never at the prepare, and never twice.
+ *
+ * Per buffer: prepared (the command is in a stream, the immediate flip has
+ * not taken it yet) and ready (the drain has reached it). s_pf_wanted is the
+ * buffer an immediate flip is waiting on, plus one (0: none). The drain thread
+ * and the title's threads race on all three, so they are atomic, and the
+ * present is claimed by whoever clears s_pf_wanted. */
+static _Atomic u32 s_pf_prepared, s_pf_ready, s_pf_wanted;
 
+/* Counters (GCM_PREPARE_STATS on stderr; always in the summary line printed
+ * at prepares 1, 10, 100, 1000 and every 2000th): which way each prepare went
+ * and how the presents came about. `old_refused` counts prepares the room check
+ * before this change (current + 8 + 4 KB > end) would have refused: the
+ * hypothesis that GT6's flips mostly bypassed the stream. */
+static _Atomic u32 s_pf_n, s_pf_stream, s_pf_unmapped, s_pf_callback, s_pf_full,
+                   s_pf_old_refused, s_pf_reached, s_pf_present_now, s_pf_present_later;
+
+static void gcm_prepared_present(u32 bufferId)
+{
+    gcm_set_current_display_buffer(bufferId);
+    s_flip_pending = 1;
+    gcm_note_flip_request();
+}
+
+/* The drain has executed buffer `id`'s prepare command (or a resync skipped
+ * it, which the RSX would have executed by now). Returns 1 when it presented
+ * the buffer for an immediate flip that was waiting on it. */
+static int gcm_prepared_reached(u32 id)
+{
+    id &= 7u;
+    if (id >= CELL_GCM_MAX_DISPLAY_BUFFER_NUM) return 0;
+    atomic_fetch_add(&s_pf_reached, 1);
+    atomic_fetch_or(&s_pf_ready, 1u << id);
+    u32 want = id + 1;
+    if (atomic_compare_exchange_strong(&s_pf_wanted, &want, 0u)) {
+        atomic_fetch_and(&s_pf_ready, ~(1u << id));
+        atomic_fetch_add(&s_pf_present_later, 1);
+        gcm_prepared_present(id);
+        return 1;
+    }
+    return 0;
+}
+
+static void gcm_prepare_stats(const char* ctx_note)
+{
+    const u32 n = atomic_load(&s_pf_n);
+    static int dbg = -1;
+    if (dbg < 0) dbg = getenv("GCM_PREPARE_STATS") ? 1 : 0;
+    if (!(dbg || n == 1 || n == 10 || n == 100 || n == 1000 || n % 2000u == 0)) return;
+    fprintf(stderr, "[gcm-prepare] %u prepares: %u in the stream (%u after the title's"
+            " callback), %u full after it, %u unmapped; %u the old 4 KB check would have"
+            " refused; %u commands reached; presents at the immediate flip %u, at the"
+            " command %u; %u guest flip requests%s%s%c",
+            n, atomic_load(&s_pf_stream), atomic_load(&s_pf_callback), atomic_load(&s_pf_full),
+            atomic_load(&s_pf_unmapped), atomic_load(&s_pf_old_refused),
+            atomic_load(&s_pf_reached), atomic_load(&s_pf_present_now),
+            atomic_load(&s_pf_present_later), s_flip_request_count,
+            ctx_note ? "; " : "", ctx_note ? ctx_note : "", 10);
+}
+
+/* Write the prepare command into a context. A context the title owns needs
+ * only room for the command's 2 words; when it has less, libgcm calls the
+ * context's callback (ctx->callback(ctx, 2)), which makes room, and writes
+ * then. The runtime's own ring (its callback is the runtime's sentinel) keeps
+ * the runtime's 4 KB reserve and its wrap, as gcm_flip_into_fifo does.
+ * Returns 1 when the command is in the stream, 0 when ctx is not a mapped
+ * command buffer, -1 when there was still no room. */
+static int gcm_prepare_flip_into_fifo(u32 ctx, u32 bufferId)
+{
+    if (!ctx) return 0;
+    u32 end = vm_read32(ctx + 4), cur = vm_read32(ctx + 8);
+    if (gcm_ea2io(cur) == 0xFFFFFFFFu) return 0;
+    const u32 cb_opd = vm_read32(ctx + 0xC);
+    const int runtime_ring = cb_opd && vm_read32(cb_opd) == GCM_FIFO_CALLBACK_SENTINEL_EA;
+    char note[160];
+    note[0] = 0;
+    { static int shown = 0;
+      if (shown < 3) { shown++;
+          snprintf(note, sizeof note, "context 0x%08X begin 0x%08X end 0x%08X current 0x%08X"
+                   " callback 0x%08X (%s)", ctx, vm_read32(ctx), end, cur, cb_opd,
+                   runtime_ring ? "the runtime's ring" : "the title's"); } }
+    atomic_fetch_add(&s_pf_n, 1);
+    if (cur + 8 + GCM_RECYCLE_SLACK > end) atomic_fetch_add(&s_pf_old_refused, 1);
+    if (runtime_ring) {
+        if (cur + 8 + GCM_RECYCLE_SLACK > end) { gcm_prepare_stats(note); return -1; }
+    } else if (cur + 8 > end) {
+        if (cb_opd && g_ps3_guest_caller) {
+            atomic_fetch_add(&s_pf_callback, 1);
+            g_ps3_guest_caller(cb_opd, ctx, 2, 0, 0, 0, 0, 0, 0);
+            end = vm_read32(ctx + 4);
+            cur = vm_read32(ctx + 8);
+        }
+        if (cur + 8 > end || gcm_ea2io(cur) == 0xFFFFFFFFu) {
+            atomic_fetch_add(&s_pf_full, 1);
+            gcm_prepare_stats(note);
+            return -1;
+        }
+    }
+    vm_write32(cur, GCM_PREPARE_FLIP_HDR);
+    vm_write32(cur + 4, bufferId);
+    vm_write32(ctx + 8, cur + 8);
+    atomic_fetch_add(&s_pf_stream, 1);
+    gcm_prepare_stats(note[0] ? note : NULL);
+    return 1;
+}
