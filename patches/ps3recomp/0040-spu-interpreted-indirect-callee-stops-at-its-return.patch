                     f"ctx->host_depth--; spu_img_restore(ctx, _si); }}")
         # bisled: set link, branch to RA only if an external event is pending.
         if mn in ("bisled",):
diff --git a/tools/spu_lift_selftest.py b/tools/spu_lift_selftest.py
--- a/tools/spu_lift_selftest.py
+++ b/tools/spu_lift_selftest.py
@@ -115,6 +115,7 @@ void spu_drain_call(spu_context* c, uint32_t ret){
         void (*f)(spu_context*) = g_spu_trampoline_fn; g_spu_trampoline_fn = 0; f(c);
     }
 }
+void spu_indirect_call(spu_context* c, uint32_t ret){ spu_indirect_branch(c); spu_drain_call(c, ret); }
 '''
 
 
