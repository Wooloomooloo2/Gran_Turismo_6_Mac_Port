+                      "job=0x%08X (#%llu)\n", (unsigned long long)fp, image_size, job_ea,
+                      interp_n); }
+        spu_run_spurs_job(spu_job_interp_entry, spu_job_interp_image_id(fp, image_size),
+                          job_ea, job_desc_size);
+        return 1;
     }
