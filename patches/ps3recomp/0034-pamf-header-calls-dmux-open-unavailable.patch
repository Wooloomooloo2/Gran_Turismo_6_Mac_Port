+
+#define CELL_PAMF_ATTRIBUTE_VERIFY_ON        1
+#define CELL_PAMF_ATTRIBUTE_MINIMUM_HEADER   2
 
 /* ---------------------------------------------------------------------------
  * Stream types
@@ -135,6 +144,12 @@ s32 cellPamfStreamTypeToEsFilterId(u8 streamType, u8 streamIndex,
 
 /* Entry point navigation */
 s32 cellPamfReaderGetNumberOfEp(CellPamfReader* reader, s32* numEp);
+
+/* Header-only calls, on the file's real layout (guest EAs; u64 out-values). */
+s32 cellPamfGetHeaderSize(u32 pAddr, u64 fileSize, u32 pSize);
+s32 cellPamfGetHeaderSize2(u32 pAddr, u64 fileSize, u32 attribute, u32 pSize);
+s32 cellPamfGetStreamOffsetAndSize(u32 pAddr, u64 fileSize, u32 pOffset, u32 pSize);
+s32 cellPamfVerify(u32 pAddr, u64 fileSize);
 s32 cellPamfReaderGetEp(CellPamfReader* reader, u32 epIndex, CellPamfEp* ep);
 
 #ifdef __cplusplus
diff --git a/tests/test_pamf_header_dmux.c b/tests/test_pamf_header_dmux.c
new file mode 100644
index 00000000..1256194e
--- /dev/null
+++ b/tests/test_pamf_header_dmux.c
@@ -0,0 +1,106 @@
+/* cellPamf's header-only calls and cellDmux's attribute/open calls, through the
+ * real libs/codec/cellPamf.c and cellDmux.c. Run by tools/test_pamf_header_dmux.py.
+ *  - GetStreamOffsetAndSize / GetHeaderSize(2) / Verify read the PAMF file's
+ *    real layout: sizes in 2048-byte units at 0x08 and 0x0C, the SDK's codes.
+ *  - QueryAttr / OpenEx check their arguments (ARG), then answer FATAL (no
+ *    demuxer core) and write nothing. */
+#include "../libs/codec/cellPamf.h"
+#include "../libs/codec/cellDmux.h"
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+
+static int fails;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+
+static void be32w(uint32_t ea, uint32_t v) { uint8_t* p = vm_base + ea; p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+static uint64_t be64r(uint32_t ea) { uint64_t v = 0; for (int i = 0; i < 8; i++) v = v << 8 | vm_base[ea + i]; return v; }
+
+#define HDR 0x10000u
+#define OUT 0x20000u
+
+static void make_header(void)
+{
+    memset(vm_base + HDR, 0, 0x1800);
+    memcpy(vm_base + HDR, "PAMF0041", 8);
+    be32w(HDR + 8, 3);            /* header: 3 x 2048 = 0x1800 */
+    be32w(HDR + 12, 261476);      /* data: 261476 x 2048 */
+    be32w(HDR + 0x50, 0x200);     /* sequence info: 0x200 bytes after its size word */
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    vm_base = (uint8_t*)mmap(NULL, 0x100000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    const uint64_t file = 0x1800ull + 261476ull * 0x800;
+    make_header();
+
+    memset(vm_base + OUT, 0xAA, 32);
+    CHECK(cellPamfGetStreamOffsetAndSize(HDR, file, OUT, OUT + 8) == CELL_OK, "offset and size: OK");
+    CHECK(be64r(OUT) == 0x1800 && be64r(OUT + 8) == 261476ull * 0x800, "offset 0x1800, size data_size x 2048");
+    CHECK(cellPamfGetStreamOffsetAndSize(HDR, 0, OUT, 0) == CELL_OK, "file size 0 skips the size check");
+    CHECK((uint32_t)cellPamfGetStreamOffsetAndSize(HDR, file + 0x800, OUT, OUT + 8) == CELL_PAMF_ERROR_INVALID_PAMF,
+          "a file size that is not header + data: INVALID_PAMF");
+
+    memset(vm_base + OUT, 0xAA, 16);
+    CHECK(cellPamfGetHeaderSize2(HDR, file, 0, OUT) == CELL_OK && be64r(OUT) == 0x1800, "header size 2: 0x1800");
+    CHECK(cellPamfGetHeaderSize2(HDR, file, CELL_PAMF_ATTRIBUTE_MINIMUM_HEADER, OUT) == CELL_OK && be64r(OUT) == 0x254,
+          "minimum header: up to the end of the sequence info (0x50 + 4 + 0x200)");
+    CHECK(cellPamfGetHeaderSize(HDR, file, OUT) == CELL_OK && be64r(OUT) == 0x1800, "header size: 0x1800");
+
+    CHECK(cellPamfVerify(HDR, file) == CELL_OK, "verify: a well-formed header is OK");
+    be32w(HDR + 0x10, 0x100);
+    CHECK((uint32_t)cellPamfVerify(HDR, file) == CELL_PAMF_ERROR_INVALID_PAMF, "verify: marks offset without a size is INVALID_PAMF");
+    be32w(HDR + 0x10, 0);
+    be32w(HDR + 0x50, 0x2000);
+    CHECK((uint32_t)cellPamfVerify(HDR, file) == CELL_PAMF_ERROR_INVALID_PAMF, "verify: sequence info past the header is INVALID_PAMF");
+    be32w(HDR + 0x50, 0x200);
+
+    memcpy(vm_base + HDR + 4, "0042", 4);
+    CHECK((uint32_t)cellPamfVerify(HDR, file) == CELL_PAMF_ERROR_UNSUPPORTED_VERSION, "version 0042: UNSUPPORTED_VERSION");
+    memcpy(vm_base + HDR + 4, "0040", 4);
+    CHECK(cellPamfVerify(HDR, file) == CELL_OK, "version 0040 is accepted");
+    memcpy(vm_base + HDR, "PSMF", 4);
+    CHECK((uint32_t)cellPamfGetHeaderSize2(HDR, file, 0, OUT) == CELL_PAMF_ERROR_UNKNOWN_TYPE, "another magic: UNKNOWN_TYPE");
+    make_header();
+    be32w(HDR + 8, 0);
+    CHECK((uint32_t)cellPamfGetHeaderSize2(HDR, 0, 0, OUT) == CELL_PAMF_ERROR_INVALID_PAMF, "header size 0: INVALID_PAMF");
+
+    /* cellDmux: type {streamType 1 = CELL_DMUX_STREAM_TYPE_PAMF}, a filled CellDmuxResourceEx, a callback block, a handle slot. */
+    const uint32_t type = 0x30000, res = 0x30100, cb = 0x30200, handle = 0x30300, attr = 0x30400;
+    memset(vm_base + 0x30000, 0, 0x1000);
+    be32w(type, 1);
+    be32w(res + 0, 0x40000); be32w(res + 4, 0x10000); be32w(res + 8, 1000); be32w(res + 0xC, 0x4000);
+    be32w(res + 0x10, 0x50000); be32w(res + 0x14, 0x01010101); be32w(res + 0x18, 0x01010101); be32w(res + 0x1C, 1);
+    be32w(handle, 0xAAAAAAAA); memset(vm_base + attr, 0xAA, 12);
+
+    CHECK((uint32_t)cellDmuxQueryAttr(type, attr) == CELL_DMUX_ERROR_FATAL, "QueryAttr: FATAL (no demuxer core)");
+    CHECK(vm_base[attr] == 0xAA && vm_base[attr + 11] == 0xAA, "QueryAttr writes no attribute");
+    CHECK((uint32_t)cellDmuxQueryAttr(0, attr) == CELL_DMUX_ERROR_ARG, "QueryAttr with no type: ARG");
+    be32w(type, 0);
+    CHECK((uint32_t)cellDmuxQueryAttr(type, attr) == CELL_DMUX_ERROR_ARG, "QueryAttr for stream type 0 (UNDEF): ARG");
+    be32w(type, 2);
+    CHECK((uint32_t)cellDmuxOpenEx(type, res, cb, handle) == CELL_DMUX_ERROR_ARG, "OpenEx for another stream type: ARG");
+    be32w(type, 1);
+
+    CHECK((uint32_t)cellDmuxOpenEx(type, res, cb, handle) == CELL_DMUX_ERROR_FATAL, "OpenEx: FATAL (no demuxer core)");
+    CHECK(vm_base[handle] == 0xAA && vm_base[handle + 3] == 0xAA, "OpenEx writes no handle");
+    CHECK((uint32_t)cellDmuxOpenEx(type, res, cb, 0) == CELL_DMUX_ERROR_ARG, "OpenEx with no handle slot: ARG");
+    CHECK((uint32_t)cellDmuxOpenEx(type, res, 0, handle) == CELL_DMUX_ERROR_ARG, "OpenEx with no callback: ARG");
+    be32w(res + 0x1C, 0);
+    CHECK((uint32_t)cellDmuxOpenEx(type, res, cb, handle) == CELL_DMUX_ERROR_ARG, "OpenEx with maxContention 0: ARG");
+    be32w(res + 0x1C, 1); be32w(res + 0x14, 0x10000000);
+    CHECK((uint32_t)cellDmuxOpenEx(type, res, cb, handle) == CELL_DMUX_ERROR_ARG, "OpenEx with a priority byte of 0x10: ARG");
+    be32w(res + 0x14, 0); be32w(res + 0x10, 0);
+    CHECK((uint32_t)cellDmuxOpenEx(type, res, cb, handle) == CELL_DMUX_ERROR_ARG, "OpenEx with no SPURS: ARG");
+
+    if (fails) { printf("%d check(s) failed\n", fails); return 1; }
+    puts("test_pamf_header_dmux: OK");
+    return 0;
+}
