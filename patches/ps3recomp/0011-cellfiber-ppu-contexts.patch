index 00000000..192d1617
--- /dev/null
+++ b/libs/spurs/tests/test_fiber_context.c
@@ -0,0 +1,655 @@
+/*
+ * ps3recomp - libs/spurs/tests/test_fiber_context.c
+ *
+ * cellFiberPpuContext*: the SDK's low-level PPU fiber contexts (libs/spurs/cellFiber.c). A PPU thread runs a context
+ * with cellFiberPpuContextRun; the context runs until it calls cellFiberPpuContextReturnToThread (or its entry
+ * returns), and contexts hand control to each other with cellFiberPpuContextSwitch. Each context runs on a host
+ * thread of its own, and exactly one of them, or the thread that ran them, executes at a time.
+ *
+ * What is checked:
+ *   1. Run returns to the thread when the entry returns; the entry starts with its argument in r3, NULL in r4 and r1
+ *      inside the guest stack it was given (16-byte aligned, back chain 0). An ended context cannot run again.
+ *   2. ReturnToThread hands a cause back to Run, and the next Run resumes the context after the call.
+ *   3. A -> B -> A with Switch: fiberFrom names the switcher, each context keeps its own guest registers and guest
+ *      stack across the switches, and a context resumed by Run sees fiberFrom NULL.
+ *   4. Self is the running context, NULL on the thread.
+ *   5. Guest thread identity: inside a context, thread_id and r13 (TLS) are those of the PPU thread that ran it, even
+ *      when a second thread runs it next. Host identity: it runs on a host thread of its own, whose thread-locals
+ *      start empty (the guest setjmp chain is one of them).
+ *   6. Finalize on a suspended, a never-run and an ended context frees its host thread without a deadlock.
+ *   7. The error codes: NULL_POINTER, ALIGN, INVAL, STAT and PERM, including Run and Finalize on a running context
+ *      from another host thread.
+ *   8. A switch round trip count, timed (printed for the record).
+ *
+ * With the argument "exit", the program leaves contexts suspended in ReturnToThread and in Switch, and one never
+ * run, and returns from main: the process must exit (the runner holds it to a timeout).
+ *
+ * The guest entry is a host function: the PPU thread trampoline finds it by the descriptor address in ctx->cia.
+ *
+ * Exit code 0 = pass.
+ */
+#include "cellFiber.h"
+#include "../../../runtime/syscalls/sys_ppu_thread.h"   /* ppu_context, ppu_thread_entry_fn */
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+/* ---------------------------------------------------------------------------
+ * Guest memory shim (as tests/fiber_switch)
+ * -----------------------------------------------------------------------*/
+#define GUEST_MEM_SIZE (1u * 1024u * 1024u)
+static uint8_t g_guest_mem[GUEST_MEM_SIZE];
+uint8_t* vm_base = g_guest_mem;
+
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi = 0;
+int      g_resv_store_active = 0;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void)   { }
+void spu_lockline_unlock(void) { }
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+
+/* The reservation set the runtime keeps (ppu_loader.cpp): every context's ppu_context joins it once. */
+static ppu_context* g_resv[64];
+static int          g_resv_n;
+static pthread_mutex_t g_resv_lock = PTHREAD_MUTEX_INITIALIZER;
+void ppu_resv_register(ppu_context* c)
+{
+    pthread_mutex_lock(&g_resv_lock);
+    if (g_resv_n < 64) g_resv[g_resv_n] = c;
+    g_resv_n++;
+    pthread_mutex_unlock(&g_resv_lock);
+}
+
+static uint32_t g_bump = 4096;
+static uint32_t guest_alloc(uint32_t size, uint32_t align)
+{
+    g_bump = (g_bump + align - 1u) & ~(align - 1u);
+    uint32_t a = g_bump;
+    g_bump += size;
+    return a;
+}
+
+static uint32_t read_be32(uint32_t a)
+{
+    const uint8_t* p = g_guest_mem + a;
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+static uint64_t read_be64(uint32_t a) { return ((uint64_t)read_be32(a) << 32) | read_be32(a + 4); }
+static void write_be32(uint32_t a, uint32_t v)
+{
+    uint8_t* p = g_guest_mem + a;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+
+/* ---------------------------------------------------------------------------
+ * PPU side
+ * -----------------------------------------------------------------------*/
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+
+typedef void (*guest_fn)(ppu_context* ctx);
+#define ENTRY_BASE 0x1000u
+#define MAX_ENTRIES 32
+static guest_fn g_entries[MAX_ENTRIES];
+
+static uint32_t entry_of(guest_fn fn)
+{
+    for (uint32_t i = 0; i < MAX_ENTRIES; i++) {
+        if (g_entries[i] == fn) return ENTRY_BASE + i;
+        if (!g_entries[i]) { g_entries[i] = fn; return ENTRY_BASE + i; }
+    }
+    return 0;
+}
+
+static void trampoline(ppu_context* ctx)
+{
+    g_active_ctx = ctx;
+    g_entries[ctx->cia - ENTRY_BASE](ctx);
+}
+ppu_thread_entry_fn g_ppu_thread_entry_trampoline = trampoline;
+
+/* The PPU thread the tests run on: guest thread 5, TLS at 0x7000. */
+static ppu_context g_main_ctx;
+
+/* ---------------------------------------------------------------------------
+ * Bookkeeping
+ * -----------------------------------------------------------------------*/
+static int g_fails = 0;
+#define FAILF(...) do { g_fails++; fprintf(stderr, "[FAIL] "); \
+                        fprintf(stderr, __VA_ARGS__); fputc('\n', stderr); } while (0)
+#define CHECK(c) do { if (!(c)) FAILF("line %d: %s", __LINE__, #c); } while (0)
+#define CHECK_RC(call, want) do { s32 rc_ = (call); \
+    if (rc_ != (s32)(want)) FAILF("line %d: %s = 0x%08X, want 0x%08X", __LINE__, #call, (unsigned)rc_, (unsigned)(want)); \
+    } while (0)
+
+#define STACK_SIZE 0x4000u
+typedef struct { uint32_t ea, stack; } ctx_ref;
+#define CTX(r) ((CellFiberPpuContext*)(uintptr_t)(r).ea)
+#define GP(a)  ((void*)(uintptr_t)(a))
+
+static ctx_ref new_context(guest_fn fn, uint64_t arg)
+{
+    ctx_ref r;
+    r.ea    = guest_alloc(CELL_FIBER_PPU_CONTEXT_SIZE, CELL_FIBER_PPU_CONTEXT_ALIGN);
+    r.stack = guest_alloc(STACK_SIZE, 16);
+    uint32_t attr = guest_alloc(CELL_FIBER_PPU_CONTEXT_ATTRIBUTE_SIZE, 8);
+    CHECK_RC(_cellFiberPpuContextAttributeInitialize(GP(attr), 0x330000), CELL_OK);
+    CHECK_RC(cellFiberPpuContextInitialize(CTX(r), entry_of(fn), arg, GP(r.stack), STACK_SIZE, GP(attr)), CELL_OK);
+    return r;
+}
+
+/* Run from the test's PPU thread; returns the cause, fiberFrom in *from. */
+static s32 run(ctx_ref r, uint32_t* from)
+{
+    uint32_t cause = guest_alloc(4, 4), ff = guest_alloc(4, 4);
+    write_be32(cause, 0xDEADBEEFu);
+    write_be32(ff, 0xDEADBEEFu);
+    CHECK_RC(cellFiberPpuContextRun(CTX(r), GP(cause), GP(ff), NULL), CELL_OK);
+    if (from) *from = read_be32(ff);
+    return (s32)read_be32(cause);
+}
+
+static int wait_threads(int want)
+{
+    for (int i = 0; i < 2000; i++) {
+        if (ps3_fiber_context_host_threads() == want) return 1;
+        usleep(1000);
+    }
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Case 1: the entry returns
+ * -----------------------------------------------------------------------*/
+static ctx_ref c1;
+static uint64_t c1_r3, c1_r4, c1_r1, c1_chain;
+static int c1_ran;
+
+static void c1_entry(ppu_context* ctx)
+{
+    c1_ran++;
+    c1_r3 = ctx->gpr[3];
+    c1_r4 = ctx->gpr[4];
+    c1_r1 = ctx->gpr[1];
+    c1_chain = read_be64((uint32_t)ctx->gpr[1]);
+    CHECK(g_active_ctx == ctx && ctx != &g_main_ctx);
+}
+
+static void case_entry_returns(void)
+{
+    c1 = new_context(c1_entry, 0x1122334455667788ull);
+    uint32_t from = 0;
+    s32 cause = run(c1, &from);
+    CHECK(c1_ran == 1);
+    CHECK(cause == 0);
+    CHECK(from == c1.ea);
+    CHECK(c1_r3 == 0x1122334455667788ull);
+    CHECK(c1_r4 == 0);
+    CHECK(c1_r1 > c1.stack && c1_r1 < c1.stack + STACK_SIZE && (c1_r1 & 0xF) == 0);
+    CHECK(c1_chain == 0);
+    /* an ended context does not run again */
+    uint32_t cs = guest_alloc(4, 4);
+    CHECK_RC(cellFiberPpuContextRun(CTX(c1), GP(cs), NULL, NULL), CELL_FIBER_ERROR_STAT);
+    CHECK(c1_ran == 1);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(c1)), CELL_OK);
+    CHECK(wait_threads(0));
+    printf("[case entry-returns] ok\n");
+}
+
+/* ---------------------------------------------------------------------------
+ * Case 2: ReturnToThread and resume
+ * -----------------------------------------------------------------------*/
+static int c2_steps;
+
+static void c2_entry(ppu_context* ctx)
+{
+    for (int i = 0; i < 5; i++) {
+        c2_steps++;
+        CHECK_RC(cellFiberPpuContextReturnToThread(100 + i), CELL_OK);
+        CHECK(g_active_ctx == ctx);
+    }
+    c2_steps = 1000;
+}
+
+static void case_return_to_thread(void)
+{
+    c2_steps = 0;
+    ctx_ref r = new_context(c2_entry, 0);
+    for (int i = 0; i < 5; i++) {
+        uint32_t from = 0;
+        s32 cause = run(r, &from);
+        CHECK(cause == 100 + i);
+        CHECK(from == r.ea);
+        CHECK(c2_steps == i + 1);
+    }
+    s32 cause = run(r, NULL);   /* the loop ends and the entry returns */
+    CHECK(cause == 0);
+    CHECK(c2_steps == 1000);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(r)), CELL_OK);
+    CHECK(wait_threads(0));
+    printf("[case return-to-thread] ok\n");
+}
+
+/* ---------------------------------------------------------------------------
+ * Case 3: A -> B -> A, registers and stacks
+ * -----------------------------------------------------------------------*/
+static ctx_ref ca, cb;
+static uint32_t a_from_after, b_r4, b_from_after_run;
+static int a_regs_ok, a_stack_ok, b_self_ok;
+
+static void fill_regs(ppu_context* ctx, uint64_t seed)
+{
+    for (int i = 14; i < 32; i++) ctx->gpr[i] = seed * 0x100000001ull + (uint64_t)i;
+    for (int i = 14; i < 32; i++) ctx->fpr[i] = (double)seed + i * 0.5;
+    ctx->cr = (uint32_t)seed;
+}
+static int regs_are(const ppu_context* ctx, uint64_t seed)
+{
+    for (int i = 14; i < 32; i++) if (ctx->gpr[i] != seed * 0x100000001ull + (uint64_t)i) return 0;
+    for (int i = 14; i < 32; i++) if (ctx->fpr[i] != (double)seed + i * 0.5) return 0;
+    return ctx->cr == (uint32_t)seed;
+}
+static void fill_stack(uint32_t sp, uint8_t seed)
+{
+    for (uint32_t k = 0; k < 256; k++) g_guest_mem[sp - 256 + k] = (uint8_t)(seed + k);
+}
+static int stack_is(uint32_t sp, uint8_t seed)
+{
+    for (uint32_t k = 0; k < 256; k++) if (g_guest_mem[sp - 256 + k] != (uint8_t)(seed + k)) return 0;
+    return 1;
+}
+
+static void a_entry(ppu_context* ctx)
+{
+    fill_regs(ctx, 0xA);
+    fill_stack((uint32_t)ctx->gpr[1], 0x3A);
+    uint32_t ff = guest_alloc(4, 4);
+    CHECK_RC(cellFiberPpuContextSwitch(CTX(cb), GP(ff), NULL), CELL_OK);
+    a_from_after = read_be32(ff);
+    a_regs_ok  = regs_are(ctx, 0xA) && g_active_ctx == ctx;
+    a_stack_ok = stack_is((uint32_t)ctx->gpr[1], 0x3A);
+    CHECK((uint32_t)(uintptr_t)cellFiberPpuContextSelf() == ca.ea);
+    CHECK_RC(cellFiberPpuContextReturnToThread(1), CELL_OK);
+}
+
+static void b_entry(ppu_context* ctx)
+{
+    b_r4 = (uint32_t)ctx->gpr[4];
+    b_self_ok = (uint32_t)(uintptr_t)cellFiberPpuContextSelf() == cb.ea;
+    fill_regs(ctx, 0xB);
+    fill_stack((uint32_t)ctx->gpr[1], 0x3B);
+    uint32_t ff = guest_alloc(4, 4);
+    CHECK_RC(cellFiberPpuContextSwitch(CTX(ca), GP(ff), NULL), CELL_OK);
+    /* resumed by Run from the thread */
+    b_from_after_run = read_be32(ff);
+    CHECK(regs_are(ctx, 0xB) && stack_is((uint32_t)ctx->gpr[1], 0x3B));
+    CHECK_RC(cellFiberPpuContextReturnToThread(2), CELL_OK);
+}
+
+static void case_switch(void)
+{
+    ca = new_context(a_entry, 0xAAAA);
+    cb = new_context(b_entry, 0xBBBB);
+    uint32_t from = 0;
+    s32 cause = run(ca, &from);
+    CHECK(cause == 1 && from == ca.ea);
+    CHECK(b_r4 == ca.ea);          /* B started by A's switch: fiberFrom is A */
+    CHECK(b_self_ok);
+    CHECK(a_from_after == cb.ea);  /* A resumed by B's switch */
+    CHECK(a_regs_ok);
+    CHECK(a_stack_ok);
+    cause = run(cb, &from);
+    CHECK(cause == 2 && from == cb.ea);
+    CHECK(b_from_after_run == 0);  /* resumed by the thread */
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(ca)), CELL_OK);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(cb)), CELL_OK);
+    CHECK(wait_threads(0));
+    printf("[case switch] ok\n");
+}
+
+/* ---------------------------------------------------------------------------
+ * Case 4/5: Self, guest and host thread identity
+ * -----------------------------------------------------------------------*/
+static __thread int t_marker;
+static pthread_t g_main_host;
+static uint64_t id_tid, id_r13;
+static int id_other_host, id_marker;
+static uint32_t id_self;
+
+static void id_entry(ppu_context* ctx)
+{
+    for (;;) {
+        id_tid = ctx->thread_id;
+        id_r13 = ctx->gpr[13];
+        id_other_host = !pthread_equal(pthread_self(), g_main_host);
+        id_marker = t_marker;
+        id_self = (uint32_t)(uintptr_t)cellFiberPpuContextSelf();
+        CHECK_RC(cellFiberPpuContextReturnToThread(0), CELL_OK);
+    }
+}
+
+static ctx_ref g_id_ctx;
+static void* second_owner(void* p)
+{
+    (void)p;
+    ppu_context mine;
+    memset(&mine, 0, sizeof mine);
+    mine.thread_id = 9;
+    mine.gpr[13] = 0x9000;
+    g_active_ctx = &mine;
+    run(g_id_ctx, NULL);
+    g_active_ctx = NULL;
+    return NULL;
+}
+
+/* A host thread with no PPU thread context: the context must not keep the last owner's identity. */
+static void* no_owner(void* p)
+{
+    (void)p;
+    g_active_ctx = NULL;
+    run(g_id_ctx, NULL);
+    return NULL;
+}
+
+static void case_identity(void)
+{
+    CHECK(cellFiberPpuContextSelf() == NULL);
+    t_marker = 42;
+    g_main_host = pthread_self();
+    g_id_ctx = new_context(id_entry, 0);
+    run(g_id_ctx, NULL);
+    CHECK(id_tid == 5 && id_r13 == 0x7000);
+    CHECK(id_other_host);
+    CHECK(id_marker == 0);
+    CHECK(id_self == g_id_ctx.ea);
+    pthread_t th;
+    pthread_create(&th, NULL, second_owner, NULL);
+    pthread_join(th, NULL);
+    CHECK(id_tid == 9 && id_r13 == 0x9000);
+    pthread_create(&th, NULL, no_owner, NULL);
+    pthread_join(th, NULL);
+    CHECK(id_tid == 0x7FFF0000ull && id_r13 == 0);   /* FIBER_FALLBACK_THREAD_ID, no TLS */
+    run(g_id_ctx, NULL);
+    CHECK(id_tid == 5 && id_r13 == 0x7000);
+    CHECK(cellFiberPpuContextSelf() == NULL);
+    /* the context's ppu_context joined the reservation set */
+    int found = 0;
+    for (int i = 0; i < g_resv_n && i < 64; i++) if (g_resv[i] && g_resv[i]->thread_id == 5) found = 1;
+    CHECK(found);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(g_id_ctx)), CELL_OK);
+    CHECK(wait_threads(0));
+    printf("[case identity] ok\n");
+}
+
+/* ---------------------------------------------------------------------------
+ * Case 6: Finalize frees host threads
+ * -----------------------------------------------------------------------*/
+static int fin_after;
+static void fin_entry(ppu_context* ctx)
+{
+    (void)ctx;
+    CHECK_RC(cellFiberPpuContextReturnToThread(3), CELL_OK);
+    fin_after++;               /* never reached: finalized while suspended */
+}
+static ctx_ref fin_b;
+static void fin_switch_entry(ppu_context* ctx)
+{
+    (void)ctx;
+    CHECK_RC(cellFiberPpuContextSwitch(CTX(fin_b), NULL, NULL), CELL_OK);
+    fin_after++;
+}
+
+static void case_finalize(void)
+{
+    fin_after = 0;
+    ctx_ref never = new_context(fin_entry, 0);
+    ctx_ref susp  = new_context(fin_entry, 0);
+    fin_b         = new_context(fin_entry, 0);
+    ctx_ref sw    = new_context(fin_switch_entry, 0);
+    CHECK(ps3_fiber_context_host_threads() == 4);
+    CHECK(run(susp, NULL) == 3);
+    CHECK(run(sw, NULL) == 3);         /* sw switched to fin_b, which returned to the thread */
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(never)), CELL_OK);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(susp)), CELL_OK);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(sw)), CELL_OK);      /* suspended in Switch */
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(fin_b)), CELL_OK);
+    CHECK(wait_threads(0));
+    CHECK(fin_after == 0);
+    /* finalized: unknown again, and the memory can hold a new context */
+    uint32_t cs = guest_alloc(4, 4);
+    CHECK_RC(cellFiberPpuContextRun(CTX(susp), GP(cs), NULL, NULL), CELL_FIBER_ERROR_INVAL);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(susp)), CELL_FIBER_ERROR_INVAL);
+    CHECK_RC(cellFiberPpuContextInitialize(CTX(susp), entry_of(fin_entry), 0, GP(susp.stack), STACK_SIZE, NULL),
+             CELL_OK);
+    CHECK(run(susp, NULL) == 3);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(susp)), CELL_OK);
+    /* many contexts in turn: the host records are reused, not one per Initialize */
+    int resv_before = g_resv_n;
+    for (int i = 0; i < 50; i++) {
+        CHECK_RC(cellFiberPpuContextInitialize(CTX(susp), entry_of(fin_entry), 0, GP(susp.stack), STACK_SIZE, NULL),
+                 CELL_OK);
+        CHECK(run(susp, NULL) == 3);
+        CHECK_RC(cellFiberPpuContextFinalize(CTX(susp)), CELL_OK);
+    }
+    CHECK(g_resv_n <= resv_before + 1);
+    CHECK(wait_threads(0));
+    printf("[case finalize] ok\n");
+}
+
+/* ---------------------------------------------------------------------------
+ * Case 7: error codes
+ * -----------------------------------------------------------------------*/
+static ctx_ref err_ctx, err_other;
+static s32 err_run_inside, err_switch_self, err_switch_unknown, err_switch_ended, err_fin_self;
+static s32 err_run_other_host, err_fin_other_host, err_stack_ok, err_stack_over;
+
+static void* poke_running(void* p)
+{
+    (void)p;
+    uint32_t cs = guest_alloc(4, 4);
+    err_run_other_host = cellFiberPpuContextRun(CTX(err_ctx), GP(cs), NULL, NULL);
+    err_fin_other_host = cellFiberPpuContextFinalize(CTX(err_ctx));
+    return NULL;
+}
+
+static void err_entry(ppu_context* ctx)
+{
+    uint32_t cs = guest_alloc(4, 4);
+    err_run_inside     = cellFiberPpuContextRun(CTX(err_other), GP(cs), NULL, NULL);
+    err_switch_self    = cellFiberPpuContextSwitch(CTX(err_ctx), NULL, NULL);
+    err_switch_unknown = cellFiberPpuContextSwitch(GP(guest_alloc(CELL_FIBER_PPU_CONTEXT_SIZE, 16)), NULL, NULL);
+    err_switch_ended   = cellFiberPpuContextSwitch(CTX(c1), NULL, NULL);   /* finalized in case 1: unknown */
+    err_fin_self       = cellFiberPpuContextFinalize(CTX(err_ctx));
+    pthread_t th;
+    pthread_create(&th, NULL, poke_running, NULL);
+    pthread_join(th, NULL);
+    err_stack_ok = cellFiberPpuContextCheckStackLimit();
+    uint64_t sp = ctx->gpr[1];
+    ctx->gpr[1] = err_ctx.stack - 0x10;                    /* below the stack: overflowed */
+    err_stack_over = cellFiberPpuContextCheckStackLimit();
+    ctx->gpr[1] = sp;
+}
+
+static void case_errors(void)
+{
+    const uint32_t stack = guest_alloc(STACK_SIZE, 16);
+    const uint32_t ctx   = guest_alloc(CELL_FIBER_PPU_CONTEXT_SIZE, 16);
+    const uint32_t attr  = guest_alloc(CELL_FIBER_PPU_CONTEXT_ATTRIBUTE_SIZE, 8);
+    const uint32_t e     = entry_of(fin_entry);
+
+    CHECK_RC(_cellFiberPpuContextAttributeInitialize(NULL, 0), CELL_FIBER_ERROR_NULL_POINTER);
+    CHECK_RC(_cellFiberPpuContextAttributeInitialize(GP(attr + 4), 0), CELL_FIBER_ERROR_ALIGN);
+    memset(g_guest_mem + attr, 0xFF, CELL_FIBER_PPU_CONTEXT_ATTRIBUTE_SIZE);
+    CHECK_RC(_cellFiberPpuContextAttributeInitialize(GP(attr), 0x330000), CELL_OK);
+    { int zero = 1; for (unsigned k = 0; k < CELL_FIBER_PPU_CONTEXT_ATTRIBUTE_SIZE; k++) if (g_guest_mem[attr + k]) zero = 0;
+      CHECK(zero); }
+
+    CHECK_RC(cellFiberPpuContextInitialize(NULL, e, 0, GP(stack), STACK_SIZE, NULL), CELL_FIBER_ERROR_NULL_POINTER);
+    CHECK_RC(cellFiberPpuContextInitialize(GP(ctx), 0, 0, GP(stack), STACK_SIZE, NULL), CELL_FIBER_ERROR_NULL_POINTER);
+    CHECK_RC(cellFiberPpuContextInitialize(GP(ctx), e, 0, NULL, STACK_SIZE, NULL), CELL_FIBER_ERROR_NULL_POINTER);
+    CHECK_RC(cellFiberPpuContextInitialize(GP(ctx + 8), e, 0, GP(stack), STACK_SIZE, NULL), CELL_FIBER_ERROR_ALIGN);
+    CHECK_RC(cellFiberPpuContextInitialize(GP(ctx), e, 0, GP(stack), 0x100, NULL), CELL_FIBER_ERROR_INVAL);
+    CHECK_RC(cellFiberPpuContextInitialize(GP(ctx), e, 0, GP(stack), STACK_SIZE, NULL), CELL_OK);
+    CHECK_RC(cellFiberPpuContextInitialize(GP(ctx), e, 0, GP(stack), STACK_SIZE, NULL), CELL_FIBER_ERROR_STAT);
+    CHECK_RC(cellFiberPpuContextFinalize(GP(ctx)), CELL_OK);
+
+    uint32_t cs = guest_alloc(4, 4);
+    CHECK_RC(cellFiberPpuContextRun(NULL, GP(cs), NULL, NULL), CELL_FIBER_ERROR_NULL_POINTER);
+    CHECK_RC(cellFiberPpuContextRun(GP(ctx), NULL, NULL, NULL), CELL_FIBER_ERROR_NULL_POINTER);
+    CHECK_RC(cellFiberPpuContextRun(GP(ctx + 4), GP(cs), NULL, NULL), CELL_FIBER_ERROR_ALIGN);
+    CHECK_RC(cellFiberPpuContextRun(GP(ctx), GP(cs), NULL, NULL), CELL_FIBER_ERROR_INVAL);   /* not initialized */
+    CHECK_RC(cellFiberPpuContextFinalize(NULL), CELL_FIBER_ERROR_NULL_POINTER);
+    CHECK_RC(cellFiberPpuContextFinalize(GP(ctx + 4)), CELL_FIBER_ERROR_ALIGN);
+    CHECK_RC(cellFiberPpuContextFinalize(GP(ctx)), CELL_FIBER_ERROR_INVAL);
+
+    /* calls that only a context may make */
+    CHECK_RC(cellFiberPpuContextSwitch(GP(ctx), NULL, NULL), CELL_FIBER_ERROR_PERM);
+    CHECK_RC(cellFiberPpuContextReturnToThread(0), CELL_FIBER_ERROR_PERM);
+    CHECK_RC(cellFiberPpuContextCheckStackLimit(), CELL_FIBER_ERROR_PERM);
+
+    err_ctx   = new_context(err_entry, 0);
+    err_other = new_context(fin_entry, 0);
+    CHECK(run(err_ctx, NULL) == 0);
+    CHECK((u32)err_run_inside     == CELL_FIBER_ERROR_PERM);
+    CHECK((u32)err_switch_self    == CELL_FIBER_ERROR_STAT);
+    CHECK((u32)err_switch_unknown == CELL_FIBER_ERROR_INVAL);
+    CHECK((u32)err_switch_ended   == CELL_FIBER_ERROR_INVAL);
+    CHECK((u32)err_fin_self       == CELL_FIBER_ERROR_STAT);
+    CHECK((u32)err_run_other_host == CELL_FIBER_ERROR_STAT);
+    CHECK((u32)err_fin_other_host == CELL_FIBER_ERROR_STAT);
+    CHECK(err_stack_ok == CELL_OK);
+    CHECK((u32)err_stack_over     == CELL_FIBER_ERROR_STAT);
+    /* a Switch to an ended context */
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(err_ctx)), CELL_OK);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(err_other)), CELL_OK);
+    CHECK(wait_threads(0));
+    printf("[case errors] ok\n");
+}
+
+/* An ended context refuses a Switch with STAT. */
+static ctx_ref se_ended;
+static s32 se_rc;
+static void se_entry(ppu_context* ctx)
+{
+    (void)ctx;
+    se_rc = cellFiberPpuContextSwitch(CTX(se_ended), NULL, NULL);
+}
+static void noop_entry(ppu_context* ctx) { (void)ctx; }
+
+static void case_switch_ended(void)
+{
+    se_ended = new_context(noop_entry, 0);
+    CHECK(run(se_ended, NULL) == 0);
+    ctx_ref s = new_context(se_entry, 0);
+    CHECK(run(s, NULL) == 0);
+    CHECK((u32)se_rc == CELL_FIBER_ERROR_STAT);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(se_ended)), CELL_OK);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(s)), CELL_OK);
+    CHECK(wait_threads(0));
+    printf("[case switch-ended] ok\n");
+}
+
+/* ---------------------------------------------------------------------------
+ * Case 8: timing
+ * -----------------------------------------------------------------------*/
+#define ROUNDS 20000
+static void loop_entry(ppu_context* ctx)
+{
+    (void)ctx;
+    for (;;) cellFiberPpuContextReturnToThread(0);
+}
+static ctx_ref pp_a, pp_b;
+static void pp_a_entry(ppu_context* ctx)
+{
+    (void)ctx;
+    for (;;) cellFiberPpuContextSwitch(CTX(pp_b), NULL, NULL);
+}
+static int pp_n;
+static void pp_b_entry(ppu_context* ctx)
+{
+    (void)ctx;
+    for (;;) {
+        if (++pp_n == ROUNDS) cellFiberPpuContextReturnToThread(0);
+        cellFiberPpuContextSwitch(CTX(pp_a), NULL, NULL);
+    }
+}
+
+static double now_us(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1e6 + ts.tv_nsec / 1e3;
+}
+
+static void case_timing(void)
+{
+    ctx_ref r = new_context(loop_entry, 0);
+    double t0 = now_us();
+    for (int i = 0; i < ROUNDS; i++) run(r, NULL);
+    double t1 = now_us();
+    pp_a = new_context(pp_a_entry, 0);
+    pp_b = new_context(pp_b_entry, 0);
+    pp_n = 0;
+    double t2 = now_us();
+    run(pp_a, NULL);
+    double t3 = now_us();
+    CHECK(pp_n == ROUNDS);
+    printf("[case timing] Run+ReturnToThread round trip %.2f us; Switch A->B->A %.2f us\n",
+           (t1 - t0) / ROUNDS, (t3 - t2) / ROUNDS);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(r)), CELL_OK);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(pp_a)), CELL_OK);
+    CHECK_RC(cellFiberPpuContextFinalize(CTX(pp_b)), CELL_OK);
+    CHECK(wait_threads(0));
+}
+
+/* ---------------------------------------------------------------------------
+ * "exit": leave contexts suspended and return from main
+ * -----------------------------------------------------------------------*/
+static ctx_ref ex_b;
+static void ex_switch_entry(ppu_context* ctx)
+{
+    (void)ctx;
+    cellFiberPpuContextSwitch(CTX(ex_b), NULL, NULL);
+}
+
+static int exit_with_suspended(void)
+{
+    ctx_ref a = new_context(loop_entry, 0);
+    ex_b = new_context(loop_entry, 0);
+    ctx_ref s = new_context(ex_switch_entry, 0);
+    (void)new_context(loop_entry, 0);              /* never run */
+    run(a, NULL);
+    run(s, NULL);                                  /* s suspended in Switch, ex_b in ReturnToThread */
+    printf("[exit] returning from main with %d context host threads\n", ps3_fiber_context_host_threads());
+    fflush(stdout);
+    return g_fails ? 1 : 0;
+}
+
+int main(int argc, char** argv)
+{
+    alarm(60);                                     /* a deadlock fails the run instead of hanging it */
+    memset(&g_main_ctx, 0, sizeof g_main_ctx);
+    g_main_ctx.thread_id = 5;
+    g_main_ctx.gpr[13] = 0x7000;
+    g_active_ctx = &g_main_ctx;
+    if (argc > 1 && strcmp(argv[1], "exit") == 0) return exit_with_suspended();
+
+    case_entry_returns();
+    case_return_to_thread();
+    case_switch();
+    case_identity();
+    case_finalize();
+    case_errors();
+    case_switch_ended();
+    case_timing();
+    if (g_fails) {
+        fprintf(stderr, "%d check(s) failed\n", g_fails);
+        return 1;
+    }
+    printf("PASS\n");
+    return 0;
+}
