+def _sjlj_rewrite(func, body, prefix, setjmp_addrs, longjmp_addrs):
+    """Guest setjmp/longjmp across lifted host frames (runtime/ppu/ppu_sjlj.h).
+
+    Every direct call `func_<S>(ctx);` to a --setjmp function S becomes
+    PPU_SJLJ_SETJMP(ctx, _sjf[k], func_<S>), with the zeroed frame array
+    _sjf[N] declared at the top of the calling function so it lives as long as
+    that host frame, and every `return;` of that function first drops its
+    frames (ppu_sjlj_leave). A --longjmp function records its jmp_buf (r3) on
+    entry and ends every plain `return;` in ppu_sjlj_longjmp, which
+    host-longjmps to the newest setjmp frame for that buffer once the guest code
+    has restored the registers. Returns the new body and the number of frames.
+
+    Invariant: no C local of a lifted function may change between the setjmp
+    call and the longjmp (it would be indeterminate after the host longjmp).
+    The lifter keeps guest state in ctx and writes the _cs_ snapshots only at
+    function entry; anything that caches guest registers in locals must make
+    them volatile in functions with setjmp frames."""
+    if not setjmp_addrs and func.start_addr not in longjmp_addrs:
+        return body, 0
+    out, frames = [], 0
+    for line in body:
+        for s_ea in setjmp_addrs:
+            call = f"{prefix}func_{s_ea:08X}(ctx);"
+            while call in line:
+                line = line.replace(call, f"PPU_SJLJ_SETJMP(ctx, _sjf[{frames}], {prefix}func_{s_ea:08X});", 1)
+                frames += 1
+        if func.start_addr in longjmp_addrs and line.strip() == "return;":
+            line = line.replace("return;", "ppu_sjlj_longjmp(ctx, _sjbuf); return;")
+        out.append(line)
+    if frames:
+        out = [sjlj_leave_returns(line, frames) for line in out]
+    head = [f"ppu_sjlj_frame _sjf[{frames}] = {{}};"] if frames else []
+    if func.start_addr in longjmp_addrs:
+        head.append("const uint32_t _sjbuf = (uint32_t)ctx->gpr[3];")
+    return head + out, frames
+
+
+_RETURN_RE = re.compile(r"\breturn;")
+
+
+def sjlj_leave_returns(line, frames):
+    """Every `return;` of a function holding setjmp frames drops them first."""
+    if not frames:
+        return line
+    return _RETURN_RE.sub(f"{{ ppu_sjlj_leave(_sjf, {frames}); return; }}", line)
+
+
+def sjlj_unrewritten_longjmps(lifter):
+    """--longjmp addresses that no lifted function starts at (so got no rewrite)."""
+    starts = {f.start_addr for f in lifter.functions}
+    return sorted(a for a in getattr(lifter, "longjmp_addrs", ()) if a not in starts)
+
