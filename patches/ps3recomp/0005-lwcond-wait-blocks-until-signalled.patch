 /* sys_lwcond (sysPrxForUser) — guest-side condition variable, paired with an
- * lwmutex. The CRT and (newly) libsre's cellSpurs create/wait/signal these. Like
- * sys_lwmutex above, model it directly in guest memory so the args stay GUEST
- * EAs (the generic adapter would pass them raw and the C sysPrxForUser impl
- * deref'd them as host pointers -> AV during cellSpurs init). A no-op wait is
- * adequate here: the CRT/SPURS paths that reach us use these for one-shot init
- * handshakes, not long-term blocking. sys_lwcond_t is 8 bytes: +0x00 u32
- * lwmutex EA, +0x04 u32 lwcond queue id. Titles read +0x00 themselves (an
- * lwcond whose lwmutex reads 0 is treated as invalid). */
+ * lwmutex. Modelled directly in guest memory like sys_lwmutex above, so the
+ * args stay GUEST EAs. sys_lwcond_t is 8 bytes: +0x00 u32 lwmutex EA, +0x04
+ * u32 lwcond queue id. Titles read +0x00 themselves (an lwcond whose lwmutex
+ * reads 0 is treated as invalid).
+ *
+ * The wait BLOCKS until a signal or its timeout, as lv2's does, and signals
+ * wake waiters. It used to be a 1 ms poll with no-op signals, which is a
+ * spurious wakeup on every wait: a title whose wait has no predicate loop
+ * then runs on state nobody published. Gran Turismo 6's event object
+ * (func_00A5F3DC: "if not signalled, waiting = 1; lwcond_wait; waiting = 0")
+ * woke its file worker with no request posted, and the worker wrote through
+ * the NULL request. Semantics follow RPCS3's sys_lwcond_.cpp and
+ * lv2/sys_lwcond.cpp (GPL-2.0): waiting without holding the lwmutex is
+ * CELL_EPERM; the timeout is in microseconds, 0 forever, and expiry answers
+ * CELL_ETIMEDOUT with the lwmutex held again; a signal with no waiter is lost
+ * and answers CELL_OK; signal_to a thread that is not waiting is CELL_EPERM,
+ * to one that does not exist CELL_ESRCH; destroying an lwcond with a thread
+ * asleep on it is CELL_EBUSY. A signal wakes by the lwmutex protocol: the
+ * highest-priority waiter (SYS_SYNC_PRIORITY, the default), or the oldest
+ * (SYS_SYNC_FIFO).
+ * A waiter queues itself before it lets go of the lwmutex, so a signal sent
+ * the moment the lwmutex is free cannot be missed. */
+/* lwcond-waiters: begin */
+/* Whether thread `tid` exists, and its priority (runtime/syscalls/sys_ppu_thread.c). */
+extern "C" int ppu_thread_query(uint64_t tid, int32_t* prio);
+struct LwcWaiter {
+    uint32_t lwcond; uint32_t tid; int32_t prio; uint32_t protocol; bool woken; LwcWaiter* next;
+};
+/* Leaked on purpose: guest threads may still sit in a wait while exit() runs
+ * the static destructors, and a destroyed mutex under a waiter is undefined. */
+static std::mutex& g_lwc_mu = *new std::mutex;
+static std::condition_variable& g_lwc_cv = *new std::condition_variable;
+static LwcWaiter* g_lwc_head = nullptr;          /* queue order, oldest first */
+/* Queue the calling thread on `lwcond`. The wake order is the protocol of the
+ * paired lwmutex, as lv2 takes it at sys_lwcond_create: SYS_SYNC_FIFO (1) wakes
+ * the oldest waiter, every other protocol the highest priority (lowest number,
+ * the oldest among equals); SYS_SYNC_RETRY is SYS_SYNC_PRIORITY for an lwcond. */
+static void lwc_enqueue(LwcWaiter* w, uint32_t lwcond, uint32_t tid, uint32_t lwmutex_attr)
+{
+    int32_t prio = 1000;
+    ppu_thread_query(tid, &prio);
+    w->lwcond = lwcond; w->tid = tid; w->prio = prio;
+    w->protocol = lwmutex_attr & 0xF; w->woken = false; w->next = nullptr;
+    std::lock_guard<std::mutex> hold(g_lwc_mu);
+    LwcWaiter** pp = &g_lwc_head;
+    while (*pp) pp = &(*pp)->next;
+    *pp = w;
+}
+/* Wake the next waiter on `lwcond` by its protocol (tid 0xFFFFFFFF), the
+ * waiting thread `tid`, or with `all` every one. Returns how many were woken. */
+static int lwc_wake(uint32_t lwcond, uint32_t tid, bool all)
+{
+    int n = 0;
+    {
+        std::lock_guard<std::mutex> hold(g_lwc_mu);
+        LwcWaiter* pick = nullptr;
+        for (LwcWaiter* w = g_lwc_head; w; w = w->next) {
+            if (w->lwcond != lwcond || w->woken) continue;
+            if (all) { w->woken = true; n++; continue; }
+            if (tid != 0xFFFFFFFFu) { if (w->tid == tid) { pick = w; break; } continue; }
+            if (!pick) { pick = w; if (w->protocol == 1) break; continue; }
+            if (w->prio < pick->prio) pick = w;     /* strictly higher: the older keeps a tie */
+        }
+        if (pick) { pick->woken = true; n = 1; }
+    }
+    if (n) g_lwc_cv.notify_all();
+    return n;
+}
+/* Whether any thread is still asleep on `lwcond`. */
+static bool lwc_has_waiters(uint32_t lwcond)
+{
+    std::lock_guard<std::mutex> hold(g_lwc_mu);
+    for (LwcWaiter* w = g_lwc_head; w; w = w->next)
+        if (w->lwcond == lwcond && !w->woken) return true;
+    return false;
+}
+/* Block until woken or `timeout_us` passes (0 = forever), then leave the
+ * queue. Returns whether a signal woke it. */
+static bool lwc_block(LwcWaiter* w, uint64_t timeout_us)
+{
+    std::unique_lock<std::mutex> hold(g_lwc_mu);
+    if (timeout_us)
+        g_lwc_cv.wait_for(hold, std::chrono::microseconds(timeout_us), [w] { return w->woken; });
+    else
+        g_lwc_cv.wait(hold, [w] { return w->woken; });
+    for (LwcWaiter** pp = &g_lwc_head; *pp; pp = &(*pp)->next)
+        if (*pp == w) { *pp = w->next; break; }
+    return w->woken;
+}
+/* lwcond-waiters: end */
 static void sys_lwcond_create(ppu_context* ctx)
 {
     static uint32_t s_lwcond_id = 0x4C000000u;
@@ -408,30 +493,59 @@
     vm_write32(lwcond + 0x04, ++s_lwcond_id);
     ctx->gpr[3] = 0;
 }
-static void sys_lwcond_destroy(ppu_context* ctx)    { ctx->gpr[3] = 0; }
-static void sys_lwcond_signal(ppu_context* ctx)     { ctx->gpr[3] = 0; }
-static void sys_lwcond_signal_all(ppu_context* ctx) { ctx->gpr[3] = 0; }
-static void sys_lwcond_signal_to(ppu_context* ctx)  { ctx->gpr[3] = 0; }
-/* Now that the lwmutex is REAL, a no-op wait that keeps holding it deadlocks the
- * signaler. Release the paired lwmutex, wait briefly, reacquire (poll-style: the
- * guest's while(!predicate) loop re-checks; signalers stay no-ops). Handles the
- * common single (non-recursive) hold. */
+/* lv2 refuses to destroy an lwcond a thread still sleeps on (CELL_EBUSY). */
+static void sys_lwcond_destroy(ppu_context* ctx)
+{
+    ctx->gpr[3] = lwc_has_waiters((uint32_t)ctx->gpr[3]) ? (uint64_t)(int64_t)(int32_t)0x8001000Au : 0;  /* CELL_EBUSY */
+}
+static void sys_lwcond_signal(ppu_context* ctx)
+{
+    lwc_wake((uint32_t)ctx->gpr[3], 0xFFFFFFFFu, false);
+    ctx->gpr[3] = 0;
+}
+static void sys_lwcond_signal_all(ppu_context* ctx)
+{
+    lwc_wake((uint32_t)ctx->gpr[3], 0xFFFFFFFFu, true);
+    ctx->gpr[3] = 0;
+}
+static void sys_lwcond_signal_to(ppu_context* ctx)
+{
+    const uint32_t tid = (uint32_t)ctx->gpr[4];
+    const int n = lwc_wake((uint32_t)ctx->gpr[3], tid, false);
+    int32_t prio;
+    if (n || tid == 0xFFFFFFFFu)
+        ctx->gpr[3] = 0;
+    else if (!ppu_thread_query(tid, &prio))
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x80010005u;   /* CELL_ESRCH: no such thread */
+    else
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x80010009u;   /* CELL_EPERM: not waiting */
+}
 static void sys_lwcond_wait(ppu_context* ctx)
 {
     uint32_t lwcond  = (uint32_t)ctx->gpr[3];
+    uint64_t timeout = ctx->gpr[4];
     uint32_t lwmutex = vm_read32(lwcond + 0x00);
     struct LwmSlot* sl = lwm_slot(lwmutex);
     if (sl) {
+        uint32_t self = LWM_SELF(ctx);
         uint32_t own = vm_read32(lwmutex + LWM_OWNER);
         uint32_t rc  = vm_read32(lwmutex + LWM_RECUR);
+        if (own != self || rc == 0) {
+            ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x80010009u;   /* CELL_EPERM */
+            return;
+        }
+        LwcWaiter w;
+        lwc_enqueue(&w, lwcond, self, vm_read32(lwmutex + LWM_ATTR));
         vm_write32(lwmutex + LWM_RECUR, 0);
         vm_write32(lwmutex + LWM_OWNER, 0);
         ppu_thread_note_block(ctx->thread_id);
         lwm_release(sl);
-        Sleep(1);
+        const bool woken = lwc_block(&w, timeout);
         lwm_acquire(sl, 0);
         vm_write32(lwmutex + LWM_OWNER, own);
-        vm_write32(lwmutex + LWM_RECUR, rc ? rc : 1);
+        vm_write32(lwmutex + LWM_RECUR, rc);
+        ctx->gpr[3] = woken ? 0 : (uint64_t)(int64_t)(int32_t)0x8001000Bu;   /* CELL_ETIMEDOUT */
+        return;
     }
     ctx->gpr[3] = 0;
 }
