From: Gran Turismo 6 for Mac <https://github.com/Wooloomooloo2/Gran-Turismo-6-Mac>
Subject: [PATCH] ppu_lifter: jump tables whose base is a lis/addi constant

Upstream: not yet submitted
Base: ps3recomp 4e8f3ca87a3e1d87bb83b8b7e9348fe2685cd514 (after 0001-0002)

What: discover_jump_tables() accepts a table base register whose nearest
definition is `addi rB,rB,lo` preceded by `lis rB,hi`: the table address is
that constant, read once, independent of the TOC candidates.

Why: Gran Turismo 6 builds many switch tables position-dependently
(`lis r9,0xA4; addi r9,r9,-208; lwzx r0,r11,r9; extsw; add r0,r0,r9;
mtctr r0; bctr`, the table inline after the bctr). Only TOC-loaded bases
were accepted, so every such dispatcher was dropped and each case lifted to
an unresolved indirect call (func_00A3FEE0, func_00A6D80C and others at boot).
Also makes the debug trace print a missing TOC candidate as 0.

Test: tools/test_ppu_jumptables.py test_constant_table_base.

--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -4650,7 +4650,7 @@
                 continue
             break
         for cand in _cands:
-            disp = None; r_base = None; base_is_ld = False
+            disp = None; r_base = None; base_is_ld = False; const_base = None
             disp2 = None; disp2_is_ld = False
             # Walk backward to the NEAREST instruction that defines `cand`, and
             # accept it as the table base only if that definition is a TOC load
@@ -4716,6 +4716,23 @@
                                 disp = mem_disp(b[1]); r_base = cand
                                 base_is_ld = (w2.mnemonic == 'ld')
                             break               # nearest definition wins, TOC load or not
+                elif w.mnemonic == 'addi' and len(a) == 3 and a[1] == cand:
+                    # CONSTANT base: `lis cand,hi; addi cand,cand,lo` puts the
+                    # table's own address in the register, no TOC involved
+                    # (Gran Turismo 6 func_00A3FEE0: a 7-entry offset table
+                    # inline after its bctr). Rejected as a non-TOC definition,
+                    # every case lifted to an unresolved indirect call.
+                    for w2 in reversed([x for x in win_cand if x.addr < w.addr]):
+                        b = [x.strip() for x in w2.operands.split(',')]
+                        if not b or b[0] != cand or w2.mnemonic.startswith(('st', 'lf')):
+                            continue
+                        if w2.mnemonic == 'lis' and len(b) == 2:
+                            try:
+                                const_base = ((int(b[1], 0) << 16) + int(a[2], 0)) & 0xFFFFFFFF
+                                r_base = cand
+                            except ValueError:
+                                pass
+                        break                   # nearest def wins, constant or not
                 elif w.mnemonic in ('lwz', 'ld') and len(a) == 2 and '(' in a[1]:
                     # TWO-LEVEL base: `lwz r30, d1(r2); lwz r11, d2(r30)`. The
                     # table address is not in the TOC itself but in a global the
@@ -4751,15 +4768,15 @@
                             break
                         _scan = _live(_scan_lo(i), i)
                 break                           # first definition of cand wins/loses
-            if disp is not None:
-                _bases.append((r_base, disp, base_is_ld, disp2, disp2_is_ld))
+            if disp is not None or const_base is not None:
+                _bases.append((r_base, disp, base_is_ld, disp2, disp2_is_ld, const_base))
         _dbg(all_insns[i].addr, f"bases={_bases} toc={toc}")
-        if not _bases or not toc:
+        if not _bases or (not toc and all(b[5] is None for b in _bases)):
             continue
         toc_candidates = toc if isinstance(toc, (list, tuple)) else [toc]
         best = []
         best_key = (0, 0)
-        for r_base, disp, base_is_ld, disp2, disp2_is_ld in _bases:
+        for r_base, disp, base_is_ld, disp2, disp2_is_ld, const_base in _bases:
             # offset table iff an `add rC, *, r_base` combines the loaded value + base
             is_offset = any(
                 w.mnemonic == 'add' and
@@ -4841,8 +4858,8 @@
             # with. We don't track per-function TOCs here, so try each candidate
             # and keep the one whose table decodes to the most in-text case
             # targets (a wrong TOC reads unrelated data and validates 0 targets).
-            for cand in toc_candidates:
-                if not cand:
+            for cand in (toc_candidates if const_base is None else [None]):
+                if not cand and const_base is None:
                     continue
                 def _read_ptr(_ea, _is_ld):
                     # ELFv1 TOC entries are 64-bit; a table address always fits the
@@ -4853,10 +4870,11 @@
                     if read_u32(_ea):
                         return None
                     return read_u32((_ea + 4) & 0xFFFFFFFF)
-                table_base = _read_ptr(cand + disp, base_is_ld)
+                table_base = (const_base if const_base is not None
+                              else _read_ptr(cand + disp, base_is_ld))
                 if table_base is not None and disp2 is not None:
                     table_base = _read_ptr(table_base + disp2, disp2_is_ld)
-                _dbg(all_insns[i].addr, f"r_base={r_base} cand_toc=0x{cand:X} table_base={None if table_base is None else hex(table_base)} count={count} is_offset={is_offset} text=[0x{text_lo:X},0x{text_hi:X})")
+                _dbg(all_insns[i].addr, f"r_base={r_base} cand_toc=0x{cand or 0:X} table_base={None if table_base is None else hex(table_base)} count={count} is_offset={is_offset} text=[0x{text_lo:X},0x{text_hi:X})")
                 if table_base is None:
                     continue
                 targets = []
