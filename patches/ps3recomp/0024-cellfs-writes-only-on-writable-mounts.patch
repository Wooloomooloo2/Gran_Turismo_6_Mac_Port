+            CHECK(r == 0x80010009u && !exists("bdvd/none"), "O_CREAT of a missing /dev_bdvd file is EPERM (0x%08X)", r);
+            r = open_("/host_root/new", WRONLY | CREAT);
+            CHECK(r == 0x8001003Au && count("bdvd") == bdvd_n, "create on /host_root is ENOTMOUNTED (0x%08X)", r);
+            r = open_("/new", WRONLY | CREAT);
+            CHECK(r == 0x8001003Au && count("bdvd") == bdvd_n, "create on no device is ENOTMOUNTED (0x%08X)", r);
+            r = open_("/", WRONLY | CREAT);
+            CHECK(r == 0x80010012u, "create of '/' is EISDIR (0x%08X)", r);
+            r = open_("/dev_hdd0/link/new", WRONLY | CREAT);
+            CHECK(r == 0x80010009u && count("outside") == outside_n, "create through a symlink out of /dev_hdd0 is EPERM (0x%08X)", r);
+            r = open_("/dev_hdd0/nodir/new", WRONLY | CREAT);
+            CHECK(r == 0x80010006u && !exists("hdd0/nodir"), "create in a missing folder is ENOENT (0x%08X)", r);
+            r = open_("/dev_hdd0/game/T/USRDIR/keep", WRONLY | CREAT | TRUNC);
+            CHECK(r == 0 && exists("hdd0/game/T/USRDIR/keep") && size_of("bdvd/PS3_GAME/USRDIR/keep") == 4,
+                  "create of a /dev_hdd0 USRDIR file makes it there; the disc file it would fall back to is kept (0x%08X)", r);
+            r = open_("/dev_hdd0/./p/../new", RDWR | CREAT);
+            CHECK(r == 0 && exists("hdd0/new"), "create on a canonical path inside /dev_hdd0 (0x%08X)", r);
+            r = open_("/dev_hdd0/new", RDWR | CREAT | EXCL);
+            CHECK(r == 0x80010014u, "O_CREAT|O_EXCL of an existing file is EEXIST (0x%08X)", r);
+            r = open_("/dev_hdd0/new/", RDWR);
+            CHECK(r == 0x8001002Eu, "write open of a file with a trailing '/' is ENOTDIR (0x%08X)", r);
+            r = call2(rn, "/dev_hdd0/new/", "/dev_hdd0/new2");
+            CHECK(r == 0x8001002Eu && exists("hdd0/new"), "rename of a file with a trailing '/' is ENOTDIR (0x%08X)", r);
+            r = open_("/dev_hdd0/p", RDWR);
+            CHECK(r == 0x80010012u, "write access to a folder is EISDIR (0x%08X)", r);
+            r = open_("/dev_hdd1/c", RDWR | TRUNC);
+            CHECK(r == 0 && size_of("hdd1/c") == 0, "O_TRUNC in /dev_hdd1 cuts the file (0x%08X)", r);
+            CHECK(count("bdvd") == bdvd_n && size_of("bdvd/x") == 4 && count("outside") == outside_n,
+                  "the disc folder and the folder outside are unchanged");
         }
         snprintf(p, sizeof p, "rm -rf '%s'", base);
         (void)!system(p);
