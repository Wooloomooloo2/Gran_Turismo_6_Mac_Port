diff --git a/tools/test_cellfiber_ppu.py b/tools/test_cellfiber_ppu.py
new file mode 100644
index 00000000..53969d86
--- /dev/null
+++ b/tools/test_cellfiber_ppu.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""cellFiber's PPU fibers (libs/spurs/cellFiber.c).
+
+Builds libs/spurs/tests/test_fiber_context.c, the cellFiberPpuContext* suite (Run,
+Switch, ReturnToThread, Self, Finalize, CheckStackLimit, the error codes), with
+cellFiber.c and runs it; then runs it again with "exit", which leaves contexts
+suspended and returns from main, under a timeout, so a process that cannot exit fails.
+It also builds and runs tests/fiber_switch, the scheduler API that shares the file.
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+FLAGS = ['-std=gnu17', '-O1', '-g', '-Wall', '-Wextra', '-Werror', '-Wno-unused-parameter',
+         '-Wno-deprecated-declarations', '-pthread']
+
+
+def build(cc, out, *sources, includes=()):
+    r = subprocess.run([cc, *FLAGS, *('-I' + str(ROOT / i) for i in includes),
+                        *(str(ROOT / s) for s in sources), '-o', str(out)],
+                       capture_output=True, text=True)
+    if r.returncode:
+        print(r.stdout + r.stderr)
+        print(f'FAIL: {out.name} did not build')
+    return r.returncode == 0
+
+
+def run(exe, *args, timeout):
+    try:
+        r = subprocess.run([str(exe), *args], capture_output=True, text=True, timeout=timeout)
+    except subprocess.TimeoutExpired as e:
+        out = (e.stdout or b'').decode() if isinstance(e.stdout, bytes) else (e.stdout or '')
+        print(out)
+        print(f'FAIL: {exe.name} {" ".join(args)} did not finish within {timeout} s')
+        return False
+    sys.stdout.write(r.stdout + r.stderr)
+    if r.returncode:
+        print(f'FAIL: {exe.name} {" ".join(args)} exited with {r.returncode}')
+    return r.returncode == 0
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: the fixture uses pthreads; run on macOS/Linux')
+        return 0
+    cc = os.environ.get('CC') or shutil.which('cc') or shutil.which('clang') or shutil.which('gcc')
+    if not cc:
+        print('SKIP: no C compiler')
+        return 0
+    with tempfile.TemporaryDirectory() as tmp:
+        ctx = Path(tmp) / 'test_fiber_context'
+        sched = Path(tmp) / 'fiber_switch'
+        if not build(cc, ctx, 'libs/spurs/tests/test_fiber_context.c', 'libs/spurs/cellFiber.c',
+                     includes=('libs/spurs', 'include')):
+            return 1
+        if not build(cc, sched, 'tests/fiber_switch/main.c', 'libs/spurs/cellFiber.c',
+                     includes=('libs/spurs', 'include')):
+            return 1
+        ok = run(ctx, timeout=120)
+        ok = run(ctx, 'exit', timeout=20) and ok
+        ok = run(sched, timeout=120) and ok
+        return 0 if ok else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
