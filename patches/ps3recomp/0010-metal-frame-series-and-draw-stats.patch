diff --git a/libs/video/rsx_frame_series.h b/libs/video/rsx_frame_series.h
new file mode 100644
index 00000000..a6aac65f
--- /dev/null
+++ b/libs/video/rsx_frame_series.h
@@ -0,0 +1,182 @@
+/*
+ * ps3recomp - a capped series of presented frames, and draw statistics per frame
+ *
+ * For long unattended runs, where one overwritten frame dump cannot show how a
+ * title's screen changed over minutes, nor tell a frame that was drawn from one
+ * that was only cleared:
+ *
+ *   PS3RECOMP_METAL_FRAME_DIR=<dir>   dump presented frames there as
+ *                                     frame_<presented, 6 digits>.ppm: the first
+ *                                     present, then every EVERY-th (60, 120, ...)
+ *   PS3RECOMP_METAL_FRAME_EVERY=<n>   default 60
+ *   PS3RECOMP_METAL_FRAME_MAX=<n>     at most n dumps (default 300; 0 = none)
+ *   PS3RECOMP_DRAW_STATS=<file>       one line per present:
+ *                                     "<presented> <draw calls> <clears>\n"
+ *
+ * Presents are numbered from 1. A file named STOP in the folder stops the
+ * dumps for good (a harness watching disk use creates it); the stats go on.
+ * Each dump is written to a hidden temporary name and renamed into place, so a
+ * reader never sees half a frame, and each stats line is flushed as it is
+ * written, because a long run usually ends with the process killed.
+ *
+ * The policy and the writers are plain C with no backend in them, so a test
+ * can include this header alone (libs/video/tests/test_frame_series.c). A
+ * backend keeps one rsx_frame_series, calls rsx_fs_present once per present
+ * with the frame's counts, and reads its pixels back only when told to dump.
+ * The single-file PS3RECOMP_METAL_FRAME_DUMP is separate and unchanged.
+ */
+#ifndef RSX_FRAME_SERIES_H
+#define RSX_FRAME_SERIES_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#define RSX_FS_PATH_MAX       1024
+#define RSX_FS_DEFAULT_EVERY  60u
+#define RSX_FS_DEFAULT_MAX    300u
+
+enum { RSX_FS_RUNNING = 0, RSX_FS_STOPPED_FILE = 1, RSX_FS_STOPPED_MAX = 2 };
+
+typedef struct rsx_frame_series {
+    char     dir[RSX_FS_PATH_MAX];   /* "" = no series */
+    unsigned every;                  /* dump every n-th present (>= 1) */
+    unsigned max;                    /* dumps allowed in all */
+    FILE*    stats;                  /* NULL = no statistics */
+    unsigned presented;              /* presents so far; the last one's number */
+    unsigned dumped;                 /* dumps written */
+    int      stopped;                /* RSX_FS_* */
+} rsx_frame_series;
+
+/* A count from the environment: a whole number >= min, or the default. */
+static unsigned rsx_fs_count(const char* text, unsigned dflt, unsigned min)
+{
+    if (!text || !*text) return dflt;
+    char* end = NULL;
+    long v = strtol(text, &end, 10);
+    if (*end || v < (long)min || v > 0x7FFFFFFFL) return dflt;
+    return (unsigned)v;
+}
+
+static void rsx_fs_init(rsx_frame_series* s, const char* dir, const char* every,
+                        const char* max, const char* stats_path)
+{
+    memset(s, 0, sizeof *s);
+    if (dir && *dir && strlen(dir) < RSX_FS_PATH_MAX - 32) {
+        strcpy(s->dir, dir);
+        size_t n = strlen(s->dir);
+        while (n > 1 && s->dir[n - 1] == '/') s->dir[--n] = 0;
+    }
+    s->every = rsx_fs_count(every, RSX_FS_DEFAULT_EVERY, 1);
+    s->max   = rsx_fs_count(max, RSX_FS_DEFAULT_MAX, 0);
+    if (stats_path && *stats_path) {
+        s->stats = fopen(stats_path, "w");
+        if (s->stats) setvbuf(s->stats, NULL, _IOLBF, 0);
+        else fprintf(stderr, "[frame series] cannot write draw stats to %s\n", stats_path);
+    }
+}
+
+static void rsx_fs_init_from_env(rsx_frame_series* s)
+{
+    rsx_fs_init(s, getenv("PS3RECOMP_METAL_FRAME_DIR"), getenv("PS3RECOMP_METAL_FRAME_EVERY"),
+                getenv("PS3RECOMP_METAL_FRAME_MAX"), getenv("PS3RECOMP_DRAW_STATS"));
+}
+
+static void rsx_fs_close(rsx_frame_series* s)
+{
+    if (s->stats) fclose(s->stats);
+    s->stats = NULL;
+}
+
+static int rsx_fs_stats_line(char* buf, size_t n, unsigned presented, unsigned draws,
+                             unsigned clears)
+{
+    return snprintf(buf, n, "%u %u %u\n", presented, draws, clears);
+}
+
+static int rsx_fs_frame_path(const rsx_frame_series* s, unsigned presented, char* out, size_t n)
+{
+    return snprintf(out, n, "%s/frame_%06u.ppm", s->dir, presented);
+}
+
+/* One present: number it, write its stats line, and say in *dump whether its
+ * pixels should be dumped (the caller then reads them back and calls
+ * rsx_fs_dump). Returns the present's number. */
+static unsigned rsx_fs_present(rsx_frame_series* s, unsigned draws, unsigned clears, int* dump)
+{
+    const unsigned n = ++s->presented;
+    if (s->stats) {
+        char line[48];
+        rsx_fs_stats_line(line, sizeof line, n, draws, clears);
+        fputs(line, s->stats);
+    }
+    *dump = 0;
+    if (!s->dir[0] || s->stopped) return n;
+    if (n != 1 && n % s->every != 0) return n;
+    if (s->dumped >= s->max) {
+        s->stopped = RSX_FS_STOPPED_MAX;
+        fprintf(stderr, "[frame series] %u frame(s) dumped, the PS3RECOMP_METAL_FRAME_MAX cap; "
+                        "no more dumps\n", s->dumped);
+        return n;
+    }
+    char stop[RSX_FS_PATH_MAX + 8];
+    snprintf(stop, sizeof stop, "%s/STOP", s->dir);
+    struct stat st;
+    if (stat(stop, &st) == 0) {
+        s->stopped = RSX_FS_STOPPED_FILE;
+        fprintf(stderr, "[frame series] %s exists; no more dumps (%u written)\n", stop,
+                s->dumped);
+        return n;
+    }
+    *dump = 1;
+    return n;
+}
+
+/* Write w x h pixels (4 bytes each, rows `pitch` bytes apart, BGRA when `bgra`
+ * else RGBA) as a binary PPM, through a temporary file renamed into place.
+ * 0 on success. */
+static int rsx_fs_write_ppm(const char* path, const unsigned char* px, size_t w, size_t h,
+                            size_t pitch, int bgra)
+{
+    if (!path || !px || !w || !h || pitch < w * 4) return -1;
+    char tmp[RSX_FS_PATH_MAX + 16];
+    const char* slash = strrchr(path, '/');
+    const size_t dlen = slash ? (size_t)(slash - path) + 1 : 0;
+    if (dlen + strlen(path + dlen) + 8 >= sizeof tmp) return -1;
+    snprintf(tmp, sizeof tmp, "%.*s.%s.tmp", (int)dlen, path, path + dlen);
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return -1;
+    unsigned char* row = (unsigned char*)malloc(w * 3);
+    int bad = !row || fprintf(f, "P6\n%zu %zu\n255\n", w, h) < 0;
+    for (size_t y = 0; !bad && y < h; y++) {
+        const unsigned char* src = px + y * pitch;
+        for (size_t x = 0; x < w; x++) {
+            row[x * 3 + 0] = src[x * 4 + (bgra ? 2 : 0)];
+            row[x * 3 + 1] = src[x * 4 + 1];
+            row[x * 3 + 2] = src[x * 4 + (bgra ? 0 : 2)];
+        }
+        bad = fwrite(row, 1, w * 3, f) != w * 3;
+    }
+    free(row);
+    if (fclose(f) != 0) bad = 1;
+    if (!bad && rename(tmp, path) != 0) bad = 1;
+    if (bad) remove(tmp);
+    return bad ? -1 : 0;
+}
+
+/* Dump the pixels of present `presented` into the series; counts it. */
+static int rsx_fs_dump(rsx_frame_series* s, unsigned presented, const unsigned char* px,
+                       size_t w, size_t h, int bgra)
+{
+    char path[RSX_FS_PATH_MAX + 32];
+    rsx_fs_frame_path(s, presented, path, sizeof path);
+    if (rsx_fs_write_ppm(path, px, w, h, w * 4, bgra) != 0) {
+        fprintf(stderr, "[frame series] could not write %s\n", path);
+        return -1;
+    }
+    s->dumped++;
+    return 0;
+}
+
+#endif /* RSX_FRAME_SERIES_H */
