From: Gran Turismo 6 for Mac <https://github.com/Wooloomooloo2/Gran-Turismo-6-Mac>
Subject: [PATCH] RSX engine: the stencil is part of the zeta's bytes

Upstream: not yet submitted; written to be upstreamed (generic)
Licence: MIT, as ps3recomp (see its LICENSE); offered under the same terms
Base: ps3recomp 4e8f3ca87a3e1d87bb83b8b7e9348fe2685cd514 (after 0001-0045)

What: on the RSX a Z24S8 zeta is one big-endian word per pixel, depth in the
top 24 bits and the stencil in the low byte, and a texture over the zeta's
address reads those bytes. Two gaps made the stencil byte read as 0:
(1) a draw that writes only the stencil (stencil test on, a writable plane,
an operation that is not KEEP; colour and depth writes off) and a clear of
the stencil alone did not count as writes to the zeta, so a later read of it
as A8R8G8B8 reused the bytes converted before them; (2) the Metal backend's
depth_as_color pass, which makes those bytes on the GPU, wrote 0 for the
stencil. It now reads the stencil through an X32_Stencil8 view of the depth
texture (engine depth targets get MTLTextureUsagePixelFormatView for it).
GT6's vector font draws glyph coverage into the stencil that way and then
samples its zeta as A8R8G8B8 to cover it, so no text was drawn. The store
through guest memory (eng_zdepth_to_guest) still writes a 0 stencil byte.
Also: the pass dump's per-draw lines give the stencil state, and each
texture's pitch and crossbar.
Reference: the RSX Z24S8 surface layout (depth << 8 | stencil) the engine's
guest store already uses; no emulator code.
Tests: libs/video/tests/test_rsx_draw_engine.c, a stencil-only draw and a
stencil-only clear convert the zeta again, a draw that cannot write the
stencil does not; libs/video/tests/test_metal_depth_as_color.m (now run by
tools/test_metal_depth_as_color.py), every converted texel holds the
stencil written as its fourth Z24S8 byte.
diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -1564,6 +1564,22 @@ static int eng_zdepth_to_guest(u32 slot)
     return 1;
 }
 
+/* Whether a draw can change the zeta's stencil byte: the test is on, some
+ * plane is writable and an operation of a face it can rasterise is not KEEP
+ * (GL's 0x1E00, as SET_STENCIL_OP_* take it). On the RSX the stencil is the
+ * low byte of each Z24S8 word, so such a draw writes the zeta's memory as a
+ * depth write does, and a later read of that memory as a texture sees it
+ * (D71: GT6's vector font writes glyph coverage to the stencil with colour
+ * and depth writes off, then reads the zeta as A8R8G8B8). */
+static int eng_stencil_writes(const rsx_be_render_state* rs)
+{
+    if (!rs->stencil_enable || !(rs->s_write_mask & 0xFFu)) return 0;
+    const u32 keep = 0x1E00u;
+    if (rs->s_fail != keep || rs->s_zfail != keep || rs->s_zpass != keep) return 1;
+    return rs->stencil_two_sided &&
+           (rs->bs_fail != keep || rs->bs_zfail != keep || rs->bs_zpass != keep);
+}
+
 /* A depth write or clear through the current zeta, recorded with what the
  * guest-memory copy needs to lay it out. */
 static void eng_zdepth_wrote(u32 slot, const rsx_dsp_surface* sf)
@@ -2909,9 +2925,10 @@ static void pd_note(const u32* targets, u32 n_targets, u32 zslot,
     }
     if (s_pd.draws_log) {
         fprintf(s_pd.draws_log, "pass %03u draw %u: pipe %u cmask %08X blend %u %X/%X"
-                " dt %u dw %u at %u |", s_pd.pass, s_pd.draws, pipeline, rs->color_mask,
-                rs->blend_enable, rs->sf_rgb, rs->df_rgb, rs->depth_test, rs->depth_write,
-                rs->alpha_test_enable);
+                " dt %u dw %u at %u st %u %X/%X/%X wm %02X |", s_pd.pass, s_pd.draws,
+                pipeline, rs->color_mask, rs->blend_enable, rs->sf_rgb, rs->df_rgb,
+                rs->depth_test, rs->depth_write, rs->alpha_test_enable, rs->stencil_enable,
+                rs->s_fail, rs->s_zfail, rs->s_zpass, rs->s_write_mask);
         if (rsx_dsp_reg(&g.rsx, M_POLY_OFFSET_FILL) & 1u) {
             const u32 f = rsx_dsp_reg(&g.rsx, M_POLY_OFFSET_FACTOR);
             const u32 b = rsx_dsp_reg(&g.rsx, M_POLY_OFFSET_BIAS);
@@ -2924,8 +2941,8 @@ static void pd_note(const u32* targets, u32 n_targets, u32 zslot,
             if (!(tex_mask & (1u << u))) continue;
             rsx_dsp_texture t;
             rsx_dsp_get_texture(&g.rsx, u, &t);
-            fprintf(s_pd.draws_log, " t%u %u:0x%08X f%02X %ux%u", u, t.location, t.offset,
-                    t.format & 0xFFu, t.width, t.height);
+            fprintf(s_pd.draws_log, " t%u %u:0x%08X f%02X %ux%u p%u r%04X", u, t.location,
+                    t.offset, t.format & 0xFFu, t.width, t.height, t.pitch, t.remap & 0xFFFFu);
         }
         fprintf(s_pd.draws_log, "\n");
     }
@@ -3273,6 +3290,10 @@ static void sink_end(void* user, const rsx_dispatch* r)
     if (zslot != ENG_INVALID && rs.depth_test && rs.depth_write) {
         g.zdepths[zslot].had_write = 1;
         eng_zdepth_wrote(zslot, &sf);
+    } else if (zslot != ENG_INVALID && sf.depth_format != 1u && eng_stencil_writes(&rs)) {
+        /* Stencil only: the depth values are unchanged (had_write, the
+         * depth snapshot's input, stays), the zeta's memory is not. */
+        eng_zdepth_wrote(zslot, &sf);
     }
 }
 
@@ -3378,6 +3399,10 @@ static void sink_clear(void* user, const rsx_dispatch* r, u32 mask)
             if (!partial) g.zdepths[zslot].had_write = 0;
             g.zdepths[zslot].snapshot_valid = 0;
             eng_zdepth_wrote(zslot, &sf);
+        } else if (!z16) {
+            /* A stencil-only clear rewrites the low byte of every Z24S8 word
+             * it covers (D71). */
+            eng_zdepth_wrote(zslot, &sf);
         }
     }
 }
