             const uint32_t w = ((uint32_t)ctx->ls[0] << 24) | ((uint32_t)ctx->ls[1] << 16) |
@@ -537,8 +537,12 @@
             } else {
                 static int s_nv = 0;
                 if (s_nv++ < 4)
