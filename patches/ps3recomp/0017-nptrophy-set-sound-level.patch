From: Gran Turismo 6 for Mac <https://github.com/Wooloomooloo2/Gran-Turismo-6-Mac>
Subject: [PATCH] sceNpTrophy: sceNpTrophySetSoundLevel

Upstream: not yet submitted; written to be upstreamed (generic, no title names)
Licence: MIT, as ps3recomp (see its LICENSE); offered under the same terms
Base: ps3recomp 4e8f3ca87a3e1d87bb83b8b7e9348fe2685cd514 (after 0001-0016)

What: sceNpTrophySetSoundLevel (0x27DEDA93) had no handler, so it took the
unresolved path and faked CELL_OK whatever its arguments. It sets the volume
of the trophy-unlock sound for a context, 20 to 100. There is no unlock sound
to play, so a valid call only succeeds. The checks follow RPCS3's order: a
level outside 20-100 is INVALID_ARGUMENT, any option NOT_SUPPORTED (none is
defined), then the library must be initialised (NOT_INITIALIZED), and the
context and handle are looked up as RPCS3 does: an id out of range is
INVALID_ARGUMENT, a context or handle not open UNKNOWN_CONTEXT or
UNKNOWN_HANDLE.

The module's error values were not the PS3 SDK's (0x805516xx where the SDK
and RPCS3 have 0x800229xx). Every name with an SDK code now has the SDK's
value, and UNKNOWN_CONTEXT and UNKNOWN_HANDLE are added; only the numbers
change, not which error any call returns. ALREADY_EXISTS, NOT_FOUND,
CONTEXT_ALREADY_REG, PROCESSING and UNKNOWN have no SDK code and keep theirs.

Why: a faked success hid a level out of range from the caller.

Test: tools/test_trophy_sound_level.py (new) checks the name hashes to the
imported NID, then builds libs/network/tests/test_trophy_sound_level.c with
sceNpTrophy.c: each refusal above, the two ends of the range, and the SDK
values of the codes it returns.

diff --git a/libs/network/sceNpTrophy.c b/libs/network/sceNpTrophy.c
index d956e6d..0825dcf 100644
--- a/libs/network/sceNpTrophy.c
+++ b/libs/network/sceNpTrophy.c
@@ -388,6 +388,29 @@ s32 sceNpTrophyGetRequiredDiskSpace(SceNpTrophyContext context,
     return CELL_OK;
 }
 
+/* sceNpTrophySetSoundLevel(context, handle, level, options): the volume of the
+ * unlock sound, 20 to 100. There is no unlock sound to play, so a valid call
+ * only succeeds. Checks in RPCS3's order: the level (INVALID_ARGUMENT), the
+ * options, of which none are defined (NOT_SUPPORTED), then initialisation,
+ * the context and the handle (out of range INVALID_ARGUMENT, not open
+ * UNKNOWN_CONTEXT / UNKNOWN_HANDLE). NID 0x27DEDA93. */
+s32 sceNpTrophySetSoundLevel(SceNpTrophyContext context, SceNpTrophyHandle handle, u32 level, u64 options)
+{
+    if (level < 20 || level > 100)
+        return SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT;
+    if (options)
+        return SCE_NP_TROPHY_ERROR_NOT_SUPPORTED;
+    if (!s_trophy_initialized)
+        return SCE_NP_TROPHY_ERROR_NOT_INITIALIZED;
+    /* RPCS3's context lookup: an id out of range is INVALID_ARGUMENT, one not open UNKNOWN_*. */
+    if (context <= 0 || context > SCE_NP_TROPHY_MAX_CONTEXTS) return SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT;
+    if (!s_contexts[context].in_use) return SCE_NP_TROPHY_ERROR_UNKNOWN_CONTEXT;
+    if (handle <= 0 || handle > SCE_NP_TROPHY_MAX_HANDLES) return SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT;
+    if (!s_handles[handle].in_use) return SCE_NP_TROPHY_ERROR_UNKNOWN_HANDLE;
+    printf("[sceNpTrophy] SetSoundLevel(ctx=%d, level=%u)\n", context, level);
+    return CELL_OK;
+}
+
 s32 sceNpTrophyGetGameInfo(SceNpTrophyContext context,
                            SceNpTrophyHandle handle,
                            SceNpTrophyGameDetails* details,
