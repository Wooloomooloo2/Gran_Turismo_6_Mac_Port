-    spu_drain_call(ctx, return_pc);
+    ctx->drain_ret_pc = outer_ret_pc;   /* the drain keeps the outer one for its exit */
+    ctx->drain_ret_sp = outer_ret_sp;
+    spu_drain_call_sp(ctx, return_pc, ret_sp);
