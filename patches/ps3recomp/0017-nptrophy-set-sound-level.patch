diff --git a/libs/network/tests/test_trophy_sound_level.c b/libs/network/tests/test_trophy_sound_level.c
new file mode 100644
index 0000000..4224943
--- /dev/null
+++ b/libs/network/tests/test_trophy_sound_level.c
@@ -0,0 +1,54 @@
+/*
+ * test_trophy_sound_level - sceNpTrophySetSoundLevel (libs/network/sceNpTrophy.c).
+ *
+ * Sets the volume of the trophy-unlock sound for a context, 20 to 100. The
+ * checks follow RPCS3's order: the level, then the options (none are
+ * defined), then initialisation, the context and the handle, each with the
+ * SDK's 0x800229xx code (D37). Run by tools/test_trophy_sound_level.py.
+ */
+#include "../sceNpTrophy.c"
+#include <assert.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+static int fails = 0;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+
+int main(void)
+{
+    vm_base = calloc(1, 65536);
+    memcpy(vm_base + 0x100, "NPWR00000", 9);
+    CHECK(sceNpTrophySetSoundLevel(1, 1, 50, 0) == (s32)SCE_NP_TROPHY_ERROR_NOT_INITIALIZED,
+          "before sceNpTrophyInit: NOT_INITIALIZED");
+    assert(sceNpTrophyInit(NULL, 0, 0, 0) == CELL_OK);
+    assert(sceNpTrophyCreateContext((void*)0x200, (void*)0x100, NULL, 0) == CELL_OK);
+    assert(sceNpTrophyCreateHandle((void*)0x204) == CELL_OK);
+    const u32 ctx = vm_read32(0x200), h = vm_read32(0x204);
+    CHECK(sceNpTrophySetSoundLevel(ctx, h, 19, 0) == (s32)SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT, "level 19: INVALID_ARGUMENT");
+    CHECK(sceNpTrophySetSoundLevel(ctx, h, 101, 0) == (s32)SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT, "level 101: INVALID_ARGUMENT");
+    CHECK(sceNpTrophySetSoundLevel(ctx, h, 50, 1) == (s32)SCE_NP_TROPHY_ERROR_NOT_SUPPORTED, "options: NOT_SUPPORTED");
+    CHECK(sceNpTrophySetSoundLevel(ctx + 1, h, 50, 0) == (s32)SCE_NP_TROPHY_ERROR_UNKNOWN_CONTEXT,
+          "a context not open: UNKNOWN_CONTEXT");
+    CHECK(sceNpTrophySetSoundLevel(ctx, h + 1, 50, 0) == (s32)SCE_NP_TROPHY_ERROR_UNKNOWN_HANDLE,
+          "a handle not open: UNKNOWN_HANDLE");
+    CHECK(sceNpTrophySetSoundLevel(0, h, 50, 0) == (s32)SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT &&
+          sceNpTrophySetSoundLevel(ctx, 0x7FFFFFFF, 50, 0) == (s32)SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT,
+          "an id out of range: INVALID_ARGUMENT");
+    CHECK(SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT == 0x80022906u && SCE_NP_TROPHY_ERROR_NOT_INITIALIZED == 0x80022902u &&
+          SCE_NP_TROPHY_ERROR_UNKNOWN_CONTEXT == 0x8002290au && SCE_NP_TROPHY_ERROR_UNKNOWN_HANDLE == 0x80022911u,
+          "the codes are the SDK's");
+    CHECK(sceNpTrophySetSoundLevel(ctx, h, 20, 0) == CELL_OK && sceNpTrophySetSoundLevel(ctx, h, 100, 0) == CELL_OK,
+          "levels 20 and 100 are CELL_OK");
+    if (fails) { printf("%d check(s) failed\n", fails); return 1; }
+    puts("test_trophy_sound_level: OK");
+    return 0;
+}
diff --git a/tools/test_trophy_sound_level.py b/tools/test_trophy_sound_level.py
new file mode 100644
index 0000000..64167e7
--- /dev/null
+++ b/tools/test_trophy_sound_level.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""sceNpTrophySetSoundLevel (libs/network/sceNpTrophy.c).
+
+Titles import it as 0x27DEDA93. It had no handler, so it took the unresolved
+path and faked CELL_OK whatever its arguments. Checks that the name hashes to
+that NID, then builds libs/network/tests/test_trophy_sound_level.c, which
+includes sceNpTrophy.c, and runs it.
+"""
+import hashlib
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SUFFIX = b"\x67\x59\x65\x99\x04\x25\x04\x90\x56\x64\x27\x49\x94\x89\x74\x1A"
+NIDS = (('sceNpTrophySetSoundLevel', 0x27DEDA93),)
+
+
+def nid(name):
+    return struct.unpack('<I', hashlib.sha1(name.encode() + SUFFIX).digest()[:4])[0]
+
+
+def main():
+    fails = 0
+    for name, want in NIDS:
+        got = nid(name)
+        fails += got != want
+        print(f"[{'PASS' if got == want else 'FAIL'}] {name} hashes to 0x{got:08X} (imported as 0x{want:08X})")
+    cc = os.environ.get('CC') or shutil.which('cc') or shutil.which('gcc') or shutil.which('clang')
+    if not cc:
+        print('SKIP: no C compiler')
+        return 1 if fails else 0
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = Path(tmp) / 'test_trophy_sound_level'
+        r = subprocess.run([cc, '-std=gnu17', '-O1', '-w', '-Wl,-dead_strip' if sys.platform == 'darwin' else '-Wl,--gc-sections', '-ffunction-sections', '-fdata-sections', '-I' + str(ROOT / 'include'),
+                            str(ROOT / 'libs/network/tests/test_trophy_sound_level.c'), '-o', str(exe)],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+        sys.stdout.write(r.stdout + r.stderr)
+        return 1 if (fails or r.returncode) else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
