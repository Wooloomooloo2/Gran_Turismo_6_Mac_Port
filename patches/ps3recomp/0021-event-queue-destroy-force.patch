From: Gran Turismo 6 for Mac <https://github.com/Wooloomooloo2/Gran-Turismo-6-Mac>
Subject: [PATCH] sys_event_queue_destroy: lv2's modes; FORCE wakes the blocked receivers

Upstream: not yet submitted; written to be upstreamed (generic, no title names)
Licence: MIT, as ps3recomp (see its LICENSE); offered under the same terms
Base: ps3recomp 4e8f3ca87a3e1d87bb83b8b7e9348fe2685cd514 (after 0001-0020)

What: sys_event_queue_destroy (lv2 129) ignored its mode, woke nobody and
destroyed the queue's lock and condition variable while receivers were still
blocked in them. It now follows lv2 as RPCS3 implements it:
- mode 0 with a thread blocked in sys_event_queue_receive is CELL_EBUSY;
- SYS_EVENT_QUEUE_DESTROY_FORCE (1) drops the pending events and wakes every
  blocked receiver, which returns CELL_ECANCELED;
- any other mode is CELL_EINVAL.
Each queue counts its blocked receivers (sys_event_queue_info.waiters). A
forced destroy leaves the lock alive for receivers still on their way out,
and sys_event_queue_create does not reuse that slot until the last one has
left.

Why: a title's shutdown stops its event thread by clearing a flag and
force-destroying the queue the thread waits on, then joins it. The thread
was never woken, so the join, and the shutdown, waited for good.

Test: tools/test_event_queue_destroy.py (new) builds
tests/test_event_queue_destroy.c with the real sys_event.c: a receiver
blocked in the queue, EBUSY without FORCE, EINVAL for another mode, FORCE
waking it with CELL_ECANCELED, ESRCH afterwards, and the slot reused once
the receiver has left.

diff --git a/runtime/syscalls/sys_event.c b/runtime/syscalls/sys_event.c
index adabcc56..b4345c62 100644
--- a/runtime/syscalls/sys_event.c
+++ b/runtime/syscalls/sys_event.c
@@ -10,7 +10,7 @@
 #include "../spu/spu_workload.h"   /* spu_elf_image_size, spu_workload_dispatch_async */
 #include <string.h>
 #include <stdlib.h>               /* getenv */
-#include "ps3emu/log_first.h"
+#include "ps3emu/log_first.h"
 
 /* Recorded by sys_spu_thread_initialize (lv2_register.c): the SPURS kernel
  * context EA the title's SPU task runtime is dispatched against. */
@@ -157,7 +157,8 @@ int64_t sys_event_queue_create(ppu_context* ctx)
 
     int slot = -1;
     for (int i = 0; i < SYS_EVENT_QUEUE_MAX; i++) {
-        if (!g_sys_event_queues[i].active) { slot = i; break; }
+        /* a slot a forced destroy left with receivers still leaving is not reused yet */
+        if (!g_sys_event_queues[i].active && !g_sys_event_queues[i].waiters) { slot = i; break; }
     }
     if (slot < 0) {
         evt_table_unlock();
@@ -217,9 +218,18 @@ int64_t sys_event_queue_create(ppu_context* ctx)
 int64_t sys_event_queue_destroy(ppu_context* ctx)
 {
     uint32_t queue_id = LV2_ARG_U32(ctx, 0);
+    const int32_t mode = LV2_ARG_S32(ctx, 1);   /* 0, or SYS_EVENT_QUEUE_DESTROY_FORCE */
 
     if (queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX)
         return getenv("YDKJ_EVT_LENIENT") ? CELL_OK : (int64_t)(int32_t)CELL_ESRCH;  /* idempotent teardown */
+    /* lv2 / RPCS3: any other mode is EINVAL; without FORCE a queue a thread is
+     * blocked on is EBUSY; with FORCE the queue goes, its pending events are
+     * dropped and every blocked receiver returns CELL_ECANCELED. It used to
+     * destroy the lock and condition variable under the waiters and wake none
+     * of them, so a thread blocked in sys_event_queue_receive stayed there and
+     * the thread joining it at shutdown waited for good. */
+    if (mode != 0 && mode != SYS_EVENT_QUEUE_DESTROY_FORCE)
+        return (int64_t)(int32_t)CELL_EINVAL;
 
     evt_table_lock();
 
@@ -230,13 +240,35 @@ int64_t sys_event_queue_destroy(ppu_context* ctx)
     }
 
 #ifdef _WIN32
-    DeleteCriticalSection(&q->lock);
+    EnterCriticalSection(&q->lock);
 #else
-    pthread_cond_destroy(&q->not_empty);
-    pthread_mutex_destroy(&q->lock);
+    pthread_mutex_lock(&q->lock);
 #endif
-
+    const int waiters = q->waiters;
+    if (waiters && mode != SYS_EVENT_QUEUE_DESTROY_FORCE) {
+#ifdef _WIN32
+        LeaveCriticalSection(&q->lock);
+#else
+        pthread_mutex_unlock(&q->lock);
+#endif
+        evt_table_unlock();
+        return (int64_t)(int32_t)CELL_EBUSY;
+    }
     q->active = 0;
+    q->cancelled = 1;
+    q->count = 0;
+#ifdef _WIN32
+    WakeAllConditionVariable(&q->not_empty);
+    LeaveCriticalSection(&q->lock);
+    if (!waiters) DeleteCriticalSection(&q->lock);
+#else
+    pthread_cond_broadcast(&q->not_empty);
+    pthread_mutex_unlock(&q->lock);
+    if (!waiters) {   /* with waiters the slot keeps them until they leave (see create) */
+        pthread_cond_destroy(&q->not_empty);
+        pthread_mutex_destroy(&q->lock);
+    }
+#endif
     evt_table_unlock();
     return CELL_OK;
 }
@@ -487,9 +519,11 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
     if (s_kq < 0) { const char* e = getenv("EVT_RECV_KICK"); s_kq = 0;
         if (e) { s_kq = atoi(e); const char* c = strchr(e, ':'); s_kms = c ? (DWORD)atoi(c + 1) : 500; } }
     if (timeout_us == 0 && s_kq == (int)queue_id && s_have_last_evt[queue_id - 1]) {
+        q->waiters++;
         while (q->count == 0 && q->active && !q->cancelled) {
             if (!SleepConditionVariableCS(&q->not_empty, &q->lock, s_kms) && q->count == 0) {
                 sys_event_t evt = s_last_evt[queue_id - 1];
+                q->waiters--;
                 LeaveCriticalSection(&q->lock);
                 { static int n = 0; if (n++ < 16)
                     fprintf(stderr, "[evt] EVT_RECV_KICK: q=%u idle %lu ms -> re-delivered last event\n",
@@ -504,11 +538,14 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
                 return CELL_OK;
             }
         }
+        q->waiters--;
     }
     if (timeout_us == 0) {
+        q->waiters++;
         while (q->count == 0 && q->active && !q->cancelled) {
             SleepConditionVariableCS(&q->not_empty, &q->lock, INFINITE);
         }
+        q->waiters--;
         if (q->count == 0 && q->cancelled) {
             LeaveCriticalSection(&q->lock);
             return (int64_t)(int32_t)CELL_ECANCELED;
@@ -527,14 +564,17 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
         }
     } else {
         DWORD ms = (DWORD)(timeout_us / 1000);
+        q->waiters++;
         while (q->count == 0 && q->active && !q->cancelled) {
             if (!SleepConditionVariableCS(&q->not_empty, &q->lock, ms)) {
                 if (GetLastError() == ERROR_TIMEOUT) {
+                    q->waiters--;
                     LeaveCriticalSection(&q->lock);
                     return (int64_t)(int32_t)CELL_ETIMEDOUT;
                 }
             }
         }
+        q->waiters--;
     }
 
     if (q->count == 0 && q->cancelled) {
@@ -555,9 +595,11 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
     pthread_mutex_lock(&q->lock);
 
     if (timeout_us == 0) {
+        q->waiters++;
         while (q->count == 0 && q->active && !q->cancelled) {
             pthread_cond_wait(&q->not_empty, &q->lock);
         }
+        q->waiters--;
     } else {
         struct timespec ts;
         clock_gettime(CLOCK_REALTIME, &ts);
@@ -567,13 +609,16 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
             ts.tv_sec++;
             ts.tv_nsec -= 1000000000L;
         }
+        q->waiters++;
         while (q->count == 0 && q->active && !q->cancelled) {
             int rc = pthread_cond_timedwait(&q->not_empty, &q->lock, &ts);
             if (rc == ETIMEDOUT) {
+                q->waiters--;
                 pthread_mutex_unlock(&q->lock);
                 return (int64_t)(int32_t)CELL_ETIMEDOUT;
             }
         }
+        q->waiters--;
     }
 
     if (q->count == 0 && q->cancelled) {
diff --git a/runtime/syscalls/sys_event.h b/runtime/syscalls/sys_event.h
index 14c64255..61e38c73 100644
--- a/runtime/syscalls/sys_event.h
+++ b/runtime/syscalls/sys_event.h
@@ -39,6 +39,7 @@ typedef struct sys_event_t {
  * Event Queues
  * -----------------------------------------------------------------------*/
 #define SYS_EVENT_QUEUE_MAX       128
+#define SYS_EVENT_QUEUE_DESTROY_FORCE 1   /* sys_event_queue_destroy mode: wake the waiters */
 #define SYS_EVENT_QUEUE_BUF_MAX   127   /* max events in queue buffer */
 
 /* Queue types */
@@ -64,6 +65,10 @@ typedef struct sys_event_queue_info {
      * and return CELL_ECANCELED instead of waiting for an event that can never
      * arrive; later receives fail the same way rather than re-blocking. */
     int          cancelled;
+    /* Receivers blocked in the queue right now (under `lock`). A destroy with
+     * waiters needs SYS_EVENT_QUEUE_DESTROY_FORCE and wakes them; the slot is
+     * not reused (its lock re-initialised) until the last one has left. */
+    int          waiters;
 
 #ifdef _WIN32
     CRITICAL_SECTION lock;
diff --git a/tests/test_event_queue_destroy.c b/tests/test_event_queue_destroy.c
new file mode 100644
index 00000000..cd3297de
--- /dev/null
+++ b/tests/test_event_queue_destroy.c
@@ -0,0 +1,80 @@
+/* sys_event_queue_destroy through the real runtime/syscalls/sys_event.c: lv2's
+ * modes (0 / SYS_EVENT_QUEUE_DESTROY_FORCE), EBUSY with a blocked receiver,
+ * and a forced destroy waking it with CELL_ECANCELED. Run by
+ * tools/test_event_queue_destroy.py. */
+#include "../runtime/syscalls/sys_event.c"
+#include <assert.h>
+#include <pthread.h>
+#include <unistd.h>
+
+/* Runtime data and hooks sys_event.c refers to; inert here. */
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+uint32_t g_spu_pending_evt[3];
+int      g_spu_pending_evt_valid;
+size_t spu_elf_image_size(const uint8_t* e, size_t m) { (void)e; (void)m; return 0; }
+int spu_workload_dispatch_async(const uint8_t* a, uint32_t b, uint32_t c) { (void)a; (void)b; (void)c; return 0; }
+void ydkj_release_pending_threads(void) {}
+void ppu_thread_note_block(uint64_t tid) { (void)tid; }
+int spu_dispatch_frame_by_queue(uint32_t q, uint32_t f) { (void)q; (void)f; return 0; }
+void ppu_dump_guest_stack(ppu_context* c, const char* t) { (void)c; (void)t; }
+
+static int fails;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+
+static uint32_t g_q;
+static volatile int64_t g_rc = 1;
+static void* receiver(void* a)
+{
+    (void)a;
+    ppu_context c; memset(&c, 0, sizeof c);
+    c.gpr[3] = g_q; c.gpr[4] = 0x2000; c.gpr[5] = 0;   /* wait forever */
+    g_rc = sys_event_queue_receive(&c);
+    return NULL;
+}
+
+static uint32_t create(void)
+{
+    ppu_context c; memset(&c, 0, sizeof c);
+    c.gpr[3] = 0x1000; c.gpr[4] = 0; c.gpr[5] = 0x1234; c.gpr[6] = 8;
+    assert(sys_event_queue_create(&c) == CELL_OK);
+    const uint8_t* p = (const uint8_t*)vm_to_host(0x1000);
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+static int64_t destroy(uint32_t q, int32_t mode)
+{
+    ppu_context c; memset(&c, 0, sizeof c);
+    c.gpr[3] = q; c.gpr[4] = (uint64_t)(int64_t)mode;
+    return sys_event_queue_destroy(&c);
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    assert(vm_init() == CELL_OK);
+    assert(vm_commit(0x1000, 0x10000) == CELL_OK);
+
+    g_q = create();
+    pthread_t t;
+    pthread_create(&t, NULL, receiver, NULL);
+    for (int i = 0; i < 200 && !g_sys_event_queues[g_q - 1].waiters; i++) usleep(5000);
+    CHECK(g_sys_event_queues[g_q - 1].waiters == 1, "the receiver is blocked in the queue");
+    CHECK((uint32_t)destroy(g_q, 0) == CELL_EBUSY, "destroy without FORCE while a thread waits is EBUSY");
+    CHECK((uint32_t)destroy(g_q, 2) == CELL_EINVAL, "an unknown mode is EINVAL");
+    CHECK(g_rc == 1, "the receiver is still blocked");
+    CHECK(destroy(g_q, SYS_EVENT_QUEUE_DESTROY_FORCE) == CELL_OK, "destroy with FORCE");
+    for (int i = 0; i < 400 && g_rc == 1; i++) usleep(5000);
+    pthread_join(t, NULL);
+    CHECK((uint32_t)g_rc == CELL_ECANCELED, "the blocked receiver returns CELL_ECANCELED (0x%08X)", (uint32_t)g_rc);
+    CHECK((uint32_t)destroy(g_q, SYS_EVENT_QUEUE_DESTROY_FORCE) == CELL_ESRCH, "a destroyed queue is ESRCH");
+    const uint32_t q2 = create();
+    CHECK(q2 == g_q, "the slot is reused once its receiver has left (%u)", q2);
+    CHECK(destroy(q2, 0) == CELL_OK, "destroy of a queue nobody waits on, mode 0");
+
+    vm_shutdown();
+    if (fails) { printf("%d check(s) failed\n", fails); return 1; }
+    puts("test_event_queue_destroy: OK");
+    return 0;
+}
diff --git a/tools/test_event_queue_destroy.py b/tools/test_event_queue_destroy.py
new file mode 100644
index 00000000..5f6f7ea6
--- /dev/null
+++ b/tools/test_event_queue_destroy.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+"""sys_event_queue_destroy through the real runtime/syscalls/sys_event.c.
+
+lv2's destroy takes a mode: 0 refuses (EBUSY) while a thread is blocked in the
+queue, SYS_EVENT_QUEUE_DESTROY_FORCE (1) wakes every blocked receiver with
+CELL_ECANCELED, anything else is EINVAL. The runtime ignored the mode, woke
+nobody and destroyed the lock under the waiters, so a thread joined at
+shutdown never left its receive. Builds tests/test_event_queue_destroy.c (which
+includes sys_event.c) and runs it.
+"""
+import os
+import platform
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: the fixture is POSIX; run on macOS/Linux')
+        return 0
+    with tempfile.TemporaryDirectory(prefix='event-queue-destroy-') as tmp:
+        exe = Path(tmp) / 'test_event_queue_destroy'
+        link = ['-Wl,-undefined,dynamic_lookup'] if platform.system() == 'Darwin' else ['-Wl,--unresolved-symbols=ignore-all']
+        r = subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-O1', '-w', '-pthread',
+                            '-I' + str(ROOT / 'include'), '-I' + str(ROOT / 'runtime'),
+                            str(ROOT / 'tests/test_event_queue_destroy.c'), *link, '-o', str(exe)],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+        sys.stdout.write(r.stdout + r.stderr)
+        return r.returncode
+
+
+if __name__ == '__main__':
+    sys.exit(main())
