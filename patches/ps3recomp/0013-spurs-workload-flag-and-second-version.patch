@@ -1817,6 +1855,9 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p)
                 if (ready) vm_base[ea + SPURS_WKL_READY1 + wid] = (u8)(ready - 1);
                 if (signal & (0x8000u >> wid))
                     ef_w16(ea + SPURS_WKL_SIGNAL1, (u16)(signal & ~(0x8000u >> wid)));
+                /* The receiver is selected: the flag goes back to all ones, as the SPURS kernel does. */
+                if (vm_read8(ea + SPURS_WKL_FLAG_RECEIVER) == wid)
+                    ef_w32(ea + SPURS_WKL_FLAG_WORD, 0xFFFFFFFFu);
                 ef_line_end(ea);
                 slot->fn = pm->fn; slot->image_id = pm->image_id;
                 slot->pm = vm_base + (u32)(uintptr_t)s_workloads[wid].pm;
@@ -1932,6 +1973,63 @@ s32 cellSpursReadyCountStore(CellSpurs* spurs, CellSpursWorkloadId wid,
     return CELL_OK;
 }
 
+/* ---------------------------------------------------------------------------
+ * The workload flag: one workload of an instance (the receiver, byte 0x77) can be asked to run by a store of 0
+ * into the flag word (+0x6C). The kernel then selects it ahead of the round robin and pulls the flag back to all
+ * ones (spurs_kernel_thread). Behaviour and error codes follow RPCS3.
+ * -----------------------------------------------------------------------*/
+static s32 spurs_flag_receiver_checks(u32 ea, u32 wid)
+{
+    if (!ea) return CELL_SPURS_POLICY_MODULE_ERROR_NULL_POINTER;
+    if (ea & 127u) return CELL_SPURS_POLICY_MODULE_ERROR_ALIGN;
+    const u32 max = (vm_read8(ea + SPURS_FLAGS1) & SPURS_SF1_32_WORKLOADS) ? 32u : CELL_SPURS_MAX_WORKLOAD;
+    if (wid >= max) return CELL_SPURS_POLICY_MODULE_ERROR_INVAL;
+    if (wid >= 32u || !(vm_read32(ea + SPURS_WKL_ENABLED) & (0x80000000u >> wid)))
+        return CELL_SPURS_POLICY_MODULE_ERROR_SRCH;
+    if (vm_read32(ea + SPURS_EXCEPTION)) return CELL_SPURS_POLICY_MODULE_ERROR_STAT;
+    return CELL_OK;
+}
+
+/* Sets (isSet) or clears the receiver: setting needs no receiver yet (BUSY), clearing needs `wid` to be it
+ * (PERM). The first version also pulls the flag to all ones. */
+static s32 spurs_flag_receiver(u32 ea, u32 wid, u32 isSet, int reset_flag)
+{
+    s32 rc = spurs_flag_receiver_checks(ea, wid);
+    if (rc) return rc;
+    spu_lockline_lock();
+    const u8 cur = vm_read8(ea + SPURS_WKL_FLAG_RECEIVER);
+    if (isSet ? cur != 0xFF : cur != wid) {
+        ef_line_end(ea);
+        return isSet ? CELL_SPURS_POLICY_MODULE_ERROR_BUSY : CELL_SPURS_POLICY_MODULE_ERROR_PERM;
+    }
+    if (reset_flag) ef_w32(ea + SPURS_WKL_FLAG_WORD, 0xFFFFFFFFu);
+    vm_base[ea + SPURS_WKL_FLAG_RECEIVER] = isSet ? (u8)wid : 0xFF;
+    ef_line_end(ea);
+    return CELL_OK;
+}
+
+/* NID 0x2DDBCC0A. printDebugOutput only selects a diagnostic on the console. */
+s32 _cellSpursWorkloadFlagReceiver2(CellSpurs* spurs, u32 wid, u32 isSet, u32 printDebugOutput)
+{
+    (void)printDebugOutput;
+    return spurs_flag_receiver((u32)(uintptr_t)spurs, wid, isSet, 0);
+}
+
+s32 _cellSpursWorkloadFlagReceiver(CellSpurs* spurs, u32 wid, u32 isSet)
+{
+    return spurs_flag_receiver((u32)(uintptr_t)spurs, wid, isSet, 1);
+}
+
+/* *flag = the instance's CellSpursWorkloadFlag (+0x60), which the caller stores into directly. NID 0xC765B995. */
+s32 cellSpursGetWorkloadFlag(CellSpurs* spurs, u32* flag)
+{
+    const u32 ea = (u32)(uintptr_t)spurs;
+    if (!ea || !flag) return CELL_SPURS_POLICY_MODULE_ERROR_NULL_POINTER;
+    if (ea & 127u) return CELL_SPURS_POLICY_MODULE_ERROR_ALIGN;
+    vm_write32((u32)(uintptr_t)flag, ea + SPURS_WKL_FLAG);
+    return CELL_OK;
+}
+
 static s32 spurs_ready_exchange(CellSpurs* spurs, CellSpursWorkloadId wid,
                                  u32* old, u32 compare, u32 value, int conditional)
 {
