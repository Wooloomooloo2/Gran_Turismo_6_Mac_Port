+#define PS3_LOG_FIRST(n, k) ((n)++ < (k))
+#include "ppu_sjlj.h"
+static PPU_THREAD_LOCAL int g_dispatch_depth = 0;
+static PPU_THREAD_LOCAL int g_vcall_sp = 0;
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
+PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = nullptr;
+%s
+static int fails = 0;
+#define CHECK(c, m) do { bool ok_ = (c); printf("%%s %%s\n", ok_ ? "ok  " : "FAIL", m); if (!ok_) fails++; } while (0)
+static int after_longjmp = 0;
+static void dummy(void*) {}
+/* guest setjmp: stores nothing here, returns 0 */
+__attribute__((noinline)) static void guest_setjmp(ppu_context* ctx) { ctx->gpr[3] = 0; }
+/* guest longjmp: restores the registers (here r1 and r3 = value) and returns */
+__attribute__((noinline)) static void guest_longjmp(ppu_context* ctx) {
+    const uint32_t _sjbuf = (uint32_t)ctx->gpr[3];
+    ctx->gpr[1] = 0xD0001000; ctx->gpr[3] = ctx->gpr[4] ? ctx->gpr[4] : 1;
+    ppu_sjlj_longjmp(ctx, _sjbuf); return;
+}
+__attribute__((noinline)) static void deep2(ppu_context* ctx) {
+    g_dispatch_depth += 5; g_vcall_sp += 3; g_trampoline_fn = dummy;   /* frames that never unwind */
+    ctx->gpr[3] = 0x1000; ctx->gpr[4] = 7; guest_longjmp(ctx);
+    after_longjmp = 1;                                                 /* must not run */
+}
+__attribute__((noinline)) static void deep1(ppu_context* ctx) { deep2(ctx); after_longjmp = 2; }
+/* as the lifter emits them: every return drops the function's frames */
+__attribute__((noinline)) static int caller(ppu_context* ctx) {
+    ppu_sjlj_frame _sjf[1] = {};
+    ctx->gpr[3] = 0x1000;
+    PPU_SJLJ_SETJMP(ctx, _sjf[0], guest_setjmp);
+    if (ctx->gpr[3] == 0) { deep1(ctx); { ppu_sjlj_leave(_sjf, 1); return -1; } }
+    { ppu_sjlj_leave(_sjf, 1); return (int)ctx->gpr[3]; }
+}
+__attribute__((noinline)) static void sets_and_returns(ppu_context* ctx) {
+    ppu_sjlj_frame _sjf[1] = {};
+    ctx->gpr[3] = 0x2000;
+    PPU_SJLJ_SETJMP(ctx, _sjf[0], guest_setjmp);
+    { ppu_sjlj_leave(_sjf, 1); return; }
+}
+/* The review's case: sites A (0x100) and B (0x200) in one function, a longjmp
+ * to A drops B, B is reached again, then a longjmp to the CALLER's buffer
+ * (0x300) must still land in the caller. */
+static volatile int ab_stage = 0;
+__attribute__((noinline)) static void two_sites(ppu_context* ctx) {
+    ppu_sjlj_frame _sjf[2] = {};
+    ctx->gpr[3] = 0x100;
+    PPU_SJLJ_SETJMP(ctx, _sjf[0], guest_setjmp);                    /* site A */
+    if (ctx->gpr[3] == 0) {
+        ctx->gpr[3] = 0x200;
+        PPU_SJLJ_SETJMP(ctx, _sjf[1], guest_setjmp);                /* site B */
+        ctx->gpr[3] = 0x100; ctx->gpr[4] = 1; guest_longjmp(ctx);  /* to A: drops B */
+    }
+    ab_stage = 1;
+    ctx->gpr[3] = 0x200;
+    PPU_SJLJ_SETJMP(ctx, _sjf[1], guest_setjmp);                    /* B again */
+    ab_stage = 2;
+    ctx->gpr[3] = 0x300; ctx->gpr[4] = 9; guest_longjmp(ctx);      /* to the caller */
+    ab_stage = 3;                                                   /* must not run */
+    { ppu_sjlj_leave(_sjf, 2); return; }
+}
+__attribute__((noinline)) static int ab_caller(ppu_context* ctx) {
+    ppu_sjlj_frame _sjf[1] = {};
+    ctx->gpr[3] = 0x300;
+    PPU_SJLJ_SETJMP(ctx, _sjf[0], guest_setjmp);
+    if (ctx->gpr[3] == 0) { two_sites(ctx); { ppu_sjlj_leave(_sjf, 1); return -1; } }
+    { ppu_sjlj_leave(_sjf, 1); return (int)ctx->gpr[3]; }
+}
+__attribute__((noinline)) static int loops(ppu_context* ctx) {
+    ppu_sjlj_frame _sjf[1] = {};
+    volatile int laps = 0;   /* a local changed after setjmp must be volatile (lifted code keeps its state in ctx) */
+again:
+    ctx->gpr[3] = 0x4000;
+    PPU_SJLJ_SETJMP(ctx, _sjf[0], guest_setjmp);
+    if (++laps < 3) goto again;                 /* the same call site, three times */
+    if (ctx->gpr[3] == 0) { ctx->gpr[3] = 0x4000; ctx->gpr[4] = 5; guest_longjmp(ctx); }
+    { ppu_sjlj_leave(_sjf, 1); return (int)ctx->gpr[3] * 100 + laps; }
+}
+int main() {
+    ppu_context c = {}; c.thread_id = 9;
+    g_dispatch_depth = 2; g_vcall_sp = 1;
+    int r = caller(&c);
+    CHECK(r == 7, "longjmp lands after the setjmp call with its value in r3");
+    CHECK(after_longjmp == 0, "the code after the longjmp call never runs");
+    CHECK(c.gpr[1] == 0xD0001000, "the registers the guest longjmp restored stay restored");
+    CHECK(g_dispatch_depth == 2 && g_vcall_sp == 1, "dispatch depth and vcall stack put back");
+    CHECK(g_trampoline_fn == nullptr, "a pending trampoline is dropped");
+    /* no live frame for the buffer: guest_longjmp returns */
+    c.gpr[3] = 0x3000; c.gpr[4] = 1; guest_longjmp(&c);
+    CHECK(true, "longjmp to an unknown buffer returns to its caller");
+    /* a frame whose function has returned is never jumped to */
+    sets_and_returns(&c);
+    c.gpr[3] = 0x2000; c.gpr[4] = 1; guest_longjmp(&c);
+    CHECK(true, "longjmp to a returned frame's buffer returns instead");
+    int l = loops(&c);
+    CHECK(l == 504, "a setjmp call site re-armed in a loop is one frame, and lands once more");
+    int ab = ab_caller(&c);
+    CHECK(ab == 9 && ab_stage == 2, "after a longjmp to A drops B and B is re-armed, a longjmp to the caller still lands");
+    printf("%%s (%%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
+'''
+
+
+def test_runtime():
+    cxx = os.environ.get('CXX') or shutil.which('c++') or shutil.which('clang++') or shutil.which('g++')
+    if not cxx:
+        print('SKIP: no C++ compiler')
+        return
+    src = (ROOT / 'runtime/ppu/ppu_loader.cpp').read_text()
+    a = src.index('/* guest-sjlj: begin */')
+    b = src.index('/* guest-sjlj: end */')
+    with tempfile.TemporaryDirectory() as tmp:
+        c = Path(tmp) / 't.cpp'
+        exe = Path(tmp) / 't'
+        c.write_text(HARNESS % src[a:b])
+        r = subprocess.run([cxx, '-std=c++17', '-O2', '-w', '-I', str(ROOT / 'runtime/ppu'), str(c),
+                            '-o', str(exe)], capture_output=True, text=True)
+        if r.returncode:
+            print(r.stderr[-3000:])
+            FAILS.append('runtime harness compiles')
+            return
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+        print(r.stdout, end='')
+        if r.returncode:
+            FAILS.append('runtime')
+        if 'no live setjmp frame' not in r.stderr:
+            FAILS.append('the unmatched longjmp is logged')
+            print(r.stderr)
+
+
+def main():
+    test_rewrite()
+    test_runtime()
+    if FAILS:
+        print('FAILED: ' + ', '.join(FAILS))
