diff --git a/runtime/ppu/ppu_net_offline.h b/runtime/ppu/ppu_net_offline.h
new file mode 100644
--- /dev/null
+++ b/runtime/ppu/ppu_net_offline.h
@@ -0,0 +1,85 @@
+/*
+ * ps3recomp - sys_net offline model: bind, getsockname and inet_pton.
+ *
+ * Included by ppu_sysprx.cpp after its offline-model state (g_net_errno_ea,
+ * s_net_next_fd, gcm_guest_alloc); a header so
+ * runtime/ppu/tests/test_net_offline.cpp can drive the handlers alone.
+ */
+#pragma once
+/* bind and getsockname: the offline stack still has local sockets, so a bind takes and a
+ * getsockname reports the address it was bound to, with an ephemeral port for port 0 (as a
+ * BSD stack assigns one); an unbound socket reports 0.0.0.0:0. getsockname was unresolved,
+ * so it answered CELL_OK with the address left unwritten. sockaddr_in as the guest lays it
+ * out: {u8 len, u8 family, u16 port, u32 addr, u8 zero[8]}, port and address in network
+ * order. Errors follow libnet: -1 with errno (EBADF 9, EINVAL 22, EFAULT 14). */
+#define NET_OFFLINE_FDS 1024
+static uint8_t  s_net_bound[NET_OFFLINE_FDS][16];
+static uint8_t  s_net_is_bound[NET_OFFLINE_FDS];
+static uint16_t s_net_next_port = 49152;
+static void net_fail(ppu_context* ctx, uint32_t err)
+{
+    if (!g_net_errno_ea) g_net_errno_ea = gcm_guest_alloc(4, 4);
+    if (g_net_errno_ea) vm_write32(g_net_errno_ea, err);
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)-1;
+}
+static bool net_open_fd(uint32_t s) { return s >= 3 && s < s_net_next_fd && s < NET_OFFLINE_FDS; }
+static void hle_net_bind(ppu_context* ctx)
+{
+    const uint32_t s = (uint32_t)ctx->gpr[3], addr = (uint32_t)ctx->gpr[4], len = (uint32_t)ctx->gpr[5];
+    if (!net_open_fd(s)) { net_fail(ctx, 9); return; }
+    if (!addr) { net_fail(ctx, 14); return; }
+    if (len < 8 || s_net_is_bound[s]) { net_fail(ctx, 22); return; }
+    uint8_t* b = s_net_bound[s];
+    memset(b, 0, 16);
+    for (int i = 0; i < 8; i++) b[i] = vm_read8(addr + i);
+    b[0] = 16; b[1] = 2;                        /* AF_INET */
+    if (b[2] == 0 && b[3] == 0) {               /* port 0: an ephemeral port */
+        const uint16_t port = s_net_next_port++;
+        b[2] = (uint8_t)(port >> 8); b[3] = (uint8_t)port;
+    }
+    s_net_is_bound[s] = 1;
+    ctx->gpr[3] = 0;
+}
+static void hle_net_getsockname(ppu_context* ctx)
+{
+    const uint32_t s = (uint32_t)ctx->gpr[3], addr = (uint32_t)ctx->gpr[4], lenp = (uint32_t)ctx->gpr[5];
+    if (!net_open_fd(s)) { net_fail(ctx, 9); return; }
+    if (!addr || !lenp) { net_fail(ctx, 14); return; }
+    uint8_t unbound[16] = { 16, 2 };
+    const uint8_t* b = s_net_is_bound[s] ? s_net_bound[s] : unbound;
+    uint32_t n = vm_read32(lenp);
+    if (n > 16) n = 16;
+    for (uint32_t i = 0; i < n; i++) vm_write8(addr + i, b[i]);
+    vm_write32(lenp, 16);
+    ctx->gpr[3] = 0;
+}
+/* inet_pton(af, src, dst): AF_INET (2) only, as libnet; 1 and the 4 address bytes in network
+ * order for a dotted quad, 0 (dst untouched) for anything else, -1 with EAFNOSUPPORT (47) for
+ * another family. It was unresolved: 0 for every address, so every literal read as invalid. */
+static void hle_net_inet_pton(ppu_context* ctx)
+{
+    const int32_t af = (int32_t)(uint32_t)ctx->gpr[3];
+    const uint32_t src = (uint32_t)ctx->gpr[4], dst = (uint32_t)ctx->gpr[5];
+    if (af != 2) { net_fail(ctx, 47); return; }
+    if (!src || !dst) { net_fail(ctx, 14); return; }
+    char text[64];
+    uint32_t i = 0;
+    for (; i + 1 < sizeof text; i++) { text[i] = (char)vm_read8(src + i); if (!text[i]) break; }
+    text[i] = 0;
+    /* exactly four decimal parts, each 0..255 with no leading zero, separated by '.' */
+    uint8_t out[4];
+    bool ok = true;
+    size_t p = 0;
+    for (int k = 0; ok && k < 4; k++) {
+        if (text[p] < '0' || text[p] > '9') { ok = false; break; }
+        if (text[p] == '0' && text[p + 1] >= '0' && text[p + 1] <= '9') { ok = false; break; }
+        unsigned v = 0;
+        while (text[p] >= '0' && text[p] <= '9') { v = v * 10 + (unsigned)(text[p++] - '0'); if (v > 255) break; }
+        if (v > 255) { ok = false; break; }
+        out[k] = (uint8_t)v;
+        if (k < 3) { if (text[p] != '.') ok = false; else p++; }
+    }
+    if (ok && text[p] != 0) ok = false;
+    if (ok) for (int k = 0; k < 4; k++) vm_write8(dst + k, out[k]);
+    ctx->gpr[3] = ok ? 1 : 0;
+}
diff --git a/runtime/ppu/tests/test_net_offline.cpp b/runtime/ppu/tests/test_net_offline.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/ppu/tests/test_net_offline.cpp
@@ -0,0 +1,88 @@
+/*
+ * ps3recomp - the sys_net offline model's bind, getsockname and inet_pton
+ * (runtime/ppu/ppu_net_offline.h, included by ppu_sysprx.cpp).
+ *
+ * getsockname (0x13EFE7F5) and inet_pton (0x8AF3825E) were unresolved, so they
+ * answered CELL_OK with nothing written, and bind did not record the address.
+ * Checks: bind keeps the address (an ephemeral port for port 0), getsockname
+ * reports it (0.0.0.0:0 when unbound) and the 16-byte length, bad descriptors
+ * and NULL pointers are -1 with errno, inet_pton parses dotted quads only.
+ * Run by tools/test_net_offline.py.
+ */
+#include "../ppu_memory.h"
+#include <stdio.h>
+
+extern "C" {
+uint8_t* vm_base;
+int g_resv_store_active = 0;
+uint32_t g_ww_lo = 0, g_ww_hi = 0;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+}
+static uint32_t g_net_errno_ea = 0;
+static uint32_t s_net_next_fd = 3;
+static unsigned int gcm_guest_alloc(unsigned int size, unsigned int align) { (void)size; (void)align; return 0xF000; }
+#include "../ppu_net_offline.h"
+
+static int fails = 0;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+static ppu_context ctx;
+static int32_t call(void (*f)(ppu_context*), uint64_t a, uint64_t b, uint64_t c)
+{
+    memset(&ctx, 0, sizeof ctx); ctx.gpr[3] = a; ctx.gpr[4] = b; ctx.gpr[5] = c; f(&ctx);
+    return (int32_t)(uint32_t)ctx.gpr[3];
+}
+
+static uint32_t errno_v() { return vm_read32(0xF000); }
+
+int main()
+{
+    static uint8_t mem[1 << 16];
+    vm_base = mem;
+    s_net_next_fd = 5;   /* sockets 3 and 4 are open */
+    /* sockaddr_in at 0x100: len 16, AF_INET, port 8080, 192.168.0.2 */
+    const uint8_t sa[16] = { 16, 2, 0x1F, 0x90, 192, 168, 0, 2 };
+    memcpy(mem + 0x100, sa, 16);
+
+    vm_write32(0x300, 16);
+    CHECK(call(hle_net_getsockname, 3, 0x200, 0x300) == 0 && mem[0x200] == 16 && mem[0x201] == 2 &&
+          mem[0x202] == 0 && mem[0x203] == 0 && vm_read32(0x204) == 0, "an unbound socket reports 0.0.0.0:0");
+    CHECK(call(hle_net_bind, 3, 0x100, 16) == 0, "bind 192.168.0.2:8080");
+    CHECK(call(hle_net_bind, 3, 0x100, 16) == -1 && errno_v() == 22, "a second bind is EINVAL");
+    memset(mem + 0x200, 0xEE, 16);
+    vm_write32(0x300, 16);
+    CHECK(call(hle_net_getsockname, 3, 0x200, 0x300) == 0 && memcmp(mem + 0x200, sa, 16) == 0 &&
+          vm_read32(0x300) == 16, "getsockname reports the bound address and length 16");
+    memcpy(mem + 0x110, sa, 16); mem[0x112] = mem[0x113] = 0;   /* port 0 */
+    CHECK(call(hle_net_bind, 4, 0x110, 16) == 0, "bind with port 0");
+    vm_write32(0x300, 8);
+    memset(mem + 0x200, 0xEE, 16);
+    CHECK(call(hle_net_getsockname, 4, 0x200, 0x300) == 0 && (mem[0x202] << 8 | mem[0x203]) >= 49152 &&
+          mem[0x208] == 0xEE && vm_read32(0x300) == 16,
+          "port 0 gets an ephemeral port; only *addrlen bytes are written; the length says 16");
+    CHECK(call(hle_net_getsockname, 9, 0x200, 0x300) == -1 && errno_v() == 9, "a socket never opened is EBADF");
+    CHECK(call(hle_net_bind, 4, 0, 16) == -1 && errno_v() == 14, "bind with no address is EFAULT");
+    CHECK(call(hle_net_getsockname, 3, 0x200, 0) == -1 && errno_v() == 14, "getsockname with no length is EFAULT");
+
+    struct { const char* text; int ret; uint8_t b[4]; } cases[] = {
+        { "127.0.0.1", 1, { 127, 0, 0, 1 } }, { "255.255.255.255", 1, { 255, 255, 255, 255 } },
+        { "0.0.0.0", 1, { 0, 0, 0, 0 } },     { "256.1.1.1", 0, {} }, { "1.2.3", 0, {} },
+        { "1.2.3.4.5", 0, {} },               { "01.2.3.4", 0, {} },  { "a.b.c.d", 0, {} },
+        { "1.2.3.4 ", 0, {} },                { "", 0, {} },
+    };
+    for (auto& c : cases) {
+        strcpy((char*)mem + 0x400, c.text);
+        memset(mem + 0x500, 0xEE, 4);
+        const int32_t r = call(hle_net_inet_pton, 2, 0x400, 0x500);
+        const bool bytes = c.ret ? memcmp(mem + 0x500, c.b, 4) == 0 : mem[0x500] == 0xEE;
+        CHECK(r == c.ret && bytes, "inet_pton(\"%s\") = %d", c.text, r);
+    }
+    CHECK(call(hle_net_inet_pton, 28, 0x400, 0x500) == -1 && errno_v() == 47, "inet_pton of AF_INET6 is EAFNOSUPPORT");
+    printf("%s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
diff --git a/tools/test_net_offline.py b/tools/test_net_offline.py
new file mode 100644
--- /dev/null
+++ b/tools/test_net_offline.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""The sys_net offline model's bind, getsockname and inet_pton
+(runtime/ppu/ppu_net_offline.h). Checks the two NIDs are the hashes of their
+names, then builds runtime/ppu/tests/test_net_offline.cpp and runs it.
+"""
+import hashlib
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SUFFIX = b"\x67\x59\x65\x99\x04\x25\x04\x90\x56\x64\x27\x49\x94\x89\x74\x1A"
+
+
+def nid(name):
+    return struct.unpack('<I', hashlib.sha1(name.encode() + SUFFIX).digest()[:4])[0]
+
+
+def main():
+    fails = 0
+    for name, want in (("getsockname", 0x13EFE7F5), ("inet_pton", 0x8AF3825E), ("bind", 0xB0A59804)):
+        ok = nid(name) == want
+        fails += not ok
+        print(f"[{'PASS' if ok else 'FAIL'}] {name} hashes to 0x{nid(name):08X} (imported as 0x{want:08X})")
+    cxx = os.environ.get('CXX') or shutil.which('c++') or shutil.which('clang++')
+    if not cxx:
+        print('SKIP: no C++ compiler')
+        return 1 if fails else 0
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = Path(tmp) / 'test_net_offline'
+        r = subprocess.run([cxx, '-std=gnu++17', '-O1', '-w', '-I' + str(ROOT / 'include'),
+                            '-I' + str(ROOT / 'runtime'), '-I' + str(ROOT / 'runtime/ppu'),
+                            str(ROOT / 'runtime/ppu/tests/test_net_offline.cpp'), '-o', str(exe)],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            print('FAIL: fixture did not build')
+            return 1
+        r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+        sys.stdout.write(r.stdout + r.stderr)
+        return 1 if (fails or r.returncode) else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/libs/misc/tests/test_key2char.c b/libs/misc/tests/test_key2char.c
new file mode 100644
--- /dev/null
+++ b/libs/misc/tests/test_key2char.c
@@ -0,0 +1,58 @@
+/*
+ * test_key2char - cellKey2char (libs/misc/cellKey2char.c) with the SDK's API.
+ *
+ * The handle is the title's 128-byte buffer. Open(handle) used to be read as
+ * Open(arrangement, handle*), writing an index through the title's second
+ * register. Checks the SDK names hash to the NIDs a title imports, that Open
+ * writes only inside the handle buffer, and RPCS3's argument answers.
+ * Run by tools/test_key2char.py.
+ */
+#include "../cellKey2char.c"
+
+uint8_t* vm_base;
+int g_resv_store_active = 0;
+uint32_t g_ww_lo = 0, g_ww_hi = 0;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+
+static int fails = 0;
+#define CHECK(c, ...) do { const int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+
+int main(void)
+{
+    static uint8_t mem[1 << 16], before[1 << 16];
+    vm_base = mem;
+    const u32 h = 0x1000;
+    memcpy(before, mem, sizeof mem);
+    CHECK(cellKey2CharOpen(h) == CELL_OK, "Open");
+    int outside = 0;
+    for (u32 i = 0; i < sizeof mem; i++)
+        if (mem[i] != before[i] && (i < h || i >= h + SCE_KEY2CHAR_HANDLE_SIZE)) outside++;
+    CHECK(outside == 0, "Open writes only inside the 128-byte handle buffer");
+    CHECK(cellKey2CharOpen(h) == (s32)CELL_K2C_ERROR_ALREADY_INITIALIZED, "a second Open is ALREADY_INITIALIZED");
+    CHECK(cellKey2CharOpen(0) == (s32)CELL_K2C_ERROR_INVALID_HANDLE, "Open(NULL) is INVALID_HANDLE");
+    CHECK(cellKey2CharSetArrangement(h, 9) == CELL_OK && mem[h + 1] == 9, "SetArrangement keeps the arrangement");
+    CHECK(cellKey2CharSetArrangement(h, 25) == (s32)CELL_K2C_ERROR_INVALID_PARAMETER, "arrangement 25 is INVALID_PARAMETER");
+    CHECK(cellKey2CharSetArrangement(h, -1) == (s32)CELL_K2C_ERROR_INVALID_PARAMETER, "arrangement -1 is INVALID_PARAMETER");
+    CHECK(cellKey2CharSetMode(h, CELL_KEY2CHAR_MODE_NATIVE) == CELL_OK, "SetMode NATIVE");
+    CHECK(cellKey2CharSetMode(h, 3) == (s32)CELL_K2C_ERROR_INVALID_PARAMETER, "mode 3 is INVALID_PARAMETER");
+    /* kdata at 0x2000: led 0, mkey 0, keycode 0x04 ('a') */
+    vm_write16(0x2008, 0x04);
+    vm_write32(0x3000, 0xEEEEEEEE); mem[0x3010] = 0xEE;
+    CHECK(cellKey2CharGetChar(h, 0x2000, 0x3100, 0x3000, 0x3010) == CELL_OK && vm_read32(0x3000) == 0 &&
+          mem[0x3010] == 0, "GetChar converts nothing (no keyboard): charNum 0, processed false");
+    vm_write16(0x2008, 0);
+    CHECK(cellKey2CharGetChar(h, 0x2000, 0x3100, 0x3000, 0x3010) == (s32)CELL_K2C_ERROR_INVALID_PARAMETER,
+          "GetChar of key code 0 is INVALID_PARAMETER");
+    CHECK(cellKey2CharClose(h) == CELL_OK, "Close");
+    CHECK(cellKey2CharClose(h) == (s32)CELL_K2C_ERROR_UNINITIALIZED, "Close after Close is UNINITIALIZED");
+    CHECK(cellKey2CharSetMode(h, 0) == (s32)CELL_K2C_ERROR_UNINITIALIZED, "SetMode after Close is UNINITIALIZED");
+    CHECK(cellKey2CharSetArrangement(0, 0) == (s32)CELL_K2C_ERROR_INVALID_HANDLE, "SetArrangement(NULL) is INVALID_HANDLE");
+    printf("%s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
