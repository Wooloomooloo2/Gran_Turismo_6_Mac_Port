+/* A flip shows the display buffer, cellGcmSetDisplayBuffer's width x height
+ * at its address and pitch: a larger render target of the same pitch there
+ * (GT6 draws its 1280x720 buffers through a 1440x1080 clip) is presented as
+ * that top-left rectangle only, and a target the same size as a whole. */
+static void test_present_display_rectangle(void)
+{
+    printf("-- a flip presents the display buffer's rectangle of a larger target\n");
+    engine_up();
+    rsx_draw_backend be = g_stub_backend;
+    be.present_rect = stub_present_rect;
+    rsx_draw_engine_set_backend(&be);
+    memset(&g_present_rect, 0, sizeof g_present_rect);
+
+    m(M_COLOR_A_PITCH, 1024u);
+    draw_triangle();                               /* 256x256 at 0x40000, pitch 1024 */
+    const u32 big = stub.bound_rt[0];
+    rsx_draw_engine_set_display_buffer(0, RSX_LOCATION_LOCAL, 0x40000, 1024, 200, 150);
+    rsx_draw_engine_present_buffer(0);
+    CHECK(g_present_rect.n == 1 && g_present_rect.surface == big &&
+          g_present_rect.w == 200 && g_present_rect.h == 150,
+          "presented the 200x150 display rectangle of the 256x256 target (%d, %ux%u)",
+          g_present_rect.n, g_present_rect.w, g_present_rect.h);
+
+    rsx_draw_engine_set_display_buffer(1, RSX_LOCATION_LOCAL, 0x40000, 1024, 256, 256);
+    const int presents = stub.n_present;
+    rsx_draw_engine_present_buffer(1);
+    CHECK(g_present_rect.n == 1 && stub.n_present == presents + 1 && presented_surface == big,
+          "a display buffer the target's size presents it whole");
+    engine_down();
+}
